; Engine configuration file.
; Godot 4.7 — Pırıltı Diyarı (Kıvılcım Bekçileri)

config_version=5

[application]

config/name="Pırıltı Diyarı"
config/description="Kıvılcım Bekçileri serisinin ilk oyunu. Just A Game Studios."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon_512.png"

[autoload]

Tokens="*res://src/autoload/tokens.gd"
InputSetup="*res://src/autoload/input_setup.gd"
Content="*res://src/autoload/content.gd"
GameState="*res://src/autoload/game_state.gd"
Audio="*res://src/autoload/audio.gd"
SceneFlow="*res://src/autoload/scene_flow.gd"
DevTools="*res://src/autoload/dev_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[shader_globals]

pus_amount={
"type": "float",
"value": 0.0
}
cloud_shadow={
"type": "float",
"value": 0.0
}

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po")
