{
  "npc": "dikis",
  "variants": [
    {
      "when": {
        "quest": "firfir",
        "state": "done"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "mutlu",
          "text": "Turuncu Kor seninle. Orman yine çıtır çıtır yapraklı!"
        }
      ]
    },
    {
      "when": {
        "quest": "firfir",
        "state": "ready"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "mutlu",
          "text": "Fırfır sakinleşti mi? Kilit açıldı, yapraklar dans ediyor!"
        },
        {
          "speaker": "dikis",
          "mood": "sakin",
          "text": "Rüzgârgülü sorulmadan alınınca kalbi kırılmış."
        },
        {
          "speaker": "dikis",
          "mood": "mutlu",
          "text": "Paylaşmak güzel. Ama önce sormak gerek, değil mi?"
        },
        {
          "speaker": "dikis",
          "mood": "kararlı",
          "text": "Kor'u iyi sakla. Fokurdayan Göl seni bekliyor."
        }
      ],
      "then": {
        "complete_quest": "firfir",
        "set_flag": "s2_bolum1_bitti"
      }
    },
    {
      "when": {
        "quest": "firfir",
        "state": "active"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "dertli",
          "text": "Çan çalınca sis perdesi açılır. Fırfır ormanın en derininde."
        }
      ]
    },
    {
      "when": {
        "quest": "once_sor",
        "state": "ready"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "mutlu",
          "text": "Oyuncaklar sahiplerine döndü! Yavrular gülüyor."
        },
        {
          "speaker": "dikis",
          "mood": "dertli",
          "text": "Ama ormanın bekçisi Tilki Fırfır hâlâ kilitli bir öfkede."
        },
        {
          "speaker": "dikis",
          "mood": "kararlı",
          "text": "Ormanın çanını çal. Sis perdesi açılınca onu dinle."
        }
      ],
      "then": {
        "complete_quest": "once_sor",
        "start_quest": "firfir"
      }
    },
    {
      "when": {
        "quest": "once_sor",
        "state": "active"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "sakin",
          "text": "Rakunlar oyuncakları kapmış. Sakinleşince bırakırlar."
        }
      ]
    },
    {
      "when": {
        "quest": "once_sor",
        "state": "none"
      },
      "lines": [
        {
          "speaker": "dikis",
          "mood": "mutlu",
          "text": "Merhaba yine! Ormanda tezgâh açtım, sonbahar pelerini dikiyorum."
        },
        {
          "speaker": "dikis",
          "mood": "dertli",
          "text": "Kızıl Sis gelince herkes birbirinin eşyasını kapmaya başladı."
        },
        {
          "speaker": "dikis",
          "mood": "dertli",
          "text": "Yavruların oyuncaklarını Kapıcı Rakunlar aldı. Sormadan!"
        },
        {
          "speaker": "dikis",
          "mood": "kararlı",
          "text": "Rakunları sakinleştir, oyuncakları sahiplerine ver."
        }
      ],
      "then": {
        "start_quest": "once_sor",
        "give_items": {
          "nane_sekeri": 2
        }
      }
    },
    {
      "lines": [
        {
          "speaker": "dikis",
          "mood": "sakin",
          "text": "Yapraklar hep turuncu burada. Güzel, değil mi?"
        }
      ]
    }
  ]
