      "then": {
        "complete_quest": "davulun_izi",
        "start_quest": "tiril"
      }
    },
    {
      "lines": [
        {
          "speaker": "hiril",
          "mood": "sakin",
          "text": "Bum... bum... Yavaş çalıyorum ki korkmasın."
        }
      ]
