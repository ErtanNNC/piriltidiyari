      "lines": [
        {
          "speaker": "hiril",
          "mood": "mutlu",
          "text": "Geldin! Davulumu duydun, değil mi?"
        },
        {
          "speaker": "hiril",
          "mood": "sakin",
          "text": "Tırıl bu teknenin içinde. Günlerdir çalıyorum, çıkmadı."
        },
        {
          "speaker": "oyuncu",
          "mood": "kararlı",
          "text": "Yalnız değilsin artık. Birlikte bekleyelim."
        },
        {
          "speaker": "hiril",
          "mood": "kararlı",
          "text": "Önce adanın fişeğini yak. Sis incelsin."
        }
