          "text": "Başardın! Tırıl'ın ışığı artık titremiyor."
        },
        {
          "speaker": "tiril",
          "mood": "utangaç",
          "text": "Beni buldunuz... Dört kere. Hep buldunuz."
        },
        {
          "speaker": "hiril",
          "mood": "mutlu",
          "text": "Davulumu alıyorum. Hadi eve, Fener Gecesi'ne!"
        },
        {
          "speaker": "oyuncu",
          "mood": "mutlu",
          "text": "Beş inci tamam. Deniz Feneri yeniden yanacak!"
        }
      ],
      "then": {
