      },
      "lines": [
        {
          "speaker": "hiril",
          "mood": "mutlu",
          "text": "İnci Beyazı orada parlıyor. Al onu!"
        }
      ]
    },
    {
      "when": {
        "quest": "tiril",
        "state": "active"
      },
      "lines": [
        {
          "speaker": "hiril",
          "mood": "sakin",
          "text": "Fişeği yak. Işık gelince Tırıl dışarı bakar."
        },
        {
          "speaker": "hiril",
          "mood": "sakin",
          "text": "Ürkünce gölgeler çağırır. Kızma, sadece korkuyor."
        }
