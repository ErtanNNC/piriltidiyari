msgid " (%s tuşu / düğmesi)"
msgstr " (%s key / button)"

msgid " · buradasın"
msgstr " · you are here"

msgid " · dikenli"
msgstr " · thorny"

msgid " · sisli"
msgstr " · misty"

msgid " · tamam"
msgstr " · done"

msgid " · ŞİMDİ BURAYA!"
msgstr " · GO HERE NOW!"

msgid "\"Sus!\" Bulutu"
msgstr "\"Hush!\" Cloud"

msgid "%10 daha güçlü"
msgstr "10% stronger"

msgid "%d Pırıl"
msgstr "%d Glim"

msgid "%d Pırıl kazanırsın"
msgstr "You get %d Glim"

msgid "%d saniye diken barın dolmaz"
msgstr "Your Thorn Meter won't fill for %d seconds"

msgid "%d saniye gücün arttı!"
msgstr "More power for %d seconds!"

msgid "%d saniye moblar seni zor fark eder"
msgstr "For %d seconds, mobs barely notice you"

msgid "%d saniye nefesin daha hızlı"
msgstr "Your breath is faster for %d seconds"

msgid "%d saniye titreme barın dolmaz"
msgstr "Your Shiver Meter stays empty for %d seconds"

msgid "%d saniye tohumların hemen büyür"
msgstr "Your seeds grow right away for %d seconds"

msgid "%d saniye öfke barın dolmaz"
msgstr "Your anger bar won't fill for %d seconds"

msgid "%d saniye ışığın iki kat büyük"
msgstr "Your light is twice as big for %d seconds"

msgid "%s aldın"
msgstr "You got %s"

msgid "%s bulundu!"
msgstr "You found %s!"

msgid "%s elinde"
msgstr "%s in hand"

msgid "%s kaldırıldı"
msgstr "%s put away"

msgid "%s teslim edildi"
msgstr "%s handed over"

msgid "%s yoluna çıkalım mı?"
msgstr "Shall we set off for %s?"

msgid "%s · Seviye %d"
msgstr "%s · Level %d"

msgid "%s ×%d aldın"
msgstr "You got %s ×%d"

msgid "%s: kademe %d%s"
msgstr "%s: rank %d%s"

msgid "'Artık kimse bana bakmıyor' diyor. Oysa gözüm hep onda."
msgstr "\"Nobody looks at me anymore,\" he says. But I always watch him."

msgid "'Beni duyan var mı?' diyor gibi."
msgstr "Like it's asking, 'Can anyone hear me?'"

msgid "'Davul mu o, tencere mi?' dedik. Güldük. O da kızdı."
msgstr "We said 'Is that a drum or a pot?' We laughed. He got mad."

msgid "...Ne? Sen beni... duyuyor musun?"
msgstr "...What? You... can hear me?"

msgid "...neden ben değilim?"
msgstr "...why not me?"

msgid "...ve son! Bitti! İlk defa sonuna kadar söyledim!"
msgstr "...and the end! Done! I sang it to the end for the first time!"

msgid "1: Bal Şurubu iç, canın dolsun!"
msgstr "1: Drink Honey Syrup to fill your health!"

msgid "60 saniye Sakinleş daha hızlı"
msgstr "Breathe is faster for 60 seconds"

msgid "60 saniye diktiğin tohumlar hemen büyür"
msgstr "Seeds you plant grow right away for 60 seconds"

msgid "60 saniye gücün artar"
msgstr "More power for 60 seconds"

msgid "60 saniye ışık halkan iki katına çıkar"
msgstr "Your Light Ring doubles for 60 seconds"

msgid "90 saniye diken barın dolmaz"
msgstr "Your Thorn Meter won't fill for 90 seconds"

msgid "90 saniye moblar seni zor fark eder"
msgstr "For 90 seconds, mobs barely notice you"

msgid "90 saniye titreme barın dolmaz"
msgstr "Your Shiver Meter stays empty for 90 seconds"

msgid "90 saniye öfke barın dolmaz (Ses Çanı tozundan)"
msgstr "Your anger bar won't fill for 90 seconds (made from Echo Bell dust)"

msgid "ALTIN! Miyaaav! Deniz Feneri bile göz kırptı!"
msgstr "GOLD! Meeeow! Even the Lighthouse winked!"

msgid "Aa! Dikenler çekildi. Marullarım ne güzelmiş meğer!"
msgstr "Aha! The thorns are gone. My lettuces are lovely after all!"

msgid "Aa! Ormanın arkasında dikenli bir kapı açılıyor..."
msgstr "Oh! A thorny gate is opening behind the forest..."

msgid "Aa, Ponpon'un zili! Bir kere sallasam..."
msgstr "Oh, Ponpon's bell! Just one little ring..."

msgid "Aa, Tombiş'in bilyesi! Bir kerecik tutsam..."
msgstr "Oh, Tombiş's marble! Just one little hold..."

msgid "Aa, Vırak'ın fırıldağı! Bir kere üflesem..."
msgstr "Oh, Vırak's pinwheel! Just one little puff..."

msgid "Aa, kardeşlerim! Dördü de bana bakıyor."
msgstr "Oh, my little brothers and sisters! All four are looking at me."

msgid "Aa, lalelerim ne renkliymiş! Ölçmekten bakmayı unutmuşum."
msgstr "Oh, my tulips are so colorful! I was measuring and forgot to look."

msgid "Aaa... Yıldızlar neden sönüyor?"
msgstr "Ooh... Why are the stars going out?"

msgid "Abi, Pıtpıt neden küsmüş? Kardeşleri çok tatlı!"
msgstr "Big brother, why is Puddles sulking? The little ones are so cute!"

msgid "Abi, inerken beni sırtına alır mısın?"
msgstr "Big brother, will you carry me on your back when we go down?"

msgid "Abileri gösterirse çabucak kanatlanırlar."
msgstr "If you point to the big brothers, they sprout wings fast."

msgid "Abimin sırtı dünyanın en yumuşak yeri!"
msgstr "My brother's back is the softest place in the world!"

msgid "Acele yok. Burada kaybeden olmaz, sadece ıslanan olur."
msgstr "No rush. Nobody loses here, we just get wet."

msgid "Adacıklardaki sarmaşıkları alkışla"
msgstr "Clap for the vines on the little islands"

msgid "Adanın İşaret Fişeği'ni yak"
msgstr "Light the island's Signal Flare"

msgid "Adın"
msgstr "Your name"

msgid "Aferin torunuma! Dedenin Kabuk Kayık'ı sizi taşır."
msgstr "Well done, grandchild! Grandpa's Shell Boat will carry you."

msgid "Ah Hırıl! Kaleler dans etti, herkes gülüyor."
msgstr "Oh Grumble! The castles danced, everyone is laughing."

msgid "Ah... Pus kulağıma hep Pırpır'ın benden iyi olduğunu fısıldadı."
msgstr "Ah... The Gloom kept whispering that Flutter was better than me."

msgid "Ah... Çok uzun zamandır uyumamıştım."
msgstr "Ah... I haven't slept in such a long time."

msgid "Ahoy minik bekçi! Ben Kaptan Pırpır, göklerin en hızlısı!"
msgstr "Ahoy, tiny keeper! I'm Captain Flutter, fastest in the skies!"

msgid "Ahoy! Gemim limanda kaldı ama pazarcılık bende. Panayır benim!"
msgstr "Ahoy! My ship stayed in port, but I'm still a trader. This fair is mine!"

msgid "Ahoy! Gemim limanda kalsın. Pazarım yanımda, yola düşelim!"
msgstr "Ahoy! My ship can stay in port. My market comes along, let's go!"

msgid "Ahoy! Göklerin en nadir pazarına hoş geldin!"
msgstr "Ahoy! Welcome to the rarest market in the skies!"

msgid "Ahoy! Mısırlar patlıyor, panayır başlıyor!"
msgstr "Ahoy! The corn is popping, the fair is starting!"

msgid "Ahoy! Önce Liman Feneri'ni yak, yolumuz aydınlansın."
msgstr "Ahoy! Light the Harbor Lantern first, so our way is bright."

msgid "Ahtapot Mürekkep"
msgstr "Inky the Octopus"

msgid "Aile Işığı"
msgstr "Family Light"

msgid "Ailem bahçeye dağıldı: annem, babam, minik kardeşim."
msgstr "My family scattered around the garden: Mom, Dad, my little sibling."

msgid "Ailem beni aramış. Ama gök gürlerken hiç duymadım."
msgstr "My family was looking for me. But I never heard over the thunder."

msgid "Ailem dalgaların öbür yanında. Hangi yanında, bilmiyorum."
msgstr "My family is on the other side of the waves. Which side? I don't know."

msgid "Ailem geldi! Işık dansı: ateşböcekleri ve denizanaları!"
msgstr "My family came! A light dance: fireflies and jellyfish!"

msgid "Ailem her gece ışık yakmış. Göremedim ama yakmışlar."
msgstr "My family lit a light every night. I couldn't see it, but they did!"

msgid "Ailem orada toplandı. Seni bekliyoruz!"
msgstr "My family gathered there. We're waiting for you!"

msgid "Ailemle tanışır mısın? Bir de beş Anı Kabuğu var."
msgstr "Will you meet my family? There are also five Memory Shells."

msgid "Aklım hep Ponpon'un zilindeydi. Çın çın!"
msgstr "My mind was always on Ponpon's bell. Ding-dong!"

msgid "Aksesuar"
msgstr "Accessory"

msgid "Akşama konser var. En öne sana yer ayırdım!"
msgstr "There's a concert tonight. I saved you a spot right at the front!"

msgid "Al"
msgstr "Take"

msgid "Al Kor"
msgstr "Scarlet Ember"

msgid "Al Kor! Beş Kor tamam! Kızıl Sis dağılıyor!"
msgstr "The Scarlet Ember! All five Embers! The Crimson Mist is lifting!"

msgid "Al Kor'u al"
msgstr "Take the Scarlet Ember"

msgid "Al bakalım bekçi. Kendi dikenimden bir rozet."
msgstr "Here you go, keeper. A badge made from my own spike."

msgid "Al bakalım! Şimdi kanyon sadece şarkı yankılasın."
msgstr "Here you go! Now let the canyon echo only songs."

msgid "Al bakalım, bu da senin payın."
msgstr "Here you go, this is your share."

msgid "Al bakalım. Bir daha düşürme."
msgstr "Here you go. Don't drop it again."

msgid "Al onu, sonra yanıma gel."
msgstr "Take it, then come back to me."

msgid "Al yavrum, sıcacık kakao. Titrersen bir yudum iç."
msgstr "Here, dear, hot cocoa. If you shiver, take a sip."

msgid "Al, Kehribar Kor. Panayır ışıkları gibi parlıyor."
msgstr "Here, the Amber Ember. It glows like fair lights."

msgid "Al, Mercan Kor. Şarkımın en güzel notası bu."
msgstr "Here, the Coral Ember. The loveliest note of my song."

msgid "Al, Nane Limonata. İçin dikenle dolarsa bir yudum iç, ferahlarsın."
msgstr "Here, Mint Lemonade. If you fill up with thorns, take a sip and feel fresh."

msgid "Al, Turuncu Kor. Kalbimi ısıtan buydu."
msgstr "Here, the Orange Ember. It's what warmed my heart."

msgid "Al, bu Ateşböceği Kavanozu senin olsun."
msgstr "Here, this Firefly Jar is yours."

msgid "Al, dört davetiye. Çıtır yine tepeye çıkmış."
msgstr "Here, four invitations. Crunch is up on the hill again."

msgid "Al, köy arılarının balı. Bal Şurubu canını doldurur."
msgstr "Here, honey from the village bees. Honey Syrup fills your health."

msgid "Al, yeni tarifim: Nane Şekeri. Seni serinletir."
msgstr "Here's my new recipe: Mint Drops. They cool you down."

msgid "Alay Yankıları"
msgstr "Teasing Echoes"

msgid "Alay etmek komik gelir ama birinin içini kırar."
msgstr "Teasing feels funny, but it hurts someone inside."

msgid "Albatros Yavrusu Pamuk"
msgstr "Cotton the Albatross Chick"

msgid "Alet"
msgstr "Tool"

msgid "Aletler"
msgstr "Tools"

msgid "Alkış"
msgstr "Clap"

msgid "Alkış Fındığı"
msgstr "Cheer Nut"

msgid "Alkış en sevdiğim ses! Dikenler bile yol verdi."
msgstr "Clapping is my favorite sound! Even the thorns made way."

msgid "Alkış mı? Neyi alkışlıyorsun? Ben hiç açmadım ki."
msgstr "Clap? What are you clapping for? I haven't bloomed at all."

msgid "Alkış'a bas: seraların ve Dikencilerin yanında!"
msgstr "Press Clap near the greenhouses and the Prickles!"

msgid "Alkışla, tohum ek, kuzeye yürü!"
msgstr "Clap, plant a seed, walk north!"

msgid "Alkışladım, sarmaşık çekildi! Yerinde çiçek kaldı."
msgstr "I clapped and the vine pulled back! A flower is left in its place."

msgid "Alkışladın, dikenler çekildi! Havuçlarım yerinde duruyormuş."
msgstr "You clapped and the thorns pulled back! My carrots were right there all along."

msgid "Alkışlayınca dikenler çekildi! Perde de açıldı."
msgstr "When you clapped, the thorns pulled back! The curtain opened too."

msgid "Alkışlayınca dikenler çekildi! Yol açıldı."
msgstr "When you clap, the thorns pull back! The way is open."

msgid "Alkışlayınca dikenleri döküldü! Evine koşuyor."
msgstr "When you clapped, its thorns dropped off! It's running home."

msgid "Alkışlayınca sahnenin dikenleri çekildi. Yol açık!"
msgstr "When you clapped, the stage thorns pulled back. The way is open!"

msgid "Alkışlayınca yuvanın dikenleri çekildi! Kuşlar cıvıldıyor."
msgstr "When you clapped, the nest thorns pulled back! The birds are chirping."

msgid "Alkışlayınca yuvarladım: bilyem herkesten uzağa gidiyor!"
msgstr "I clapped and rolled: my marble goes farther than anyone's!"

msgid "Alkışlayınca üfledim: fırıldağım rüzgârla dans ediyor!"
msgstr "I clapped and blew: my pinwheel dances with the wind!"

msgid "Alkışın için sağ ol evlat. İçim ferahladı."
msgstr "Thank you for your clap, dear. I feel so much lighter."

msgid "Alkışın için sağ ol. Turp'a da el sallayacağım."
msgstr "Thanks for the applause. I'll wave at Radish too."

msgid "Alkışın kulaklarımı dikti! Dikenler de çekildi."
msgstr "Your clap perked up my ears! The thorns pulled back, too."

msgid "Almaya gelmedik. Ama bu kabuk sana dar gelmiş, sıkışmışsın."
msgstr "We didn't come to take it. But this shell is too small for you. You're stuck."

msgid "Altı Renkli Fener"
msgstr "The Six-Color Lantern"

msgid "Altı ışık mantarını yak"
msgstr "Light the six glow mushrooms"

msgid "Altın Külah"
msgstr "Golden Cone"

msgid "Altın Külah! Kıskaçlarım rahat rahat dönüyor. Tak tak!"
msgstr "Golden Cone! My claws turn so easily. Tak tak!"

msgid "Altın Zil"
msgstr "Golden Bell"

msgid "Altın için dönüşleri kıs. Ya da yelkeni dene!"
msgstr "For gold, take the turns tight. Or try the sail!"

msgid "Altın madalya!"
msgstr "Gold medal!"

msgid "Alçaldı! Şimdi vur!"
msgstr "It's low! Hit now!"

msgid "Alındı"
msgstr "Bought"

msgid "Alırım tabii. Sırtımda yerin hep hazır."
msgstr "Of course I will. My back is always ready for you."

msgid "Ama Fener'in beş incisi denize düştü. Beş adaya dağıldı."
msgstr "But the Lighthouse's five pearls fell into the sea. They scattered to five islands."

msgid "Ama Fısıltı Ormanı'nın feneri söndü."
msgstr "But the Whispering Woods' lantern went out."

msgid "Ama Kaynar Kurbağa Fokur hâlâ kaynıyor. Şarkısı hep kesildi."
msgstr "But Burble the Boiling Frog is still boiling. His song was always cut short."

msgid "Ama Minnoş'un ağzını minicik çizmiş."
msgstr "But Cubby drew his own mouth teeny-tiny."

msgid "Ama Mürekkep amca hâlâ saklanıyor. Karanlıktan çok korkuyor."
msgstr "But Uncle Inky is still hiding. He is very scared of the dark."

msgid "Ama Pus bütün iplerimi griye boyadı. Önce renkler dönsün."
msgstr "But the Gloom turned all my thread grey. The colors must come back first."

msgid "Ama Pus'a bulanmış gri ağaçlar hep tersini söyler!"
msgstr "But grey trees covered in Gloom always say the opposite!"

msgid "Ama Tavuk Patpat hiç kazanamadı. Kızdı, panayırı kapattı."
msgstr "But Popper the Hen never won once. She got cross and closed the fair."

msgid "Ama abi! Ben en çok senin sırtında uyurum."
msgstr "But big brother! I sleep best on your back."

msgid "Ama arkasında bir fısıltı kaldı..."
msgstr "But a whisper stayed behind..."

msgid "Ama arkımız tıkalı, papatyalar susuz. Bir de Cırcır var..."
msgstr "But our ditch is blocked and the daisies are thirsty. And there's Chirpy..."

msgid "Ama arkımız tıkalı. Su gelmezse tohumlar uyanmaz."
msgstr "But our water channel is blocked. No water, no waking seeds."

msgid "Ama arkımız tıkalı. Çiçeklerim susadı."
msgstr "But our ditch is blocked. My flowers are thirsty."

msgid "Ama ben en çok senin sırtında uyurum abi!"
msgstr "But I sleep best on your back, big brother!"

msgid "Ama ben..."
msgstr "But I..."

msgid "Ama bir dert var: üç çocuk fenerini kaybetmiş."
msgstr "But there's a problem: three kids lost their lanterns."

msgid "Ama bir köşe hâlâ boş... Uzaktaki dağın ardı."
msgstr "But one corner is still empty... Past the far mountain."

msgid "Ama bostanı sen bekliyorsun! Sen olmasan lahana kalmazdı."
msgstr "But you guard the garden! Without you, there'd be no cabbages left."

msgid "Ama bu sarmaşıklar köyde bitmedi. Kökleri ormana uzanıyor."
msgstr "But these vines didn't start in the village. Their roots reach into the forest."

msgid "Ama dağın üstünde bir ışık izi var. Mırıl yol göstermiş."
msgstr "But there's a trail of light over the mountain. Mumble showed the way."

msgid "Ama dört Kıvılcım avucumda parlıyor. Hadi!"
msgstr "But four Sparks shine in my hands. Let's go!"

msgid "Ama fırtına dinmiyor. Tepedeki yuvadan esiyor."
msgstr "But the storm won't stop. It blows from the nest at the top."

msgid "Ama her gece gökteki yıldızlara baktı ve özledi."
msgstr "But every night it looked at the stars in the sky and missed them."

msgid "Ama her yere dağılırsa... Pus hepsini yakalayamaz!"
msgstr "But if it spreads everywhere... the Gloom can't catch it all!"

msgid "Ama hiçbiriyle oynamıyor. Yorulunca yanına git, alkışla."
msgstr "But he won't play with any of them. When he's tired, go to him and clap."

msgid "Ama kimse hâlâ kapısını açmıyor. Bir hortlak varmış!"
msgstr "But still nobody opens their door. They say there's a ghost!"

msgid "Ama kimse ona söz vermemiş."
msgstr "But nobody gave him a turn to talk."

msgid "Ama kuzeyden tak tak sesler geliyor. Keşiş Yengeç Bikbik."
msgstr "But I hear tak tak from the north. Shelby the Hermit Crab."

msgid "Ama ormanın bekçisi Tilki Fırfır hâlâ kilitli bir öfkede."
msgstr "But the forest's guardian, Whirly the Fox, is still locked in anger."

msgid "Ama rüzgâr kalemimi bile uçurdu! Tepeden fırtına esiyor."
msgstr "But the wind blew away even my pencil! A storm blows from the top."

msgid "Ama sen dondurmasın! Herkes dondurma sever!"
msgstr "But you're ice cream! Everybody loves ice cream!"

msgid "Ama tepeye giden yolu diken çiti kapatıyor."
msgstr "But a thorn fence blocks the way up the hill."

msgid "Ama yolluk hazır. Bak istersen."
msgstr "But the snacks are ready. Take a look if you like."

msgid "Ama önce biraz dinlen. Bal Şurubu ister misin?"
msgstr "But rest a little first. Would you like some Honey Syrup?"

msgid "Ama şimşek hep sırayla düşüyor. Say: güm, sus, sus, sus."
msgstr "But the lightning always strikes in order. Count: boom, hush, hush, hush."

msgid "Ama... Minnoş'u gördün mü? Kızıl Sis'in içine koştu."
msgstr "But... did you see Cubby? He ran into the Crimson Mist."

msgid "Aman yavrum! Bu adada kum tepeleri her gece yer değiştirir."
msgstr "Oh dear! On this island the sand dunes move every night."

msgid "Aman, bir bekçi! Ben Madenci Kazma."
msgstr "Oh my, a keeper! I'm Digby the Mole."

msgid "Aman, yine sen! Mağarada kazma, burada örs. Örsüm ısındı!"
msgstr "Oh, it's you again! A pickaxe in the cave, an anvil here. It's warm now!"

msgid "Ana menü"
msgstr "Main menu"

msgid "Anlat bakalım, dinliyorum."
msgstr "Go on, tell me. I'm listening."

msgid "Anlat, dinliyorum."
msgstr "Tell me, I'm listening."

msgid "Anne Serçe"
msgstr "Mama Sparrow"

msgid "Anne Serçe ile konuş"
msgstr "Talk to Mama Sparrow"

msgid "Anne Serçe'ye dön"
msgstr "Go back to Mama Sparrow"

msgid "Annem 'Uzaklaşma' demişti. Bir dalga beni aldı götürdü."
msgstr "Mom said, 'Don't wander off.' Then a wave carried me away."

msgid "Annem bütün gün onları besliyor. Beni unuttu sandım."
msgstr "She feeds them all day long. I thought she forgot me."

msgid "Annemin tarifi: Cesaret Kurabiyesi. Bir bak istersen."
msgstr "My mom's recipe: Brave Cookie. Take a look if you like."

msgid "Anı"
msgstr "Memory"

msgid "Ardında kırmızı bir yankı kaldı..."
msgstr "It left a red echo behind..."

msgid "Ark kapağı hemen şurada, doğuda. Çarkını çevir!"
msgstr "The sluice gate is right over there, to the east. Turn its wheel!"

msgid "Ark kapağı hemen şurada. Çarkı çevir, son çit kurusun!"
msgstr "The sluice gate is right here. Turn the wheel, and the last fence will dry up!"

msgid "Ark kapağı kuzeyde, köprünün ötesinde. Çarkı çevir!"
msgstr "The sluice gate is up north, past the bridge. Turn the wheel!"

msgid "Ark kapağı taraçada, merdivenin üstünde. Çarkı çevir!"
msgstr "The sluice gate is on the terrace, at the top of the stairs. Turn the wheel!"

msgid "Ark kapağı yukarı çayırda, yokuşun ötesinde. Çarkı çevir!"
msgstr "The sluice gate is in the upper meadow, past the slope. Turn the wheel!"

msgid "Ark kapağı üst dalda, batı yanında. Çarkını çevir!"
msgstr "The sluice gate is on the top branch, on the west side. Turn its wheel!"

msgid "Ark kapağını aç"
msgstr "Open the sluice gate"

msgid "Ark kapağının yanında konuş"
msgstr "Talk next to the sluice gate"

msgid "Ark kapağının yanında seni bekleyenle konuş"
msgstr "Talk to the one waiting by the sluice gate"

msgid "Ark kapağının çarkını çevir: son çit kurusun"
msgstr "Turn the wheel of the sluice gate: the last fence will dry up"

msgid "Arkadaş... Ne güzel bir kelime."
msgstr "Friend... What a lovely word."

msgid "Arkadaşınla konuş"
msgstr "Talk to your friend"

msgid "Arkasında kırmızı bir bulut var."
msgstr "There's a red cloud behind him."

msgid "Arkı aç, sazlığa git. Ona kendi güzelliğini gösterelim!"
msgstr "Open the sluice, go to the reeds. Let's show her her own beauty!"

msgid "Artık %s ile oynuyorsun!"
msgstr "Now you're playing as %s!"

msgid "Artık biliyorum: Minnoş sadece dinlenmek istemiş."
msgstr "Now I know: Cubby just wanted to be heard."

msgid "Artık saklambacı sadece oyun olsun diye oynuyoruz!"
msgstr "Now we play hide and seek just for fun!"

msgid "Artık titremiyorum. Işığım sizinle!"
msgstr "I'm not trembling anymore. My light is with you!"

msgid "Asıl çare alkış! Komşunun bahçesi için sevin, dikenler çekilir."
msgstr "Clapping is the real cure! Be happy for your neighbor's garden, and the thorns pull back."

msgid "At"
msgstr "Throw"

msgid "At\n%d"
msgstr "Throw\n%d"

msgid "Ateş yandı! Uykulu sis eriyip gitti."
msgstr "The fire is lit! The sleepy mist melted away."

msgid "Ateş! Minik Kol! Geldim! El ele hiç titremedim."
msgstr "A fire! Little Arm! I made it! Hand in hand, I never trembled."

msgid "Ateşböceği"
msgstr "Firefly"

msgid "Ateşböceği Kavanozu"
msgstr "Firefly Jar"

msgid "Ateşböceği ailen ve Tırıl'ın ailesi birlikte bir ışık dansı yaptı."
msgstr "Your firefly family and Tremble's family did a light dance together."

msgid "Ateşin başındayım. Üşürsen gel, ısın."
msgstr "I'm by the fire. If you're cold, come warm up."

msgid "Ateşin yanında Tospik Nine'ye dön"
msgstr "Go back to Granny Shelly by the fire"

msgid "Ateşin yanındaki Minik Kol ile konuş"
msgstr "Talk to Little Arm by the fire"

msgid "Atkı"
msgstr "Scarf"

msgid "Ay Çiçeği Tohumu"
msgstr "Moonflower Seed"

msgid "Ay Çiçeği Tohumu hemen şurada parlıyor. Al, gidelim!"
msgstr "The Moonflower Seed is shining right over there. Take it, let's go!"

msgid "Ay Çiçeği Tohumu! Beşinci tohum da tamam."
msgstr "The Moonflower Seed! The fifth seed is done."

msgid "Ay Çiçeği Tohumu'nu al"
msgstr "Take the Moonflower Seed"

msgid "Ay Çiçeği açtı! Tırıl seni bekliyor, hadi yanına."
msgstr "The Moonflower bloomed! Tremble is waiting for you, go to her."

msgid "Ay Çiçeği! Meydanın ortasında ay gibi parlıyor."
msgstr "The Moonflower! It shines like the moon in the middle of the square."

msgid "Ayağımla tempo tutardım. Cırcır başlayınca şaşırdım."
msgstr "I used to tap the beat with my foot. Then Chirpy started and I got mixed up."

msgid "Aydınlat"
msgstr "Light up"

msgid "Aydınlatma"
msgstr "Light up"

msgid "Ayna Balığı"
msgstr "Mirror Fish"

msgid "Ayna Gölü"
msgstr "Mirror Lake"

msgid "Ayna taşına bak, gördüğünün yolundan git"
msgstr "Look at the mirror stone, follow the path of what you see"

msgid "Ayna taşına bak. Suda kimi görürsen onun yolundan git."
msgstr "Look at the mirror stone. Follow the path of whoever you see in the water."

msgid "Ayna taşına bak: suda kimi görürsen onun yaprak yolundan git"
msgstr "Look at the mirror stone: follow the leaf path of whoever you see in the water"

msgid "Ayna taşına bak: suda kimi görürsen onun yolu sağlam!"
msgstr "Look at the mirror stone: the path of whoever you see in the water is safe!"

msgid "Ayna taşına bakmalıyım. O bana doğru yolu söyler."
msgstr "I should look at the mirror stone. It will tell me the right way."

msgid "Ayı Kucağı"
msgstr "Bear Hug"

msgid "Ayı yavrusu"
msgstr "Bear cub"

msgid "Aç"
msgstr "Open"

msgid "Açtı! İlk çiçeğim bir Şifa Papatyası oldu."
msgstr "It bloomed! My first flower is a Healing Daisy."

msgid "Açık"
msgstr "On"

msgid "Ağabey... Beni dinlediğin için teşekkürler."
msgstr "Big brother... Thanks for listening to me."

msgid "Ağabeyime söyle, onu özledim. Ben köye dönüyorum!"
msgstr "Tell my big brother I missed him. I'm going back to the village!"

msgid "Ağaç kabuğuna yazılmış: 'BEN DE!'"
msgstr "Written on the tree bark: 'ME TOO!'"

msgid "Ağaçlar bana hep yanlış yolu söyledi!"
msgstr "The trees kept telling me the wrong way!"

msgid "Aşağıya, Anne Serçe'ye dön"
msgstr "Go down, back to Mama Sparrow"

msgid "BUM! Kim o? Yine mi davuluma gülmeye geldin?"
msgstr "BOOM! Who's there? Here to laugh at my drum again?"

msgid "Babam bana baloncuk üflemeyi öğretti. İlki burnumda patladı!"
msgstr "Dad taught me to blow bubbles. The first one popped on my nose!"

msgid "Baban seni arıyor! Köy şu tarafta."
msgstr "Your dad is looking for you! The village is this way."

msgid "Babası karşı kayada. Mercan Kemer'in üstünden geç!"
msgstr "His dad is on the rock across the way. Cross over the Coral Arch!"

msgid "Bado ile konuş"
msgstr "Talk to Bado"

msgid "Bado'ya davetiyesini ver"
msgstr "Give Bado an invitation"

msgid "Bado, akşam doğum günüm var. Gelir misin?"
msgstr "Bado, my birthday party is tonight. Will you come?"

msgid "Bado, sırrım şu: sudan çok ürküyorum."
msgstr "Bado, here's my secret: I get really spooked by water."

msgid "Bahar Kapısı"
msgstr "Spring Gate"

msgid "Bahar Kapısı nereye açılsın?"
msgstr "Where should the Spring Gate open to?"

msgid "Bahar Kapısı çiçek açtı: %s yolu açıldı!"
msgstr "The Spring Gate bloomed: the way to %s is open!"

msgid "Bahar Kapısı'na git: %s"
msgstr "Go to the Spring Gate: %s"

msgid "Bahar Tohumu"
msgstr "Spring Seed"

msgid "Bahçe"
msgstr "Garden"

msgid "Bahçe ikimizin, Bado! Yarısı senin."
msgstr "The garden is ours, Bado! Half is yours."

msgid "Bahçe Çemberi"
msgstr "Garden Ring"

msgid "Bahçeler yine çiçek dolu! Alkışın herkese iyi geldi yavrum."
msgstr "The gardens are full of flowers again! Your clap helped everyone, dear."

msgid "Bahçelerdeki üç komşunla konuş. Zıplayınca Boşluk'u bırakma: süzülürsün!"
msgstr "Talk to the three neighbors in the gardens. Hold Space when you jump: you'll glide!"

msgid "Bahçelere gir"
msgstr "Enter the gardens"

msgid "Bahçelerin dibinden ince yeşil sarmaşıklar çıkmış!"
msgstr "Thin green vines have sprung up at the edge of the gardens!"

msgid "Bahçelerin önünde de alkışla. Dikenler utanıp çekilir."
msgstr "Clap in front of the gardens, too. The thorns will feel shy and pull back."

msgid "Bahçemiz artık senin de bahçen. Ne zaman istersen gel."
msgstr "Our garden is your garden now. Come whenever you like."

msgid "Bahçemize hoş geldin! Kapımız sana hep açık."
msgstr "Welcome to our garden! Our door is always open to you."

msgid "Bahçenin ortasındaki Işık Kabuğu'na git"
msgstr "Go to the Light Shell in the middle of the garden"

msgid "Bahçenin önünde bir alkış patlatayım, belki iyi gelir."
msgstr "Let me clap in front of the garden. Maybe it will help."

msgid "Bak"
msgstr "Look"

msgid "Bak ne buldum! Bu altın zil senin, değil mi?"
msgstr "Look what I found! This golden bell is yours, isn't it?"

msgid "Bak ne buldum! Bu cam bilye senin, değil mi?"
msgstr "Look what I found! This glass marble is yours, isn't it?"

msgid "Bak ne buldum! Bu gümüş fırıldak senin, değil mi?"
msgstr "Look what I found! This silver pinwheel is yours, isn't it?"

msgid "Bak ne buldum! Senin bez bebeğin bu, değil mi?"
msgstr "Look what I found! This is your rag doll, isn't it?"

msgid "Bak ne buldum! Senin topun bu, değil mi?"
msgstr "Look what I found! This is your ball, isn't it?"

msgid "Bak ne buldum! Senin uçurtman bu, değil mi?"
msgstr "Look what I found! This is your kite, isn't it?"

msgid "Bak şunlara! Pıtpıt kardeşlerine kanat çırpmayı gösteriyor."
msgstr "Look at them! Puddles is showing her little ones how to flap their wings."

msgid "Bak! Dalgaların üstünde bir ışık titriyor..."
msgstr "Look! A light is trembling on the waves..."

msgid "Bak! Yoldaki Gece Çiçeği de açtı. Saati gelmiş!"
msgstr "Look! The Night Flower on the road bloomed too. Its time has come!"

msgid "Bak, deniz de seni dinliyor. Ne kadar sakin..."
msgstr "Look, the sea is listening to you too. So calm..."

msgid "Bak, duvarlarda yazılar var. Hırıl'ın söyleyemedikleri."
msgstr "Look, there's writing on the walls. What Grumble never got to say."

msgid "Bak, ışığım hiç titremiyor."
msgstr "Look, my light isn't wobbling at all."

msgid "Bak, şuradan başlıyor! Oh, ne güzel anlattım."
msgstr "Look, it starts right here! Oh, that felt good to say."

msgid "Bakın! Kıvılcım birini arıyor..."
msgstr "Look! The spark is looking for someone..."

msgid "Bakın, denizin üstü... Bir şey parlıyor."
msgstr "Look, over the sea... Something is glowing."

msgid "Bakır Kor"
msgstr "Copper Ember"

msgid "Bakır Kor! Dördüncü Kor da bizde!"
msgstr "The Copper Ember! That's our fourth Ember!"

msgid "Bakır Kor'u al"
msgstr "Take the Copper Ember"

msgid "Bal Paylaşımı"
msgstr "Honey Share"

msgid "Bal Şurubu"
msgstr "Honey Syrup"

msgid "Bal! En sevdiğim."
msgstr "Honey! My favorite."

msgid "Balon Adası"
msgstr "Balloon Isle"

msgid "Balon Adası'nın tepesinden de Rüzgâr'ın yuvası görünür."
msgstr "You can see Gale's nest from the top of Balloon Isle, too."

msgid "Balon Adası'nın tepesine çık"
msgstr "Climb to the top of Balloon Isle"

msgid "Balon Patlat"
msgstr "Balloon Pop"

msgid "Balon Patlat oyununu kazan"
msgstr "Win the Balloon Pop game"

msgid "Balon Patlat ve Bayrak Koşusu. İkisini de dener misin?"
msgstr "Balloon Pop and the Flag Race. Will you try both?"

msgid "Balon: %d kaldı · %d sn"
msgstr "Balloons: %d left · %d s"

msgid "Baloncuk"
msgstr "Bubble"

msgid "Baloncuk Patlaması"
msgstr "Bubble Burst"

msgid "Baloncuk sütunları seni yukarı taşır. Burada her şey yavaş!"
msgstr "Bubble columns lift you up. Everything is slow here!"

msgid "Baloncuk sütunları seni yukarı taşır. İçine gir, yeter!"
msgstr "Bubble columns lift you up. Just step inside!"

msgid "Baloncuklar beni yukarı taşıdı! Bir daha, bir daha!"
msgstr "The bubbles carried me up! Again, again!"

msgid "Baloncuklara bin! Hop diye yukarı çıkarsın. Çok gıdıklar!"
msgstr "Hop on the bubbles! Whoosh, up you go. So ticklish!"

msgid "Baloncuklardan kaç. Kıskacı saplanınca vur!"
msgstr "Dodge the bubbles. Hit Pinch when his claw gets stuck!"

msgid "Balonlar çok eğlenceli ama annemi özledim."
msgstr "The balloons are lots of fun, but I miss my mom."

msgid "Balık"
msgstr "Fish"

msgid "Balıkçı Olta"
msgstr "Fishhook the Fisher"

msgid "Balıkçıl Yavruları"
msgstr "the Heron Chicks"

msgid "Balığın yolu sağlam. Son çatal bu!"
msgstr "The fish's path is safe. This is the last fork!"

msgid "Bana da mı çiçek? Hih hih, şapkama takacağım!"
msgstr "Flowers for me too? Hee hee, I'll wear it on my hat!"

msgid "Bana da sıra gelsin. Hep en sona kaldım."
msgstr "Let me have a turn too. I was always last."

msgid "Bana mı? Gerçekten mi? Şey... Merhaba!"
msgstr "Me? Really? Um... Hello!"

msgid "Basamaklardan zıplayarak Üst Kaya'ya çık"
msgstr "Hop up the steps to Upper Rock"

msgid "Basamaklardan çık, süzül!"
msgstr "Climb the steps, then float!"

msgid "Basamaklardan çık, uçurumdan süzül!"
msgstr "Climb the steps, float over the chasm!"

msgid "Basamaklardan çık. Derede Ek'e bas!"
msgstr "Climb the steps. Press Plant at the stream!"

msgid "Baykuş Öğretmen Hu"
msgstr "Teacher Hoo"

msgid "Baykuş Öğretmen Hu ile konuş"
msgstr "Talk to Teacher Hoo"

msgid "Bayrak %d/%d · %d sn"
msgstr "Flag %d/%d · %d s"

msgid "Bayrak Koşusu"
msgstr "Flag Race"

msgid "Bayrak Koşusu'nu kazan"
msgstr "Win the Flag Race"

msgid "Bayraklar, tezgâhlar... ama oyuncak sesi yok."
msgstr "Flags, stalls... but no sound of toys."

msgid "Bazen ben de kızıyorum, biliyor musun?"
msgstr "Sometimes I get angry too, you know?"

msgid "Bağıran Bekçi"
msgstr "The Shouting Guard"

msgid "Bağıran Kurbağa"
msgstr "Shouty Frog"

msgid "Bağırdıkça fırtına büyüyor. Vuruşları say, arada koş!"
msgstr "The more he shouts, the bigger the storm. Count the beats and run in between!"

msgid "Başardın! Hadi, yanıma gel!"
msgstr "You did it! Come on, come to me!"

msgid "Başardın! Tırıl'ın ışığı artık titremiyor."
msgstr "You did it! Tremble's light isn't shivering anymore."

msgid "Başka bir çan çalınca buradan oraya gidebilirsin."
msgstr "Ring another bell and you can travel there from here."

msgid "Başka yerler"
msgstr "Other places"

msgid "Başka yerler…"
msgstr "Other places…"

msgid "Başka zaman mı? Öyle bir zaman var mı?"
msgstr "Another time? Is there such a time?"

msgid "Başkasının yeteneği seninkini azaltmaz. İkisi birlikte daha güzel!"
msgstr "Someone else's talent doesn't make yours smaller. Together they're prettier!"

msgid "Başla"
msgstr "Start"

msgid "Başla!"
msgstr "Go!"

msgid "Başı Dönen Martı"
msgstr "Dizzy Gull"

msgid "Başı döndü! Şimdi vur!"
msgstr "He's dizzy! Hit now!"

msgid "Başı dönen civcivi el ele köprüden geçir"
msgstr "Hold hands and help the dizzy chick across the bridge"

msgid "Bebeğime sarıldım. Bir daha kimse sormadan almasın."
msgstr "I'm hugging my doll. Nobody take it again without asking."

msgid "Beklemek zormuş ama güzelmiş. Hepinizi seviyorum!"
msgstr "Waiting was hard, but it was nice. I love you all!"

msgid "Bekçi"
msgstr "Keeper"

msgid "Bekçi Evi"
msgstr "Keeper House"

msgid "Bekçi Evi'ndeki dolaptan istediğin zaman değiştirebilirsin."
msgstr "You can change outfits anytime at the closet in the Keeper House."

msgid "Bekçi Fok Tombik her gürültüde bağırıyor. Fırtına büyüyor."
msgstr "Chubby the Seal Guard shouts at every noise. The storm is growing."

msgid "Bekçi:"
msgstr "Keeper:"

msgid "Bekçimiz Mürekkep amca her yeri mürekkeple kapladı."
msgstr "Our guard, Uncle Inky, covered everything with ink."

msgid "Bekçini değiştir"
msgstr "Change your keeper"

msgid "Bekçini seç"
msgstr "Pick your keeper"

msgid "Bekçinin İlk Adımı"
msgstr "The Keeper's First Step"

msgid "Belki beni arıyorlardır. Belki de sadece geçiyorlardır."
msgstr "Maybe they're looking for me. Maybe they're just passing by."

msgid "Belki o ışık kendisininkini de geri getirirdi..."
msgstr "Maybe that light could bring its own light back too..."

msgid "Belki ona başka bir ışık lazım. Başka bir saat."
msgstr "Maybe she needs a different light. A different hour."

msgid "Ben Keçi Yavrusu Çıngır. Kanyon hiç susmuyor!"
msgstr "I'm Jingle the kid goat. The canyon never goes quiet!"

msgid "Ben Kıvılcım'ı Pus'tan saklıyordum. Seni de Pus sandım."
msgstr "I was hiding the Spark from the Gloom. I thought you were the Gloom."

msgid "Ben Tıpış. Kor Vadisi'ni bilirim, yolu bilirim."
msgstr "I'm Pitter. I know Ember Valley, I know the way."

msgid "Ben Vırak'ın fırıldağını isterdim. Fır fır dönüyor!"
msgstr "I would have liked Vırak's pinwheel. It spins round and round!"

msgid "Ben artık küçük değilim!"
msgstr "I'm not little anymore!"

msgid "Ben ateşi beklerim. Sen çağırırsan gelirim!"
msgstr "I'll watch the fire. If you call, I'll come!"

msgid "Ben bahçelerden anlarım. Gelebilir miyim?"
msgstr "I know about gardens. Can I come along?"

msgid "Ben de bakarım. Acelemiz yok."
msgstr "I'll look too. We're in no hurry."

msgid "Ben de bir gün daha büyük bir kabuk seçeceğim."
msgstr "One day I'll pick a bigger shell too."

msgid "Ben de bir zamanlar kimsenin görmediği bir yıldızdım."
msgstr "I was once a star nobody could see, too."

msgid "Ben de bir çiçekmişim. Sadece benim saatim gece."
msgstr "I'm a flower too! It's just that my hour is night."

msgid "Ben de bugün sustum ve rüzgârı dinledim."
msgstr "So today I was quiet and listened to the wind."

msgid "Ben de davul çalmak isterdim ama... Gürültü olur mu?"
msgstr "I'd love to play the drum too, but... would it be too noisy?"

msgid "Ben de geliyorum. Korksam bile."
msgstr "I'm coming too. Even if I'm scared."

msgid "Ben de gidiyorum! Kızıl Sis'e! Hırrr!"
msgstr "I'm going too! Into the Crimson Mist! Grrr!"

msgid "Ben de kabuğumdan çıkmaya korkardım. Ama bak, buradayım."
msgstr "I used to be scared to leave my shell too. But look, I'm here."

msgid "Ben de kapıda nöbet tutarım. Artık dostuz!"
msgstr "I'll guard the door too. We're friends now!"

msgid "Ben de kızıyorum... Derin bir nefes alayım."
msgstr "I'm getting cross too... Let me take a deep breath."

msgid "Ben de mi konuşabilirim? En küçük benim ama..."
msgstr "Can I talk too? I'm the smallest, but..."

msgid "Ben de oynamak istiyorum. Ama kimse çağırmadı."
msgstr "I want to play too. But nobody called me."

msgid "Ben de toprağı. Dördümüz ilk kez yan yanayız!"
msgstr "And I love the soil. The four of us are side by side for the first time!"

msgid "Ben de önce parlayamıyordum. Işığım tir tir titrerdi."
msgstr "I couldn't shine at first, either. My light used to tremble."

msgid "Ben de öyle hissederdim."
msgstr "I'd have felt that way too."

msgid "Ben de! Dağ yolunu kazmamla açarım, örsümü de getirdim."
msgstr "Me too! I'll dig the mountain path open, and I brought my anvil."

msgid "Ben dinliyorum! Neredesin?"
msgstr "I'm listening! Where are you?"

msgid "Ben dinliyorum. Yanına geliyorum."
msgstr "I'm listening. I'm coming over."

msgid "Ben gökyüzünü aydınlatırım!"
msgstr "I light up the sky!"

msgid "Ben gökyüzünü aydınlatırım, Tırıl denizi!"
msgstr "I'll light up the sky, Tremble lights the sea!"

msgid "Ben hazırım!"
msgstr "I'm ready!"

msgid "Ben hazırım! Hem de çok hazırım!"
msgstr "I'm ready! Super, super ready!"

msgid "Ben hep burada dikiliyorum. Onlar gökte süzülüyor."
msgstr "I just stand here all day. They get to float in the sky."

msgid "Ben hep on ikide şaşırırdım. O hiç bozuntuya vermezdi."
msgstr "I always got mixed up at twelve. He never let it show."

msgid "Ben konuştum. Şimdi dinleme sırası bende."
msgstr "I had my turn. Now it's my turn to listen."

msgid "Ben mi? Ben sadece tohum ektim..."
msgstr "Me? I just planted a seed..."

msgid "Ben mi? Hâlâ... büyük ve turuncu muyum?"
msgstr "Me? Still... big and orange?"

msgid "Ben mi? Seninle mi? Şey... Olur. Bir, iki, üç, dört!"
msgstr "Me? With you? Um... Okay. One, two, three, four!"

msgid "Ben müziği! Bum, bum, bum!"
msgstr "I love music! Boom, boom, boom!"

msgid "Ben oynarım! Hem de her gün."
msgstr "I'll play with you! Every single day."

msgid "Ben seni alkışladım! Çünkü ritmin hiç şaşmadı."
msgstr "I clapped for you! Because your rhythm never slipped."

msgid "Ben seni dinliyorum. Ne oldu?"
msgstr "I'm listening to you. What happened?"

msgid "Ben seni duyuyorum."
msgstr "I hear you."

msgid "Ben seni görüyorum, Mırıl. Ve buradayım."
msgstr "I see you, Mumble. And I'm here."

msgid "Ben suyu. Bakın, çeşme masmavi!"
msgstr "I love water. Look, the fountain is bright blue!"

msgid "Ben söyledim, şimdi kulaklarım açık."
msgstr "I said my bit, now my ears are open."

msgid "Ben yavruları bırakamam. Sen dallara tırmanır mısın?"
msgstr "I can't leave the little ones. Will you climb the branches?"

msgid "Ben zilini çok beğendim. Dur, tezgâhının önünde alkışlayayım!"
msgstr "I love your bell so much. Wait, let me clap in front of your stall!"

msgid "Ben öğlen de denedim. Demek benimki öğlen değil."
msgstr "I tried at noon too. So mine isn't a noon flower."

msgid "Ben... başardım. Gerçekten başardım."
msgstr "I... did it. I really did it."

msgid "Ben... deneyebilirim."
msgstr "I... can try."

msgid "Ben... tabii gelirim. Sana bir şarkı bile öğrendim."
msgstr "I... of course I'll come. I even learned a song for you."

msgid "Beni alkışladın! Dikenler de utandı, çekildi."
msgstr "You clapped for me! The thorns felt shy and pulled back."

msgid "Beni bulan sizdiniz. Şimdi sıra sizde. Yolunuz açık olsun."
msgstr "You were the ones who found me. Now it's your turn. Safe travels!"

msgid "Beni buldunuz... Dört kere. Hep buldunuz."
msgstr "You found me... Four times. You always found me."

msgid "Beni eken çocuk bir gece köşeme bakmaya geldi."
msgstr "The child who planted me came to look at my corner one night."

msgid "Beni gölgeli köşeye bıraktı. 'Burada büyü' dedi."
msgstr "He left me in the shady corner. \"Grow here,\" he said."

msgid "Beni görmek için beklediniz mi? Hepiniz mi?"
msgstr "Did you all wait to see me? All of you?"

msgid "Beni mi? Kanat çırpışımı gören oldu mu yani?"
msgstr "Me? Did anyone see my wings flap?"

msgid "Beni... alkışladın mı? Beni ilk kez biri alkışladı."
msgstr "Did you... clap for me? Nobody has ever clapped for me before."

msgid "Beni... alkışladın mı? Bir şey almadan mı?"
msgstr "You... clapped for me? Without taking anything?"

msgid "Beni... alkışladın mı? Neyimi alkışladın ki?"
msgstr "You... clapped for me? What did you clap for?"

msgid "Beni... gerçekten görüyor musun?"
msgstr "Do you... really see me?"

msgid "Beni... kimse... görmüyor..."
msgstr "Nobody... ever... sees me..."

msgid "Benim dikenlerim hariç."
msgstr "Except my own thorns."

msgid "Benim gülüm geç açtı, kardeşlerimden sonra. Yine de açtı!"
msgstr "My rose bloomed late, after my brothers and sisters. But it bloomed!"

msgid "Benim lalem sabah açar. Seninki başka zaman açabilir."
msgstr "My tulip blooms in the morning. Yours may bloom at another time."

msgid "Benim nilüferim suda açar. Herkesin yeri de saati de ayrı."
msgstr "My water lily blooms on the water. Everyone's place and hour are different."

msgid "Benim papatyam öğlen açar. Şarkım da öğlen çıkar zaten."
msgstr "My daisy blooms at noon. And my song comes out at noon, too."

msgid "Benim saatim geldi. Bakın... açıyorum!"
msgstr "My hour has come. Look... I'm blooming!"

msgid "Benim söyleyeceğim şu: Toprak'ın tüneli çok güzel."
msgstr "Here's what I want to say: Dusty's tunnel is lovely."

msgid "Benim sıram!"
msgstr "My turn!"

msgid "Benim yanıma mı? Buraya kimse gelmezdi ki..."
msgstr "To my side? No one ever came here..."

msgid "Benim! Teşekkürler! Rakun sormadan almıştı."
msgstr "It's mine! Thank you! The raccoon took it without asking."

msgid "Benimci Fare"
msgstr "Mine-Mine Mouse"

msgid "Beyaz Kıvılcım"
msgstr "White Spark"

msgid "Beyaz Kıvılcım da geldi! Dört oldu, bir kaldı."
msgstr "The White Spark is here too! That makes four, one to go."

msgid "Bez bebeğim nerede? Rakunlar her şeyi kapıyor!"
msgstr "Where's my rag doll? The raccoons grab everything!"

msgid "Bezini çözelim. Davullar da konuşmak ister!"
msgstr "Let's untie the cloth. Drums want to talk too!"

msgid "Beş Anı Kabuğu'nu bul ve aç"
msgstr "Find and open the five Memory Shells"

msgid "Beş Kor bir oldu, Kızıl Sis dağıldı."
msgstr "The five Embers became one, and the Crimson Mist lifted."

msgid "Beş Kor bir oldu. Fener'e götürelim mi? Birlikte?"
msgstr "The five Embers are one. Shall we take it to the Lantern? Together?"

msgid "Beş Kor bizde, Fıstık. Hepsi bir oldu!"
msgstr "We have all five Embers, Peanut. They became one!"

msgid "Beş Kor tamam! Kızıl Sis dağılıyor"
msgstr "All five Embers! The Crimson Mist is lifting"

msgid "Beş Kor, beş öfkeli bekçi ve yeni dost Tıpış"
msgstr "Five Embers, five cross guardians and a new friend, Pitter"

msgid "Beş Kıvılcım bir araya geldi! Hadi, Fener'e!"
msgstr "The five Sparks are together! Come on, to the Lantern!"

msgid "Beş alay yankısını toplar mısın? Bir şey de kayıp."
msgstr "Can you gather the five teasing echoes? Something's lost too."

msgid "Beş inci tamam. Deniz Feneri yeniden yanacak!"
msgstr "All five pearls are here. The Lighthouse will shine again!"

msgid "Beş inci yerine kondu, Yaşlı Deniz Feneri yeniden yandı."
msgstr "The five pearls were put back, and the Old Lighthouse shone again."

msgid "Beş inciyi de bulacağız. Hırıl'ı ve Tırıl'ı da!"
msgstr "We'll find all five pearls. And Grumble and Tremble too!"

msgid "Beş parça da tamam! Lamba ay gibi parlıyor."
msgstr "All five pieces are done! The lamp glows like the moon."

msgid "Beş parça... beş yürek... Biraz... kestireceğim..."
msgstr "Five pieces... five hearts... I'll just... take a nap..."

msgid "Beş parçayı bul... Ben biraz daha uyuyayım..."
msgstr "Find the five pieces... I'll sleep a little longer..."

msgid "Beş sözü topla. Zirvede onları ona geri götüreceğiz."
msgstr "Gather five words. We'll take them back to him at the top."

msgid "Beş tohum Bahar Çeşmesi'ne dikildi, su yeniden akıyor."
msgstr "Five seeds were planted at the Spring Fountain, and water flows again."

msgid "Beş tohum da burada! Haydi, çeşmenin çevresine dikelim."
msgstr "All five seeds are here! Let's plant them around the fountain."

msgid "Beş tohum tamam! Bahar Çeşmesi yeniden akacak."
msgstr "Five seeds done! The Spring Fountain will flow again."

msgid "Beş tohumu da bulacağız. Tırıl'ı ve Dırıl'ı da!"
msgstr "We'll find all five seeds. And Tremble and Bramble too!"

msgid "Bikbik hangi kabuğu denesin?"
msgstr "Which shell should Shelby try?"

msgid "Bikbik sakinleşti! İnci arenanın ortasında parlıyor."
msgstr "Shelby is calm! The pearl is shining in the middle of the arena."

msgid "Bikbik yeni kabuğunda dans ediyor! Gördün mü?"
msgstr "Shelby is dancing in her new shell! Did you see?"

msgid "Bikbik'in eski kabuğundan çıktı."
msgstr "It came out of Shelby's old shell."

msgid "Bilge Kuzey"
msgstr "Sage North"

msgid "Biliyorum. Ama ilk defa birisi hatırladı."
msgstr "I know. But it's the first time anyone remembered."

msgid "Bilyeci Tombiş"
msgstr "Tombiş the Marble Seller"

msgid "Bilyem geldi. Ama fırıldak dönüyor, benimki sadece duruyor..."
msgstr "My marble came back. But the pinwheel spins, and mine just sits there..."

msgid "Bilyem! İçinde gökkuşağı varmış. Hiç bakmamışım!"
msgstr "My marble! There's a rainbow inside. I never looked!"

msgid "Bilyemi bir karga kaptı! Zaten cebimde dururdu hep."
msgstr "A crow snatched my marble! Though it always sat in my pocket."

msgid "Bilyen ışıl ışıl! Dur, tezgâhının önünde alkışlayayım!"
msgstr "Your marble sparkles! Wait, let me clap in front of your stall!"

msgid "Bin"
msgstr "Board"

msgid "Bir Köpüklü'ye Sakinleş ile derin nefes aldır"
msgstr "Help a Fizzler take a deep breath with Breathe"

msgid "Bir ahtapot gördüm. O da saklanıyordu. İkimiz de sustuk."
msgstr "I saw an octopus. It was hiding too. We both stayed quiet."

msgid "Bir ailesi var. Onu bulup evine götüreceğiz."
msgstr "She has a family. We'll find them and take her home."

msgid "Bir daha dene. Kapılara düz git, daha da hızlanırsın."
msgstr "Try again. Go straight through the gates and you'll go even faster."

msgid "Bir daha deneyeyim. 'Oyna' diyerek başlarım."
msgstr "I'll try again. I start by pressing 'Play'."

msgid "Bir daha karda uyumayacağım. Galiba."
msgstr "I won't sleep in the snow again. Probably."

msgid "Bir daha mı? Kaybettiğim hâlde mi?"
msgstr "Again? Even though I lost?"

msgid "Bir daha saklanayım mı? Say bakalım: bir, iki, üç..."
msgstr "Shall I hide again? Start counting: one, two, three..."

msgid "Bir daha çalmayacağım. Kimse duymasın beni."
msgstr "I'll never play again. Nobody should hear me."

msgid "Bir dahaki sefere tatil yapacağım, haberiniz olsun."
msgstr "Next time I'm taking a holiday, just so you know."

msgid "Bir dakika!"
msgstr "One minute!"

msgid "Bir dakika... İncinin içinde bir şey parlıyor."
msgstr "Wait a minute... Something is glowing inside the pearl."

msgid "Bir dakika... Şu kabak az önce kıpırdadı mı?"
msgstr "Wait a minute... Did that pumpkin just move?"

msgid "Bir davul sesi duydum. Gümbür gümbür ama... tatlı."
msgstr "I heard a drum. Boom boom, but... a sweet one."

msgid "Bir davulum olsa ben de çalmak isterdim."
msgstr "If I had a drum, I'd love to play it too."

msgid "Bir davulun üstüne bez bağlamışlar: 'SUS' yazıyor."
msgstr "Someone tied a cloth on a drum. It says 'HUSH'."

msgid "Bir de çocuklarım karanlıkta kayboldu. Görürsen eve yolla."
msgstr "And my kids got lost in the dark. If you see them, send them home."

msgid "Bir de üç küçük feneri yak. Kalbe giden perde ancak öyle kalkar."
msgstr "And light the three little lanterns. Only then will the curtain to the heart lift."

msgid "Bir doğum günü şapkası. Masada hiç tabak yok..."
msgstr "A birthday hat. There are no plates on the table..."

msgid "Bir gece Fener'in ışığını gördü ve çok özledi."
msgstr "One night he saw the Lantern's light and missed it so much."

msgid "Bir gece gökten küçük bir yıldız düştü."
msgstr "One night, a little star fell from the sky."

msgid "Bir gece sessizlik istedim. Sadece bir gece..."
msgstr "I wanted one quiet night. Just one night..."

msgid "Bir gün herkes güldü. 'Ne gürültü!' dediler."
msgstr "One day everyone laughed. 'What a racket!' they said."

msgid "Bir gün yeniden uyanacak."
msgstr "One day he'll wake up again."

msgid "Bir güç seç: yeni bir güç öğren ya da bildiğini yükselt"
msgstr "Pick a power: learn a new one or make one stronger"

msgid "Bir hortlak mı? Bakalım yorulunca ne olacak!"
msgstr "A ghost? Let's see what happens when it gets tired!"

msgid "Bir kürek toprak... Küçük bir çocuk eli..."
msgstr "A shovel of soil... A small child's hand..."

msgid "Bir martı yavrusu uçmayı deniyor. O da ürküyor. Yine deniyor."
msgstr "A baby seagull is learning to fly. It gets scared too. It tries again."

msgid "Bir meşale açıldı! Yıldızın altına git ve yak."
msgstr "A torch appeared! Go under the star and light it."

msgid "Bir resim: Minnoş ve Hırıl sırt sırta oturuyor."
msgstr "A drawing: Cubby and Grumble sitting back to back."

msgid "Bir resim: bir kulak, yanında soru işareti."
msgstr "A drawing: an ear with a question mark beside it."

msgid "Bir resim: herkes konuşuyor, köşede bir yavru susmuş."
msgstr "A drawing: everyone talking, a little one quiet in the corner."

msgid "Bir resim: kurbağalar şarkı söylüyor, Minnoş da."
msgstr "A drawing: the frogs are singing, and so is Cubby."

msgid "Bir resim: panayırda balonlar. Biri elinden kaçmış."
msgstr "A drawing: balloons at the fair. One slipped from his paw."

msgid "Bir salonun bütün kristalleri yanınca kristal kapı açılır."
msgstr "When every crystal in a hall is lit, the crystal door opens."

msgid "Bir sarmaşık daha! Çatıya tırman"
msgstr "One more vine! Climb to the roof"

msgid "Bir sezonu bitirince bölümleri buradan yeniden oynayabilirsin."
msgstr "Finish a season to replay its chapters from here."

msgid "Bir tohum tamam. Dört tane kaldı!"
msgstr "One seed done. Four more to go!"

msgid "Bir tünel kazdım, göstermek istedim. Kimse bakmadı."
msgstr "I dug a tunnel and wanted to show it. Nobody looked."

msgid "Bir yengeç evini sırtında taşıyor. Benim evim nerede?"
msgstr "A crab carries its home on its back. Where is my home?"

msgid "Bir yudum papatya çayı, bir derin nefes. Fıss..."
msgstr "A sip of chamomile tea, a deep breath. Fsss..."

msgid "Bir yıl önce yalnızdım. Şimdi bir köyüm var."
msgstr "A year ago I was alone. Now I have a village."

msgid "Bir yıldız daha, daha parlak"
msgstr "One more star, even brighter"

msgid "Bir yıldız haritası. Bir yıldızın yanına kalp çizilmiş."
msgstr "A star map. Someone drew a heart next to one star."

msgid "Bir zamanlar köyün en büyük kabağıydım ben!"
msgstr "I was once the biggest pumpkin in the village!"

msgid "Bir çırağın yerini kimse alamaz, Pati."
msgstr "Nobody can take a helper's place, Paws."

msgid "Bir ışık topu daha"
msgstr "One more light ball"

msgid "Bir, iki, üç, dört... Güm! Biliyordum, şimdi gelecekti!"
msgstr "One, two, three, four... Boom! I knew it, it was about to come!"

msgid "Bir, iki, üç... Tutuyorum!"
msgstr "One, two, three... I've got it!"

msgid "Biraz daha hızlı"
msgstr "A little faster"

msgid "Biraz su ister. Balonumdan birkaç damla vereyim."
msgstr "She needs some water. Let me give her a few drops from my bubble."

msgid "Biraz yabancı kokuyor. Ama büyümeye yerim var artık."
msgstr "It smells a little strange. But now I have room to grow."

msgid "Biri 'Buldum seni!' derse kaçmayacağım. Söz."
msgstr "If someone says 'Found you!' I won't run away. Promise."

msgid "Biri beni arıyor mu? Arıyorsa: buradayım, sisin içinde."
msgstr "Is anyone looking for me? If so: I'm here, inside the mist."

msgid "Biri bu şişeyi bulursa: ben Tırıl. Sanırım kayboldum."
msgstr "If anyone finds this bottle: I'm Tremble. I think I'm lost."

msgid "Biri seni aramaya gelecek mi diye bekliyorsun, değil mi?"
msgstr "You're waiting for someone to come looking for you, aren't you?"

msgid "Birini alkışlarsam ya da limonata içersem boşalır."
msgstr "If I clap for someone or drink lemonade, it empties."

msgid "Birinin bahçesi için sevinmek, dikenin ilacıymış."
msgstr "Being happy for someone's garden is the cure for thorns."

msgid "Birlikte daha parlakız."
msgstr "We shine brighter together."

msgid "Birlikte ritim tutalım. Dört vuruş, sen de say!"
msgstr "Let's keep the rhythm together. Four beats, count with me!"

msgid "Birlikte çalınan şarkıdan açtı."
msgstr "Playing together made it bloom."

msgid "Birlikte! Pırıltı Diyarı'nda şenlik var, davul da lazım!"
msgstr "Together! There's a festival in Glimmerland, and it needs a drum!"

msgid "Bitirdin! Bronz madalya senin. Balık kokulu ama güzel!"
msgstr "You finished! The bronze medal is yours. It smells fishy, but it's lovely!"

msgid "Biz geliyoruz. Bu sefer biri seni görecek."
msgstr "We're coming. This time someone will see you."

msgid "Bom! Bom! Bir daha, Hırıl!"
msgstr "Boom! Boom! Again, Grumble!"

msgid "Bostanda bir korkuluk kuşları kovalıyor. Uçamıyor ya, ondan."
msgstr "A scarecrow in the garden keeps chasing birds away. Maybe because he can't fly."

msgid "Bostanda dev bir kabak! Yaprakları diken diken olmuş."
msgstr "A giant pumpkin in the vegetable patch! Its leaves have gone all prickly."

msgid "Bostandaki korkuluğu alkışla"
msgstr "Clap for the scarecrow in the garden"

msgid "Boynumuz uzun, tüyümüz beyaz diye üzülüyormuş."
msgstr "She's sad that her neck is long and her feathers are white."

msgid "Boynuz'un Örsü"
msgstr "Horn's Anvil"

msgid "Bozuk değil. Onun saati gece. Gündüz ne yapsan açmaz."
msgstr "It's not broken. Its hour is night. It won't bloom in the daytime no matter what you do."

msgid "Boş yuva"
msgstr "Empty slot"

msgid "Boşluk: zıpla · W: sarmaşıkta tırman"
msgstr "Space: jump · W: climb vines"

msgid "Boşluk: zıpla, havada basılı tut: süzül!"
msgstr "Space: jump, hold it in the air: float!"

msgid "Bronz madalya!"
msgstr "Bronze medal!"

msgid "Brr! Mürekkebin içi buz gibi. Titreme barım doluyor!"
msgstr "Brr! The ink is icy cold. My Shiver Meter is filling up!"

msgid "Brrr! Biraz donakaldın"
msgstr "Brrr! You're a bit frozen"

msgid "Brrr... Burası çok sessiz. Neden bu kadar uykum geldi?"
msgstr "Brrr... It's so quiet here. Why am I so sleepy?"

msgid "Brrr... Pus bana kimsenin beni sevmediğini söyledi."
msgstr "Brrr... The Gloom told me nobody liked me."

msgid "Bu Dırıl'ın ilk anısı! Onu bir çocuk ekmiş."
msgstr "This is Bramble's first memory! A child planted him."

msgid "Bu Ponpon'un. Senin fırıldağını da bulacağım, söz!"
msgstr "This is Ponpon's. I'll find your pinwheel too, I promise!"

msgid "Bu Pus değil. Bu başka bir şey."
msgstr "This isn't the Gloom. It's something else."

msgid "Bu Tombiş'in. Senin zilini de bulacağım, söz!"
msgstr "This is Tombiş's. I'll find your bell too, I promise!"

msgid "Bu Tırıl'ın sesi! İnci onun ilk anısını saklamış."
msgstr "That's Tremble's voice! The pearl kept her first memory."

msgid "Bu Vırak'ın. Senin bilyeni de bulacağım, söz!"
msgstr "This is Vırak's. I'll find your marble too, I promise!"

msgid "Bu adanın işi bitmedi. Bitince sıradaki ada açılır."
msgstr "This island isn't finished yet. The next one opens when it is."

msgid "Bu bahçenin işi bitmedi. Bitince sıradaki kapı çiçek açar."
msgstr "This garden isn't finished yet. When it is, the next gate will bloom."

msgid "Bu balık pul pul parlıyor, kurbağa da beni taklit ediyor!"
msgstr "This fish shimmers with scales, and the frog is copying me!"

msgid "Bu benim davulum. Gürültü değil, şarkı çalıyordum."
msgstr "That's my drum. I wasn't making noise, I was playing a song."

msgid "Bu benim fenerim! Mavi olan!"
msgstr "That's my lantern! The blue one!"

msgid "Bu benim fenerim! Pembe olan!"
msgstr "That's my lantern! The pink one!"

msgid "Bu benim fenerim! Yeşil olan!"
msgstr "That's my lantern! The green one!"

msgid "Bu beyaz ışık benimle kalacak! Donsun her şey!"
msgstr "This white light stays with me! Let everything freeze!"

msgid "Bu bir Gece Çiçeği. Gece olunca açar."
msgstr "This is a Night Flower. It opens when night comes."

msgid "Bu bölgenin üç davulu da uyandı! Dinle, birlikte çalıyorlar."
msgstr "All three drums here are awake! Listen, they play together."

msgid "Bu da ne? Sanki... ürkmüş gibi."
msgstr "What is that? It looks... startled."

msgid "Bu dikenler güllerimin dikeni değil. Bunlar başka!"
msgstr "These thorns aren't from my roses. These are different!"

msgid "Bu duvarların ardına hiç güneş girmez. Burası Gölge Köşesi."
msgstr "The sun never shines behind these walls. This is Shadow Corner."

msgid "Bu gece mışıl mışıl uyuyacağım."
msgstr "Tonight I'll sleep like a baby."

msgid "Bu gece yakıyoruz. Hazır mısınız? Bir, iki, üç!"
msgstr "We light it tonight. Ready? One, two, three!"

msgid "Bu gri sis hayvanları huysuz yapıyor."
msgstr "This grey fog is making the animals grumpy."

msgid "Bu göle bakan, kendini değil başkasını görür!"
msgstr "Whoever looks at this lake sees someone else, not themselves!"

msgid "Bu gölün kurbağaları eskiden sırayla şarkı söylerdi."
msgstr "The frogs of this lake used to sing in turns."

msgid "Bu kabukta büyüdüm. Dışarısı çok büyük, çok yeni."
msgstr "I grew up in this shell. Outside is so big and so new."

msgid "Bu kabukta ilk ışığım var. Annem bana 'minik fenerim' demişti."
msgstr "This shell holds my first light. Mom called me 'my little lantern'."

msgid "Bu kapı bir Kıvılcım daha istiyor"
msgstr "This door needs one more Spark"

msgid "Bu kaya çok ağır. %s itebilirdi!"
msgstr "This rock is too heavy. %s could push it!"

msgid "Bu kayıt silinsin mi?"
msgstr "Erase this save?"

msgid "Bu köyde artık herkesin bir türlü ışığı var."
msgstr "Everyone in this village has a kind of light now."

msgid "Bu mavi sis tüylerimi diken diken etti!"
msgstr "This blue mist made my fur stand on end!"

msgid "Bu ormanda ağaçlar yolu fısıldar."
msgstr "In this forest, the trees whisper the way."

msgid "Bu oyuncak ayı... Kimse benimle oynamamıştı."
msgstr "This teddy bear... Nobody ever played with me."

msgid "Bu ritim hepimizin! Tırıl, sen de vur: bum, bum!"
msgstr "This beat is for all of us! Tremble, drum along: boom, boom!"

msgid "Bu rüzgâr sıcak... ve kırmızı. Bu Pus değil!"
msgstr "This wind is hot... and red. This isn't the Gloom!"

msgid "Bu sahne başından devam eder"
msgstr "This scene continues from its start"

msgid "Bu sarmaşık da ne? Dikenleri benimkilere benzemiyor."
msgstr "What's this vine? Its thorns don't look like mine."

msgid "Bu sarı ışık benim! Fırtınam seni uçuracak!"
msgstr "This yellow light is mine! My storm will blow you away!"

msgid "Bu sefer ben öndeyim!"
msgstr "I'm leading this time!"

msgid "Bu sefer de öndeyim. ...Ama önde olmak şart mı?"
msgstr "I'm in front again. ...But do I have to be in front?"

msgid "Bu sefer kimse kaçırılmadı. Kendisi saklanıyor."
msgstr "Nobody was taken this time. She's hiding by herself."

msgid "Bu sefer ritmi ben tutarım."
msgstr "This time I'll keep the beat."

msgid "Bu sefer sen yenildin. Peki, bir daha oynayalım mı?"
msgstr "This time you lost. So, shall we play again?"

msgid "Bu sefer suda bir kuğu var. Boynu ne uzun!"
msgstr "This time there's a swan on the water. Her neck is so long!"

msgid "Bu sefer üflemeyi unutma. Bir dilek tut!"
msgstr "Don't forget to blow this time. Make a wish!"

msgid "Bu sefer ışık yetmez. Bu sefer kulak lazım."
msgstr "This time light isn't enough. This time we need ears."

msgid "Bu sefer... başkası için sevinebilen bir kalp."
msgstr "This time... a heart that can be happy for someone else."

msgid "Bu sefer... el lazım. Kim el uzatacak?"
msgstr "This time... we need a hand. Who will reach out?"

msgid "Bu senin davetiyen. Haritana pastayı da çiz!"
msgstr "This is your invitation. Draw the cake on your map!"

msgid "Bu ses de neydi? Baykuş dağıldı ama Pus duruyor."
msgstr "What was that sound? The owl is gone, but the Gloom stays."

msgid "Bu ses çok üzgün. Kızgın değil, sadece yalnız."
msgstr "This sound is so sad. Not angry, just lonely."

msgid "Bu ses... Denizin ta uzağından geliyor."
msgstr "That voice... It comes from far across the sea."

msgid "Bu sis çok uykulu... Yakındaki ateşi yak!"
msgstr "This mist is so sleepy... Light the fire nearby!"

msgid "Bu sis öfke değil. Bu... korku. Herkes titriyor."
msgstr "This mist isn't anger. It's... fear. Everyone is shivering."

msgid "Bu söz Hırıl'ın... Kimse duymamış, duvarda kalmış."
msgstr "These are Grumble's words... Nobody heard them, so they stayed here."

msgid "Bu sözler Hırıl'ın içinde kalmış. Kimse duymamış."
msgstr "These words stayed inside Grumble. Nobody heard them."

msgid "Bu toprak çok nazlı. Yonca filizlendirebilir."
msgstr "This soil is very picky. Clover can make it sprout."

msgid "Bu yankı birine alay ediyor... Toplayınca sustu."
msgstr "This echo teases someone... It went quiet when I took it."

msgid "Bu yankılar... Hepsini biz söylemiştik. Gümbür'e."
msgstr "These echoes... We said all of them. To Rumble."

msgid "Bu yeşil ışık benim! Kimse almasın!"
msgstr "This green light is mine! Nobody can have it!"

msgid "Bu yıl herkes gelecek. Söz!"
msgstr "This year everyone will come. I promise!"

msgid "Bu yılın ödülü bir bahçeye değil, yardım eden bir ele!"
msgstr "This year's prize goes not to a garden, but to a helping hand!"

msgid "Bu çiçek gündüz açar."
msgstr "This flower opens in the daytime."

msgid "Bu şurup çok yapışkan! Platformlara zıplasam iyi olur."
msgstr "This syrup is so sticky! I'd better hop onto the platforms."

msgid "Bu... buldun mu? Bir daha saklanırım!"
msgstr "Did... did you find me? I'll hide again!"

msgid "Bugün benim doğum günüm! Köyde ilk doğum günüm."
msgstr "Today is my birthday! My first birthday in the village."

msgid "Bugün bir yıldız kaydı. Ürkmedim. Yani... çok az ürktüm."
msgstr "A star slid across the sky today. I wasn't scared. Well... only a teeny bit."

msgid "Bugün her gün doğum günüm gibi! Teşekkürler bekçi."
msgstr "Every day feels like my birthday! Thank you, keeper."

msgid "Bugün köyün yavruları senin resmini yaptı."
msgstr "Today the village little ones drew a picture of you."

msgid "Buhar çizgilerinden kaç. Kapak kalkınca vur!"
msgstr "Dodge the steam lines. Hit when the lid pops up!"

msgid "Buhar... gitti. İçim sıcak ama yakmıyor."
msgstr "The steam... is gone. I feel warm, but it doesn't burn."

msgid "Buhardan kaç, kapak kalkınca vur!"
msgstr "Dodge the steam, hit when the lid pops!"

msgid "Buharlı Kaplıca Köyü"
msgstr "Steamy Springs Village"

msgid "Buharlı Kaplıca Köyü ↓"
msgstr "Steamy Springs Village ↓"

msgid "Buharı bitti! Şimdi vur!"
msgstr "Out of steam! Hit now!"

msgid "Buldum! Kaç kere saklanırsan saklan."
msgstr "Found you! No matter how many times you hide."

msgid "Bulunmamış Mesaj Şişelerinin üstünde yıldız yanar"
msgstr "A star shines over Message Bottles you have not found"

msgid "Bulut Limanı"
msgstr "Cloud Harbor"

msgid "Bum bum bum, of!"
msgstr "Boom boom boom, ugh!"

msgid "Bum! Bu tokmağı kimse unutmayacak. Tezgâhım hep açık."
msgstr "Boom! Nobody will forget this drumstick. My stall is always open."

msgid "Bum, bum, sus! Daire bir vuruş sonra iner. Nefeslenince vur!"
msgstr "Boom, boom, hush! A circle lands one beat later. Hit when he rests!"

msgid "Bum-bum-tak! Hırıl'la birlikte çalacağız. Gel dinle!"
msgstr "Boom-boom-tap! Grumble and I will play together. Come listen!"

msgid "Bum-tak! Bum-tak! Kimse 'Sus!' demiyor!"
msgstr "Boom-tap! Boom-tap! Nobody says 'Hush!'"

msgid "Bum-tak! Gel bakalım. Ritim Tılsımı'm vuruşlarını güçlendirir."
msgstr "Boom-tap! Come here. My Rhythm Charm makes your hits stronger."

msgid "Bum. Ben de geldim. Hırıl'ın davulunu ben dinlerdim."
msgstr "Boom. I came too. I used to listen to Grumble's drum."

msgid "Bum... bum... Biri beni arıyormuş. Artık biliyorum."
msgstr "Boom... boom... Someone was looking for me. Now I know."

msgid "Bum... bum... Yavaş çalıyorum ki korkmasın."
msgstr "Bum... bum... I'm playing slowly so she won't be scared."

msgid "Bum... bum... Yoruldum. Neden kimse dinlemiyor?"
msgstr "Boom... boom... I'm tired. Why does nobody listen?"

msgid "Bundan sonra buradaki çan, yolculukta sana yuva olur."
msgstr "From now on, this bell is a home for you on your journey."

msgid "Bundan sonra her akşam çember kuracağız. Sağ ol, yavrum!"
msgstr "From now on we'll sit in a circle every evening. Thank you, dear!"

msgid "Bunlar senin değil, bizim korkularımız. Geçer."
msgstr "These aren't your fears, they're ours. They'll pass."

msgid "Bunlardan hangisi en sevdiğin?"
msgstr "Which of these is your favorite?"

msgid "Bunları Dırıl mı yazmış? Ne kadar da çok sormuş!"
msgstr "Did Bramble write these? He asked so many questions!"

msgid "Bunu mürekkebin içinde saklıyordum. Lacivert İnci senin!"
msgstr "I was hiding this inside the ink. The Navy Pearl is yours!"

msgid "Bunu saklayayım. Belki sahibini buluruz."
msgstr "I'll keep it. Maybe we'll find its owner."

msgid "Bunu söylemek cesaret ister. Teşekkür ederim."
msgstr "Saying that takes courage. Thank you."

msgid "Bunu söylemek cesaret ister. İyi ki söyledin."
msgstr "Saying that takes courage. I'm glad you said it."

msgid "Burada başla"
msgstr "Start here"

msgid "Burada kal"
msgstr "Stay here"

msgid "Burada kumlar bile yürüyor. Ben niye yürüyemiyorum?"
msgstr "Even the sand walks here. Why can't I?"

msgid "Burada kumlar yürür, yavrum. Gel, anlatayım."
msgstr "Here the sands walk, dear. Come, let me explain."

msgid "Burada kumlar yürüyor. Yolumu üç kere kaybettim."
msgstr "The sand walks around here. I lost my way three times."

msgid "Buradan bütün köy görünüyor. Süzülmek ne güzel, değil mi?"
msgstr "You can see the whole village from here. Floating is fun, right?"

msgid "Buradayım! Beni buldular. Siz de buldunuz!"
msgstr "I'm here! They found me. You found me too!"

msgid "Burası Fısıltı Ormanı... Ağaçlar konuşuyor mu?"
msgstr "This is the Whispering Woods... Are the trees talking?"

msgid "Burası Parlak Pazar. Herkes komşusunun oyuncağına bakıyor."
msgstr "This is Shiny Market. Everyone is looking at their neighbor's toy."

msgid "Burası Sera Kasabası. Herkes perdesini kapattı."
msgstr "This is Greenhouse Town. Everyone has closed their curtains."

msgid "Burası bahçenin en yüksek yeri. Kardeşimle yıldız sayardık."
msgstr "This is the highest spot in the garden. My sibling and I used to count stars here."

msgid "Burası çok karanlık. %s aydınlatabilirdi!"
msgstr "It's too dark here. %s could light it up!"

msgid "Burası çok karanlık. Sen parlıyorsun ama!"
msgstr "It's so dark here. But you're glowing!"

msgid "Burası Şarkı Çayırı mı? Hiç şarkı duyulmuyor."
msgstr "Is this Song Meadow? I can't hear any songs."

msgid "Buraya kadar geldin! Ben de peşinden koştum."
msgstr "You came all this way! I ran after you."

msgid "Buton"
msgstr "Button"

msgid "Buz Dikeni"
msgstr "Icicle Prickle"

msgid "Buz Golem Dondurma"
msgstr "Ice Golem Scoop"

msgid "Buz Golem Dondurma'yı uyandır"
msgstr "Wake up Scoop the Ice Golem"

msgid "Bölüm 0"
msgstr "Chapter 0"

msgid "Bölüm 0: Buharlı Kaplıca Köyü"
msgstr "Chapter 0: Steamy Springs Village"

msgid "Bölüm 0: Mercan Koyu ve Yaşlı Deniz Feneri"
msgstr "Chapter 0: Coral Cove and the Old Lighthouse"

msgid "Bölüm 0: Sera Kasabası ve kapalı perdeler"
msgstr "Chapter 0: Greenhouse Town and the Closed Curtains"

msgid "Bölüm 1"
msgstr "Chapter 1"

msgid "Bölüm 2"
msgstr "Chapter 2"

msgid "Bölüm 3"
msgstr "Chapter 3"

msgid "Bölüm 4"
msgstr "Chapter 4"

msgid "Bölüm 5"
msgstr "Chapter 5"

msgid "Bölüm seç"
msgstr "Chapter select"

msgid "Böyle bakınca yerden Yeşil Diken çıkıyor. İçimiz de sıkışıyor."
msgstr "When I look like this, a Green Thorn grows out of the ground. I feel squeezed inside, too."

msgid "Bülbül Nihan"
msgstr "Melody the Nightingale"

msgid "Bülbül Nihan ile konuş"
msgstr "Talk to Melody the Nightingale"

msgid "Bülbül Nihan'a dön"
msgstr "Go back to Melody the Nightingale"

msgid "Bütün davullar özgür! Hırıl bunu duysa çok sevinir."
msgstr "All the drums are free! Grumble would be so happy to hear."

msgid "Bütün kristaller parlıyor! Kapı açıldı."
msgstr "All the crystals are shining! The door is open."

msgid "Bütün köy dans ediyor! Hırıl, harika çalıyorsun!"
msgstr "The whole village is dancing! Grumble, you play wonderfully!"

msgid "Bütün vuruşların %10 güçlenir"
msgstr "All your hits get 10% stronger"

msgid "Bütün şişeleri toplayınca kapı sana açıldı."
msgstr "When you collected all the bottles, the door opened for you."

msgid "Büyük Kıvılcım! Dayan, geliyorum!"
msgstr "Great Spark! Hold on, I'm coming!"

msgid "Büyük Kıvılcım'ı her yıl olduğu gibi sen yakacaksın."
msgstr "You'll light the Great Spark, just like every year."

msgid "Büyük Kıvılcım'ın ışığı titriyor. Acele et, Fıstık!"
msgstr "The Great Spark's light is flickering. Hurry, Peanut!"

msgid "Büyük bekçilerden biri olarak Fıstık'ın takımına katıldın."
msgstr "As one of the big keepers, you joined Peanut's team."

msgid "Büyük bir fok da gök gürültüsünden ürküyor. Rahatladım."
msgstr "Even a big seal gets spooked by thunder. That makes me feel better."

msgid "Büyük kazana git"
msgstr "Go to the big kettle"

msgid "Büyük oğlum Pıtpıt o günden beri tepe yuvadan inmiyor."
msgstr "My eldest, Puddles, hasn't come down from the top nest since that day."

msgid "Büyük sahne ileride. Cırcır orada tek başına çalıyor."
msgstr "The big stage is ahead. Chirpy is playing there all alone."

msgid "Bıdık"
msgstr "Bubbles"

msgid "Bıdık'ı dinle"
msgstr "Listen to Bubbles"

msgid "Bırakma! Tekrar basılı tut."
msgstr "Don't let go! Hold it again."

msgid "Bırakmak yok. Üç deyince: bir, iki, üüüç!"
msgstr "No letting go. On three: one, two, threeee!"

msgid "C tuşuna basılı tut!"
msgstr "Hold the C key!"

msgid "C: alkışla! Sersemleyen Dikencinin yanında dur."
msgstr "C: clap! Stand next to the dizzy Prickle."

msgid "C: alkışla. Diken kapılarını aç, tohumla sete çık, kuzeye yürü!"
msgstr "C: clap. Open the thorn gates, climb the ledge with a seed, walk north!"

msgid "C: alkışla. Seraların önünde, sersemleyen Dikencilerin yanında!"
msgstr "C: clap. In front of the greenhouses, next to the dizzy Prickles!"

msgid "C: komşuların dikenli bahçelerinin önünde alkışla"
msgstr "C: clap in front of the neighbors' thorny gardens"

msgid "Cam Bilye"
msgstr "Glass Marble"

msgid "Cam seralar... ama hepsinin perdesi kapalı."
msgstr "Glass greenhouses... but all their curtains are closed."

msgid "Can"
msgstr "Health"

msgid "Canın 15 artar"
msgstr "Your health goes up by 15"

msgid "Canın 15 daha artar"
msgstr "Your health goes up by 15 more"

msgid "Canın kalıcı olarak 15 artar"
msgstr "Your health goes up by 15 for good"

msgid "Canın zaten dolu"
msgstr "Your health is already full"

msgid "Canını 40 doldurur"
msgstr "Fills 40 health"

msgid "Ce-ee! Beni buldun! Saklambaçta çok iyiyimdir."
msgstr "Pe-ek-a-boo! You found me! I'm really good at hide and seek."

msgid "Cesaret Kurabiyesi"
msgstr "Brave Cookie"

msgid "Cesaret Şekeri"
msgstr "Courage Candy"

msgid "Cik cik! Artık uçmayı biliyorum!"
msgstr "Cheep cheep! Now I know how to fly!"

msgid "Cik cik! Geçtim! El ele köprü kısacıkmış!"
msgstr "Cheep cheep! I crossed! Hand in hand, the bridge is so short!"

msgid "Cik cik! Rüzgâr beni buraya savurdu!"
msgstr "Cheep cheep! The wind blew me all the way here!"

msgid "Cik! Teşekkürler bekçi!"
msgstr "Cheep! Thank you, keeper!"

msgid "Cik... Başım dönüyor. Yuvam köprünün öbür ucunda."
msgstr "Cheep... I'm dizzy. My nest is at the other end of the bridge."

msgid "Civciv somurtmuş, sincap da herkesi dalından itiyor!"
msgstr "The chick is sulking, and the squirrel is pushing everyone off their branches!"

msgid "Cır cır cır! En yüksek ses benim! Başka şarkı yok!"
msgstr "Chirp chirp chirp! I'm the loudest! No other songs!"

msgid "Cırcır"
msgstr "Chirpy"

msgid "Cırcır Böceği Cırcır"
msgstr "Chirpy the Cricket"

msgid "Cırcır orada. Herkes beni dinliyor diye çok üzgün."
msgstr "Chirpy is over there. He's so sad that everyone listens to me."

msgid "Cırcır! Şarkım hep hızlanıp kaçıyor. Ritmi sen tutar mısın?"
msgstr "Chirpy! My song keeps speeding up and running away. Can you keep the beat?"

msgid "Cırcır'ın Ritmi"
msgstr "Chirpy's Beat"

msgid "Cırcırıyla herkesin şarkısını bastırıyor. Bence canı sıkkın."
msgstr "His chirping drowns out everyone's song. I think he's feeling down."

msgid "Daha hızlı koşarsın"
msgstr "You run faster"

msgid "Daha hızlı yürürsün, Pırıl uzaktan gelir"
msgstr "You walk faster, Glim come from afar"

msgid "Daha uçmayı bilmiyorlar. Onlara ben öğreteceğim!"
msgstr "They don't know how to fly yet. I'll teach them!"

msgid "Dairelerden kaç, halkada zıpla!"
msgstr "Dodge circles, jump the ring!"

msgid "Dal Dal Yukarı"
msgstr "Up, Branch by Branch"

msgid "Dalga daha uzağa, daha güçlü gider"
msgstr "The wave goes farther and hits harder"

msgid "Dalga düğmesi: bütün Titrekler dinler!"
msgstr "Wave button: all the Shiverlings listen!"

msgid "Dalgaların üstünde biri var. Işığı tir tir titriyor."
msgstr "Someone is out on the waves. Their light is shivering."

msgid "Dalın dibindeki toprağa merdiven ek. Yuvaları ve Dikencileri alkışla (C)"
msgstr "Plant a ladder in the soil at the foot of the branch. Clap for the nests and Prickles (C)"

msgid "Dalın dibindeki toprağa merdiven tohumu ek. Hemen büyür."
msgstr "Plant a ladder seed in the soil at the foot of the branch. It grows right away."

msgid "Dalış: kısa süre su altında yüzer"
msgstr "Dive: swim under the water for a little while"

msgid "Dans eden kaleleri nasıl çizerim acaba?"
msgstr "How do I draw dancing castles, I wonder?"

msgid "Dantel'in Dikiş Sandığı"
msgstr "Lacey's Sewing Chest"

msgid "Dar Gelen Kabuk"
msgstr "The Shell That's Too Small"

msgid "Dar değil! Sadece... biraz sıkı. Çıkmam, çıkamam!"
msgstr "It's not small! It's just... a little snug. I won't come out, I can't!"

msgid "Dar gelen kabuğu değiştirmek akıllıca. Not aldım."
msgstr "Swapping a shell that's too tight is smart. I took notes."

msgid "Davetiye"
msgstr "Invitation"

msgid "Davetiyeler bitmeden pastaya dokunmak yok!"
msgstr "No touching the cake until the invitations are out!"

msgid "Davul mu o, tencere mi?"
msgstr "Is that a drum or a pot?"

msgid "Davul mu? Ama çok yüksek sesli..."
msgstr "A drum? But it's so loud..."

msgid "Davul çalınca sisim biraz dağıldı. Tuhaf, hoşuma gitti."
msgstr "When the drum played, my mist cleared a little. Strange, but I liked it."

msgid "Davul: her vuruşu bir ritimdir"
msgstr "Drum: every hit is a beat"

msgid "Davulcu Gümbür'e dön"
msgstr "Go back to Rumble the Drummer"

msgid "Davulcu Keçi Gümbür"
msgstr "Rumble the Drummer Goat"

msgid "Davulcu Keçi Gümbür'ü dinle"
msgstr "Listen to Rumble the Drummer Goat"

msgid "Davulu duyuyor musun? Bizi çağırıyor."
msgstr "Can you hear the drum? It's calling us."

msgid "Davulu izle: batık oyuncak tekneye ulaş"
msgstr "Follow the drum: reach the sunken toy boat"

msgid "Davulum hazır. Bu kez birlikte çalalım!"
msgstr "My drum is ready. Let's play together this time!"

msgid "Davulum... kendi kendine çok hızlı çalıyor!"
msgstr "My drum... is beating very fast all by itself!"

msgid "Davulumla bütün bahçe dans ediyor. Çiçekler bile ritim tutuyor!"
msgstr "My drum makes the whole garden dance. Even the flowers keep the beat!"

msgid "Davulumu alıyorum. Hadi eve, Fener Gecesi'ne!"
msgstr "I'm taking my drum. Come on, home to Lantern Night!"

msgid "Davulumu böyle özgürce çalmak... Çok güzel."
msgstr "Playing my drum freely like this... It's lovely."

msgid "Davulun bu kez bütün kıyıya yetti. Tırıl ritmini ezbere biliyor!"
msgstr "This time your drum reached the whole shore. Tremble knows the beat by heart!"

msgid "Davulun güzel, Gümbür. Kızgınken bile ritmi vardı."
msgstr "Your drum is lovely, Rumble. It had rhythm even when you were mad."

msgid "Davulun ritmi yıldızlara bile ulaşıyor, Hırıl."
msgstr "Your drum's rhythm reaches the stars, Grumble."

msgid "Davulun ritmine dikkat! Daire, bir vuruş sonra iner."
msgstr "Watch the drum's rhythm! A circle lands one beat later."

msgid "Davulun ritmini izleyin. Ve birbirinizin elini bırakmayın!"
msgstr "Follow the drum's rhythm. And never let go of each other's hands!"

msgid "Davulun çaldığı kapıdan geç!"
msgstr "Go through the door where the drum is playing!"

msgid "Davulun İzi"
msgstr "The Drum's Trail"

msgid "Davulunla bütün bahçeyi dans ettirdin. Çiçekler bile ritim tuttu!"
msgstr "You made the whole garden dance with your drum. Even the flowers kept the beat!"

msgid "Davulunla üç kum kalesini dans ettir"
msgstr "Make three sand castles dance with your drum"

msgid "Dağ Feneri'ni yak"
msgstr "Light the Mountain Lantern"

msgid "Dağ Geçidi ↑"
msgstr "Mountain Pass ↑"

msgid "Dağ eriyor! Pus Kalesi'nin yolu açıldı."
msgstr "The mountain is melting! The way to Gloom Castle is open."

msgid "Dağ geçidine ulaş"
msgstr "Reach the mountain pass"

msgid "Dağ geçidine yürü"
msgstr "Walk to the mountain pass"

msgid "Dağ kükrüyor ama içinde küçük bir ses var."
msgstr "The mountain roars, but there's a small voice inside."

msgid "Dağların ardında Kor Vadisi ve Kızıl Sis"
msgstr "Beyond the mountains: Ember Valley and the Crimson Mist"

msgid "Dağların üstünde de pembe bulutlar toplanıyor."
msgstr "Pink clouds are gathering above the mountains, too."

msgid "Dağın Ses Çanı'nı çal"
msgstr "Ring the mountain's Echo Bell"

msgid "Dağın çanını çal"
msgstr "Ring the mountain's bell"

msgid "Dağın ötesinde Kızıl Yaprak Ormanı var. Orada da biri kızgın."
msgstr "Past the mountain is Redleaf Forest. Someone's cross there too."

msgid "Dede Toprak ile konuş"
msgstr "Talk to Grandpa Loam"

msgid "Dede Toprak'a dön"
msgstr "Go back to Grandpa Loam"

msgid "Dede Toprak'ın Tohum Kesesi"
msgstr "Grandpa Loam's Seed Bag"

msgid "Dede Vırak"
msgstr "Grandpa Croak"

msgid "Dede Vırak, önce siz anlatın. Dinliyorum."
msgstr "Grandpa Croak, you go first. I'm listening."

msgid "Dedenin kabuk kalkanı artık senin, Tosbi."
msgstr "Your grandpa's shell shield is yours now, Pebble."

msgid "Dedesinin Kabuk Kalkanı"
msgstr "Grandpa's Shell Shield"

msgid "Dedesinin Tohum Kesesi"
msgstr "Grandpa's Seed Bag"

msgid "Demek Pus'un adı Mırıl... Yalnız bir yıldız."
msgstr "So the Gloom's name is Mumble... A lonely star."

msgid "Demek bazı çiçekler gündüz açmaz. Gecesini bekler."
msgstr "So some flowers don't bloom in the daytime. They wait for their night."

msgid "Demek... biri beni hep arıyormuş."
msgstr "So... someone was always looking for me."

msgid "Demirci Boynuz"
msgstr "Horn the Smith"

msgid "Demirci Kerpeten"
msgstr "Pincers the Blacksmith"

msgid "Demlik'in Çay Tezgâhı"
msgstr "Teapot's Tea Stall"

msgid "Deneme kaydında oynanır: asıl kayıtların değişmez."
msgstr "Plays in a practice save: your real saves stay as they are."

msgid "Deniz Feneri sönük. Dedem orada biri yaşar derdi."
msgstr "The Lighthouse is dark. My grandpa used to say someone lives there."

msgid "Deniz Feneri'nde Mors Dede'ye dön"
msgstr "Go back to Grandpa Whiskers at the Lighthouse"

msgid "Deniz Feneri'nin yanındaki İşaret Fişeği'ni yak"
msgstr "Light the Signal Flare next to the Lighthouse"

msgid "Deniz kokusu, sıcak kakao... Yaz gecesi böyle olur."
msgstr "Sea breeze, hot cocoa... That's a summer night."

msgid "Deniz sisli. Önce buranın İşaret Fişeği'ni yak."
msgstr "The sea is misty. First, light this place's Signal Flare."

msgid "Denizanası yavrusu"
msgstr "Baby jellyfish"

msgid "Denizden ince bir ses geliyor... Biri ağlıyor gibi."
msgstr "A thin voice comes from the sea... Like someone crying."

msgid "Denize açıl"
msgstr "Set out to sea"

msgid "Denizin üstünde mavi bir sis... Titriyor."
msgstr "A blue mist over the sea... It's trembling."

msgid "Derenin başına bir köprü tohumu ek"
msgstr "Plant a bridge seed at the head of the stream"

msgid "Derenin başına köprü tohumu ek"
msgstr "Plant a bridge seed at the head of the stream"

msgid "Derenin başına tohum ek"
msgstr "Plant a seed at the head of the stream"

msgid "Derenin başındaki toprağa köprü tohumu ek"
msgstr "Plant a bridge seed in the soil at the head of the stream"

msgid "Derin Nefes"
msgstr "Deep Breath"

msgid "Derin Nefes: doğru anda basılırsa hasar almaz"
msgstr "Deep Breath: press it just in time and the hit slides off"

msgid "Derin nefes!"
msgstr "Deep breath!"

msgid "Dev Gölge"
msgstr "The Giant Shadow"

msgid "Dev Kabak"
msgstr "The Giant Pumpkin"

msgid "Dev Kabak Bahçıvan"
msgstr "the Giant Pumpkin"

msgid "Dev Kabak yorulunca vur, küsünce alkışla"
msgstr "When the Giant Pumpkin is tired, hit it; when it sulks, clap"

msgid "Dev Somurtkan Mantar"
msgstr "Giant Sulky Shroom"

msgid "Dev bir kök! Bütün sarmaşıklar buradan çıkıyor."
msgstr "A giant root! All the vines come out from here."

msgid "Dev köke ulaş"
msgstr "Reach the giant root"

msgid "Devam et"
msgstr "Continue"

msgid "Değişen Kumlar"
msgstr "Shifting Sands"

msgid "Değişen Kumlar... Şu kum tepesi az önce orada mıydı?"
msgstr "Shifting Sands... Was that dune there a moment ago?"

msgid "Değnek, asa, kılıç, sapan... Pırıl'ın varsa bak bakalım."
msgstr "Wands, staffs, swords, slings... Have a look if you've got Glim."

msgid "Değnek, asa, kılıç... Pırıl'ın varsa bak bakalım."
msgstr "Wand, staff, sword... If you have Glim, take a look."

msgid "Değnek, asa, kılıç: vuruşların daha parlak olur."
msgstr "Wand, staff, sword: they make your hits shine brighter."

msgid "Diken Topları ve gölgeler! Hepsi aynı soruyu mırıldanıyor."
msgstr "Thorn Balls and shadows! They're all humming the same question."

msgid "Diken Topu"
msgstr "Thorn Ball"

msgid "Diken barın doluyor! Alkışla ya da Nane Limonata iç."
msgstr "Your Thorn bar is filling up! Clap or drink Mint Lemonade."

msgid "Diken barın doluyor! Birini alkışla ya da çantadan Nane Limonata iç."
msgstr "Your Thorn bar is filling up! Clap for someone or drink Mint Lemonade from your bag."

msgid "Diken barını boşaltır, canını 10 doldurur"
msgstr "Empties your Thorn Meter and gives you 10 health"

msgid "Diken kapısının önünde alkışla. Dikenciler sersemleyince de!"
msgstr "Clap in front of the thorn gate. And when the Prickles get dizzy, too!"

msgid "Dikenci sersemleyince de alkışla. Kendi elindekini görür."
msgstr "Clap when a Prickle gets dizzy, too. It will see what it's holding."

msgid "Dikencileri sersemlet, sonra Alkış!"
msgstr "Make the Prickles dizzy, then Clap!"

msgid "Dikencileri sersemlet, sonra alkışla"
msgstr "Make the Prickles dizzy, then clap"

msgid "Dikencileri sersemlet, sonra yanlarında alkışla"
msgstr "Make the Prickles dizzy, then clap next to them"

msgid "Dikenciyi önce sersemlet, sonra yanında alkışla."
msgstr "Make the Prickle dizzy first, then clap next to it."

msgid "Dikenler de nereden çıktı? Havuçlarımı göremiyorum."
msgstr "Where did these thorns come from? I can't see my carrots."

msgid "Dikenler geri çekildi. Elindekine teşekkür!"
msgstr "The thorns pulled back. Thanks for what you're holding!"

msgid "Dikenler sıkarsa bir yudum limonata iç. Yolun açık olsun."
msgstr "If the thorns squeeze you, take a sip of lemonade. Safe travels."

msgid "Dikenler tarhımı sardı. Ben bunları ekmedim ki!"
msgstr "The thorns wrapped around my bed. I didn't plant these!"

msgid "Dikenler çekildi, yerinde çiçekler kaldı!"
msgstr "The thorns pulled back, and flowers are left in their place!"

msgid "Dikenlere kızmayın. Alkışlayın: kendileri çekilir!"
msgstr "Don't be mad at the thorns. Clap: they'll pull back by themselves!"

msgid "Dikenleri alkışla aç, sete tohumla çık. Ortada Tırıl bekliyor."
msgstr "Open the thorns by clapping, climb the ledge with a seed. Tremble is waiting in the middle."

msgid "Dikenlerim ışıl ışıl! Yeni bir hareket öğrendim."
msgstr "My spines are glowing! I learned a new move."

msgid "Dikenlerim, son bir kez parlayın!"
msgstr "My spines, shine one last time!"

msgid "Dikenlerin yanında içim sıkışıyor. Diken barım doluyor!"
msgstr "I feel squeezed near the thorns. My Thorn bar is filling up!"

msgid "Dikenli Bahçeler · Kıvılcım Bekçileri 4"
msgstr "Thorny Gardens · Spark Keepers 4"

msgid "Dikenli Dönüş"
msgstr "Spiky Spin"

msgid "Dikenli adacıktan kıyıya köprü tohumu ek"
msgstr "Plant a bridge seed from the thorny islet to the shore"

msgid "Dikenli bahçelerin önünde Alkış'a bas"
msgstr "Press Clap in front of the thorny gardens"

msgid "Dikenli kapı kendi kendine açıldı. İçeride biri var."
msgstr "The thorny gate opened by itself. Someone is inside."

msgid "Dikenli çit yolu kapatmış. Bir tohum toprağı görüyorum!"
msgstr "A thorny fence blocks the way. I see a patch of seed soil!"

msgid "Dikenli çit yolu kapatmış. Sağdaki toprağa git, E ile tohum ek!"
msgstr "A thorny fence blocks the way. Go to the soil on the right and press E to plant a seed!"

msgid "Dileğim hazır. Bir... iki... üç!"
msgstr "My wish is ready. One... two... three!"

msgid "Dinle beni!"
msgstr "Listen to me!"

msgid "Dinle beni. Bir kere olsun, sözümü bitireyim."
msgstr "Listen to me. Just once, let me finish what I'm saying."

msgid "Dinle! Uzaktan bir davul: bum... bum... Hırıl!"
msgstr "Listen! A drum far away: bum... bum... Grumble!"

msgid "Dinledim. Artık soğuyabilirsin."
msgstr "I listened. You can cool down now."

msgid "Dinledin mi gerçekten? Oh, buharım geçti!"
msgstr "You really listened? Oh, my steam is gone!"

msgid "Dinlerken yanına git."
msgstr "Go to it while it listens."

msgid "Dinlerken yanına git: ışığın onu ısıtır."
msgstr "Go to it while it listens: your light warms it."

msgid "Dinleyen biri olacaksa, o ben olayım!"
msgstr "If someone has to listen, let it be me!"

msgid "Direkteki ok açık geçidi gösteriyor. Oka bakarım!"
msgstr "The arrow on the post points to the open gap. I'll follow the arrow!"

msgid "Diyar Haritası"
msgstr "Map of Glimmerland"

msgid "Diyar haritam tamam! Her köşesini çizdim."
msgstr "My map of the land is done! I drew every corner."

msgid "Diyarlar Arası"
msgstr "Between Realms"

msgid "Dizlerim ağrıdı ama değdi."
msgstr "My knees ache, but it was worth it."

msgid "Dizlerim, dayanın bakalım. Geliyorum!"
msgstr "Come on, knees, hold up. I'm coming!"

msgid "Dolap"
msgstr "Wardrobe"

msgid "Donakaldın!"
msgstr "Frozen!"

msgid "Donakaldın! Sakinleş'e basılı tut: derin nefes."
msgstr "You froze! Hold Breathe: a deep breath."

msgid "Donakalmak normaldir. Derin bir nefes al, yavrum."
msgstr "Freezing up is normal. Take a deep breath, dear."

msgid "Dondurma uyandı!"
msgstr "Scoop woke up!"

msgid "Donmuş göle git"
msgstr "Go to the frozen lake"

msgid "Donmuş göle git: Dondurma orada"
msgstr "Go to the frozen lake: Scoop is there"

msgid "Doğuda, avluda. Yorulunca yanına git, el uzat."
msgstr "In the east, in the yard. When it gets tired, go to it and reach out a hand."

msgid "Doğum Günü Davetiyeleri"
msgstr "Birthday Invitations"

msgid "Doğum günüm vardı... ama kimse gelmedi."
msgstr "I had a birthday... but nobody came."

msgid "Doğum günün kutlu olsun, Mırıl. Işığın hep parlasın."
msgstr "Happy birthday, Mumble. May your light always shine."

msgid "Dur orada! Bu ışığa kimse dokunamaz!"
msgstr "Stop right there! Nobody touches this light!"

msgid "Dur, dur! Sen Pus değilsin... Sen bir bekçisin!"
msgstr "Wait, wait! You're not the Gloom... You're a keeper!"

msgid "Dur, dur! Önce Dede Vırak konuşsun, sıra onun!"
msgstr "Wait, wait! Grandpa Croak speaks first, it's his turn!"

msgid "Dur. Yuvanın en dibinde bir şey var..."
msgstr "Wait. There's something at the very bottom of the nest..."

msgid "Durdu ve dinliyor! Şimdi yanına gideyim."
msgstr "It stopped and it's listening! Now I'll go to it."

msgid "Durun! Ben de geliyorum. Kabuğum sıcak suyu sever, yavrum."
msgstr "Wait! I'm coming too. My shell loves warm water, dear."

msgid "Durup dinleyince yanına git. Işığın onu ısıtır."
msgstr "When it stops to listen, go to it. Your light warms it."

msgid "Duvarlar ne kadar yüksek! Buraya hiç güneş düşmüyor."
msgstr "The walls are so high! No sun ever shines here."

msgid "Duvarlardaki söylenemeyen sözleri topla"
msgstr "Gather the unspoken words on the walls"

msgid "Duydum. Sen bir 'Sus!' sözünden doğmuşsun, değil mi?"
msgstr "I did. You were born from a 'Shush!', weren't you?"

msgid "Duydun mu? Çayır yine şarkı söylüyor!"
msgstr "Did you hear? The meadow is singing again!"

msgid "Duyun! Yarın Çiçek Yarışması var. Jüri başkanı benim."
msgstr "Listen up! Tomorrow is the Flower Contest. I'm the head judge."

msgid "Döndünüz! Hepiniz! Kızıl Sis dağıldı, hıh!"
msgstr "You're back! All of you! The Crimson Mist is gone, hmph!"

msgid "Dönence"
msgstr "Orbit"

msgid "Dönüş"
msgstr "Spin"

msgid "Dönüş'e bas: hepsini birden sakinleştir!"
msgstr "Press Spin: calm them all at once!"

msgid "Dört düzenli vuruş! Sesi gelince de alkışla, dikenler çekilir."
msgstr "Four steady beats! When you hear the sound, clap and the thorns pull back."

msgid "Dört düzenli vuruş, ve şarkı geri geldi!"
msgstr "Four steady beats, and the song came back!"

msgid "Dört kardeş geldi. Artık kimse bana bakmıyor!"
msgstr "Four siblings came. Now nobody looks at me!"

msgid "Dört komşumu teker teker dinler misin?"
msgstr "Will you listen to my four neighbours, one by one?"

msgid "Dört minik, bir de Pıtpıt'ım. Yuvam hiç bu kadar dolu olmamıştı!"
msgstr "Four little ones, and my Puddles. My nest has never been so full!"

msgid "Dört tohumu Dırıl'ın çevresine ek"
msgstr "Plant four seeds around Bramble"

msgid "Dört tohumu çevresine ek. Bekçiler de yanında duracak."
msgstr "Plant four seeds around him. The keepers will stand beside him, too."

msgid "Dört tohumum var. Çevresine ekelim, hep beraber!"
msgstr "I have four seeds. Let's plant them around him, all together!"

msgid "Dört toprağa tohum ek (%d/4)"
msgstr "Plant seeds in four patches of soil (%d/4)"

msgid "Dövüş bitti. Dırıl'ın çevresindeki dört toprağa tohum ek (%d/4)"
msgstr "The fight is over. Plant seeds in the four patches around Bramble (%d/4)"

msgid "Dövüşmek yok artık. Sözlerini sana geri getireceğim."
msgstr "No more fighting. I'll bring your words back to you."

msgid "Dükkân"
msgstr "Shop"

msgid "Dün Pamuk'un havucunu yedim. Özür dilerim, Pamuk."
msgstr "Yesterday I ate Cotton's carrot. I'm sorry, Cotton."

msgid "Dün çizdiğim harita bugün tutmuyor. Çıtır görse saçını yolar!"
msgstr "The map I drew yesterday is wrong today. Crunch would pull out his hair!"

msgid "Düşen kirişlere dikkat, kuleye koş"
msgstr "Watch for falling beams, run to the tower"

msgid "Düşersen korkma. Aşağısı yumuşak, merdiven de orada."
msgstr "If you fall, don't worry. It's soft down there, and the ladder is there too."

msgid "Düşersen korkma. Burada herkes yavaşça süzülür."
msgstr "If you fall, don't worry. Everyone floats down slowly here."

msgid "Düşersen üzülme. Alt dala konarsın, merdiven yerinde durur."
msgstr "Don't be sad if you fall. You'll land on the lower branch, and the ladder stays put."

msgid "Dırıl"
msgstr "Bramble"

msgid "Dırıl bir Ay Çiçeğiymiş: sadece onun saati geceymiş."
msgstr "Bramble was a Moonflower: only his hour is night."

msgid "Dırıl küstü. Yanına git, Alkış'a bas!"
msgstr "Bramble sulked. Go to him and press Clap!"

msgid "Dırıl orada bekliyor. Tırıl da yanında. Gidiyoruz!"
msgstr "Bramble is waiting there. Tremble is with him. Let's go!"

msgid "Dırıl yorulunca vur, küsünce alkışla"
msgstr "When Bramble is tired, hit; when he sulks, clap"

msgid "Dırıl'a ışığını tuttun. O da sana ay ışığında açmayı gösterdi."
msgstr "You held your light for Bramble. He showed you how to bloom in the moonlight."

msgid "Dırıl'ı eken çocuk bir gece köşeye bakmaya gelmişti."
msgstr "A child who planted Bramble once came to look at the corner."

msgid "Dırıl'ın Saati"
msgstr "Bramble's Hour"

msgid "Dırıl'ın ilk anısı"
msgstr "Bramble's first memory"

msgid "Dırıl'ın köşesini aydınlatmak için."
msgstr "To light up Bramble's corner."

msgid "Dırıl'ın saati geceymiş"
msgstr "Bramble's hour is night"

msgid "Dırıl, dur! Onlar sana bakmaya geldi."
msgstr "Bramble, stop! They came to see you."

msgid "Dırıl, ışığımı sana tutuyorum. Ay ışığında aç bakalım!"
msgstr "Bramble, I'm holding my light for you. Bloom in the moonlight, go on!"

msgid "E: Tospik Nine ile konuş"
msgstr "E: Talk to Granny Shelly"

msgid "Efekt sesi"
msgstr "Effects volume"

msgid "Ektim ama açmıyor. Küçük bir tomurcuk kaldı."
msgstr "I planted it but it won't bloom. Just a little bud is left."

msgid "El Ele"
msgstr "Hand in Hand"

msgid "El ele gidelim. Ateş çok uzak değil."
msgstr "Let's go hand in hand. The fire isn't far."

msgid "El ele halkanın ortasında Tırıl'a el uzat"
msgstr "Hand in Hand: reach out to Tremble in the middle of the ring"

msgid "El ele sis perdesinden geçin."
msgstr "Go through the Shiver Veil hand in hand."

msgid "El ele: ışığınız büyüdü! Birlikte sis perdesinden geçin."
msgstr "Hand in hand: your light grew! Go through the Shiver Veil together."

msgid "El tut"
msgstr "Hold hands"

msgid "El tut, sessizlikte yürü"
msgstr "Hold hands, walk through the quiet"

msgid "Elimi tut. Aşağı bakma, bana bak. Birlikte geçeriz."
msgstr "Hold my hand. Don't look down, look at me. We'll cross together."

msgid "Elimi tut. Sessizlikte yürür, kaya altında bekleriz."
msgstr "Hold my hand. We'll walk in the quiet and wait under the rock."

msgid "Elimi tutar mısın? Bir patimi suya sokacağım."
msgstr "Will you hold my hand? I'm going to dip one paw in the water."

msgid "Elin sıcacık... Işığımız büyüdü!"
msgstr "Your hand is so warm... Our light grew!"

msgid "Elin sıcacık... Karanlık artık o kadar büyük değil."
msgstr "Your hand is so warm... The dark isn't so big anymore."

msgid "Elindekini sevmek, daha fazlasını istemekten güzelmiş."
msgstr "Loving what you have is better than wanting more."

msgid "Elini uzat, tutarlar. El ele kimse donakalmaz."
msgstr "Reach out a hand and they'll take it. Hand in hand, nobody freezes up."

msgid "En Minik Kazma"
msgstr "Tiniest Digby"

msgid "En büyük havuç benimki olacak!"
msgstr "I'll grow the biggest carrot!"

msgid "En güzel mumu ben seçtim. Mor olanı!"
msgstr "I picked the prettiest candle. The purple one!"

msgid "En parlak lalem senin olsun, Cırcır. Bende daha çok var!"
msgstr "Take my brightest tulip, Chirpy. I have plenty more!"

msgid "En sevdiğim mi? Şey... Bu mu? Yok, şu... Bilmiyorum!"
msgstr "My favorite? Um... This one? No, that one... I don't know!"

msgid "En son küçük Vık'ı dinle"
msgstr "Listen to little Peep last"

msgid "En tepedeki yuvanın kapısı dikenle kapalı. Kim var orada?"
msgstr "The door of the topmost nest is shut with thorns. Who's in there?"

msgid "En yüksek seviye"
msgstr "Top level"

msgid "En üst dala tırman"
msgstr "Climb to the top branch"

msgid "En üst dala tırman: Pıtpıt tepe yuvada"
msgstr "Climb to the top branch: Puddles is in the top nest"

msgid "Enerjin az. Yıldız Tozu iç!"
msgstr "Low energy. Drink some Stardust!"

msgid "Enerjin azalınca Yıldız Tozu iç. Bende de var!"
msgstr "Drink Stardust when your energy is low. I have some too!"

msgid "Enerjin hızla dolar: saniyede +2"
msgstr "Your energy fills fast: +2 per second"

msgid "Enerjini 30 doldurur"
msgstr "Fills 30 energy"

msgid "Epey uzun, ihtiyar şövalye! Bak, yeni bekçimiz var."
msgstr "Quite a while, old knight! Look, we have a new keeper."

msgid "Esince kayanın ardına geçerim. Ya da karşı yürürüm."
msgstr "When it blows, I go behind the rock. Or I walk against it."

msgid "Eski bir oyuncak ayı... Çok sevilmiş ama yalnız kalmış."
msgstr "An old teddy bear... Very loved, but left all alone."

msgid "Eski davulum gibi çalıyorsun! Kulaklarım dans ediyor."
msgstr "You play like my old drum! My ears are dancing."

msgid "Eski kabuğumda bir şey saklıyordum. Kum İncisi senin olsun."
msgstr "I was hiding something in my old shell. The Sand Pearl is yours."

msgid "Eski kabuğuna sığmıyor, bırakmaya da korkuyor. Sıkışmış."
msgstr "She doesn't fit her old shell, and she's scared to leave it. She's stuck."

msgid "Eski kayıt silinsin mi?"
msgstr "Erase the old save?"

msgid "Eskiden her taşta bir şarkıcı vardı. Şimdi çıt yok."
msgstr "There used to be a singer on every stone. Now it's silent."

msgid "Eskiden onlardan biriydi. Hâlâ biraz parlıyordu."
msgstr "It used to be one of them. It still glowed a little."

msgid "Etrafında 6 saniye dönen ışık topları dokunduğunu parlatır"
msgstr "Light balls spin around you for 6 seconds and brighten what they touch"

msgid "Etrafındaki herkese birden vurur"
msgstr "Hits everyone around you at once"

msgid "Etrafından dolan ya da Pruva Feneri tak!"
msgstr "Go around it, or put on the Bow Lantern!"

msgid "Eve dönünce ben de ona bir mektup yazacağım!"
msgstr "When I get home, I'll write a letter back!"

msgid "Eve giden yolu biliyorum artık!"
msgstr "I know the way home now!"

msgid "Evet"
msgstr "Yes"

msgid "Evet, gidelim"
msgstr "Yes, let's go"

msgid "Evet. Pus kötülük değil, yalnızlıktır. Bunu unutma."
msgstr "Yes. The Gloom isn't meanness, it's loneliness. Remember that."

msgid "Evim Mercan Bahçesi. Bir gün birini oraya götüreceğim."
msgstr "My home is Coral Garden. One day I'll take someone there."

msgid "Eğri ama en uzunu benimki! Hiç fark etmemiştim."
msgstr "Bendy, but mine is the longest! I never noticed."

msgid "Eğri fasulye de tatlıdır. Buyur, tadına bak!"
msgstr "Bendy beans are sweet too. Here, have a taste!"

msgid "FOKUR FOKUR! Kimse bana bakmaz, ben de kaynarım!"
msgstr "BUBBLE BUBBLE! Nobody looks at me, so I boil!"

msgid "Fasulyelerim eğri büğrü. Marul Teyze'ninkiler düzgün!"
msgstr "My beans are all bendy. Auntie Lettuce's are straight!"

msgid "Fazla parlak şey yük olurmuş. Sen de bak, beğendiğini al."
msgstr "Too many shiny things get heavy. You look, too, and take what you like."

msgid "Fener Fındığı"
msgstr "Lantern Nut"

msgid "Fener Gecesi"
msgstr "Lantern Night"

msgid "Fener Gecesi başlasın! Bum, bum, bum!"
msgstr "Let Lantern Night begin! Boom, boom, boom!"

msgid "Fener altı renkle yanıyor! Mırıl da artık bizden biri."
msgstr "The lantern shines with six colors! Mumble is one of us now."

msgid "Fener artık altı renkle yanıyor. Altıncısı Mırıl'ın!"
msgstr "The lantern now shines with six colors. The sixth is Mumble's!"

msgid "Fener henüz yanmadı"
msgstr "The lantern isn't lit yet"

msgid "Fener o geceden sonra mavi bir gece lambası gibi parladı."
msgstr "After that night, the Lighthouse glowed like a blue night-light."

msgid "Fener yandı!"
msgstr "Lantern lit!"

msgid "Fener yandı! Ama yukarıdaki sis çok uykulu görünüyor."
msgstr "The lantern is lit! But the mist up there looks very sleepy."

msgid "Fener yandı! Bir martı bana el sallıyor."
msgstr "The lantern is lit! A gull is waving at me."

msgid "Fener yandı! Köstebek köyü aydınlandı."
msgstr "The lantern is lit! The mole village is bright now."

msgid "Fener yandı! Pus biraz geri çekildi."
msgstr "The lantern is lit! The Gloom pulled back a little."

msgid "Fener yedinci rengini aldı: kırmızı. Gökkuşağı tamam!"
msgstr "The Lantern got its seventh color: red. The rainbow is whole!"

msgid "Fener'in Seçimi"
msgstr "The Lantern Chooses"

msgid "Fener'in Son Gecesi"
msgstr "The Lantern's Last Night"

msgid "Fener'in altıncı rengi söndü. Mırıl'ın rengi..."
msgstr "The Lantern's sixth color went out. Mumble's color..."

msgid "Fener'in son kıvılcımı yeni bekçisini kendi seçecek."
msgstr "The Lantern's last spark will choose its new keeper."

msgid "Fener'in yanında oturdum, seni düşündüm."
msgstr "I sat by the Lantern and thought of you."

msgid "Fener'in yanında uyanıyorsun..."
msgstr "You wake up by the Lantern..."

msgid "Feneri tek başıma yakamıyorum. İncileri yok artık."
msgstr "I can't light the Lighthouse alone. Its pearls are gone."

msgid "Fenerim parlıyor! Teşekkürler Fıstık!"
msgstr "My lantern is glowing! Thank you, Peanut!"

msgid "Fenerin önünde titriyormuş. Korkma, küçüğüm."
msgstr "It was shivering in front of the lantern. Don't be scared, little one."

msgid "Fenerleri bul, sahiplerine ver. Hadi bakalım!"
msgstr "Find the lanterns and give them back. Off you go!"

msgid "Filiz susamış. E ile su balonundan sula!"
msgstr "The sprout is thirsty. Water it with a water bubble using E!"

msgid "Filiz susamış: Sula'ya bas!"
msgstr "The sprout is thirsty: press Water!"

msgid "Filizini su balonunla sula"
msgstr "Water the sprout with your water bubble"

msgid "Filizlendirme: nazlı topraktan köprü ve merdiven büyütür"
msgstr "Sprouting: grows bridges and stairs from fussy soil"

msgid "Fişek hemen şurada. Yak ki sis perdesi açılsın."
msgstr "The flare is right over there. Light it so the Shiver Veil opens."

msgid "Fişek kumların kuzeyinde. Oklara bak, yolu onlar bilir."
msgstr "The flare is north of the sands. Follow the arrows, they know the way."

msgid "Fişek kuzeyde, taş köprünün önünde duruyor."
msgstr "The flare is in the north, in front of the stone bridge."

msgid "Fişek mürekkep içinde. Önce adaya biraz ışık lazım."
msgstr "The flare is covered in ink. The island needs some light first."

msgid "Fişek ne güzel yandı! Kakao da hazır, yavrum."
msgstr "The flare burned so nicely! The cocoa is ready too, dear."

msgid "Fişek rüzgârda sönüyor. Önce Paytak'ın işini bitireyim."
msgstr "The flare goes out in the wind. Let me finish Waddles's job first."

msgid "Fişek sisten sırılsıklam. Önce Hırıl'ı bulmalıyım."
msgstr "The flare is soaked by the mist. I must find Grumble first."

msgid "Fişek yandı! Sis perdesi açılıyor."
msgstr "The flare is lit! The Shiver Veil is opening."

msgid "Fişek yanınca posta kutusuna Fıstık'tan bir kart gelir"
msgstr "When the flare burns, a card from Peanut arrives in the mailbox"

msgid "Fişek ıslak ve soğuk. Köy korkarken yanmaz bu."
msgstr "The flare is wet and cold. It won't burn while the village is scared."

msgid "Fişek ıslak. Önce meşaleler ve yavru, sonra bu."
msgstr "The flare is wet. First the torches and the pup, then this."

msgid "Fişeği yak, köprüyü geç. Ona bir el lazım."
msgstr "Light the flare, cross the bridge. She needs a hand."

msgid "Fişeği yak. Işık gelince Tırıl dışarı bakar."
msgstr "Light the flare. When the light comes, Tremble will peek out."

msgid "Fişeğin içi kum dolmuş. Önce Tospik Nine'nin işini bitireyim."
msgstr "The flare is full of sand. Let me finish Granny Shelly's job first."

msgid "Fok Tombik"
msgstr "Chubby the Seal"

msgid "Fok Yavrusu Pıtır"
msgstr "Pitpat the Seal Pup"

msgid "Fok yavrusunu el ele iskeleye getir"
msgstr "Hand in hand, bring the seal pup to the pier"

msgid "Fokur Amca'nın şarkısı. Onu da sonuna kadar dinler misin?"
msgstr "Uncle Burble's song. Will you listen to it to the end too?"

msgid "Fokur fokur! Kim geldi yine? Şarkımı mı keseceksin?"
msgstr "Bubble bubble! Who's this? Here to cut my song short?"

msgid "Fokur gölün ortasındaki adada. Nilüferlerden zıplaya zıplaya git."
msgstr "Burble is on the island in the lake. Hop across the lily pads."

msgid "Fokur yoruldu, soluk soluğa! Şimdi vur!"
msgstr "Burble is tired, out of breath! Hit now!"

msgid "Fokur'un şarkısını sonuna kadar dinledin, değil mi?"
msgstr "You listened to Burble's song to the end, didn't you?"

msgid "Fokur... fokur... Sen beni dinledin mi?"
msgstr "Bubble... bubble... Did you listen to me?"

msgid "Fokur... fokur... Şarkım hep yarım kaldı..."
msgstr "Bubble... bubble... My song always stayed half-sung..."

msgid "Fokurdayan Göl"
msgstr "Bubbling Lake"

msgid "Fokurdayan Göl serinledi"
msgstr "Bubbling Lake cooled down"

msgid "Fokurdayan Göl ↑"
msgstr "Bubbling Lake ↑"

msgid "Fokurdayan Göl ↓"
msgstr "Bubbling Lake ↓"

msgid "Fokurdayan Göl! Su kaynıyor, nilüferler buhar içinde."
msgstr "Bubbling Lake! The water boils, the lily pads are steaming."

msgid "Fokurdayan suya dikkat!"
msgstr "Watch out for the bubbling water!"

msgid "Fokurdayan suya dikkat: halka çıkınca uzak dur!"
msgstr "Watch the bubbling water: step away when a ring shows!"

msgid "Fındık"
msgstr "Nut"

msgid "Fındık Fırlatma"
msgstr "Hazelnut Toss"

msgid "Fındık Fırlatma: seken, çok hedefli atış"
msgstr "Hazelnut Toss: bouncy shot that hits many"

msgid "Fırfır oturdu, soluk soluğa! Şimdi vur!"
msgstr "Whirly sat down, out of breath! Hit now!"

msgid "Fırfır sakinleşti mi? Kilit açıldı, yapraklar dans ediyor!"
msgstr "Whirly calmed down? The lock is open, the leaves are dancing!"

msgid "Fırtına Adası"
msgstr "Storm Isle"

msgid "Fırtına Adası'na uç!"
msgstr "Fly to Storm Isle!"

msgid "Fırtına Kayası"
msgstr "Storm Rock"

msgid "Fırtına Kayası'nın İşaret Fişeği'ni yak"
msgstr "Light Storm Rock's Signal Flare"

msgid "Fırtına Kayası... Şimşek hiç durmuyor!"
msgstr "Storm Rock... The lightning never stops!"

msgid "Fırtına Martısı Rüzgâr"
msgstr "Gale the Storm Gull"

msgid "Fırtına Martısı Rüzgâr'ı yatıştır"
msgstr "Calm Gale the Storm Gull"

msgid "Fırtına Yumağı"
msgstr "Storm Puff"

msgid "Fırtına dindi"
msgstr "The storm is over"

msgid "Fırtına dindi, tepe görüldü. Fırtına Adası'na uçabiliriz!"
msgstr "The storm stopped, the hill is clear. We can fly to Storm Isle!"

msgid "Fırtına dindi. Kayalıklar ilk kez bu kadar sakin."
msgstr "The storm calmed down. The cliffs have never been this peaceful."

msgid "Fırtınada savrulan martı yavrularını bul"
msgstr "Find the gull chicks blown away by the storm"

msgid "Fırtınalı Gece"
msgstr "A Stormy Night"

msgid "Fırtınalı bir gece akıntı beni aldı götürdü. Çok uzağa."
msgstr "On a stormy night the current swept me away. Very far."

msgid "Fırtınalı bir gece buradan minik bir ışık geçti. Titriyordu."
msgstr "On a stormy night a tiny light passed by here. It was trembling."

msgid "Fırtınam dindi. Al, bu inci yuvamda duruyordu."
msgstr "My storm has calmed. Here, this pearl was sitting in my nest."

msgid "Fırıldakçı Vırak"
msgstr "Vırak the Pinwheel Maker"

msgid "Fırıldağım geldi. Ama zil ses çıkarıyor, benimki çıkarmıyor..."
msgstr "My pinwheel came back. But the bell makes a sound, and mine doesn't..."

msgid "Fırıldağım! Üfledim, döndü! Vırak vırak!"
msgstr "My pinwheel! I blew and it spun! Vırak vırak!"

msgid "Fırıldağımı bir karga kaptı! Hiç üflememiştim bile."
msgstr "A crow snatched my pinwheel! I never even blew it."

msgid "Fırıldağın rüzgârı yakalıyor! Dur, tezgâhında alkışlayayım!"
msgstr "Your pinwheel catches the wind! Wait, let me clap in front of your stall!"

msgid "Fıss... Ohh. Ne güzel bir serinlik."
msgstr "Fsss... Ahh. What a nice cool feeling."

msgid "Fıstık"
msgstr "Peanut"

msgid "Fıstık \"Bir çırağın yerini kimse alamaz\" dedi. Yonca'ya ilk dersi sen verdin."
msgstr "Peanut said, \"Nobody can take a helper's place.\" You gave Clover her first lesson."

msgid "Fıstık o kırmızı sisi izliyor. Yeni macera yakında!"
msgstr "Peanut is watching that red mist. A new adventure is coming!"

msgid "Fıstık sana kendi kalkanını verdi: artık çırak değil, şövalyesin!"
msgstr "Peanut gave you his own shield: you're a knight now, not an apprentice!"

msgid "Fıstık ışıkla uyudu"
msgstr "Peanut sleeps with the light"

msgid "Fıstık! Bu gece Yıldız Şenliği var."
msgstr "Peanut! The Star Festival is tonight."

msgid "Fıstık! Çok şükür buradasın."
msgstr "Peanut! Thank goodness you're here."

msgid "Fıstık'ın Eski Eldiveni"
msgstr "Peanut's Old Gauntlet"

msgid "Fıstık'ın Kartpostalları"
msgstr "Peanut's Postcards"

msgid "Fıstık'ın Mektupları"
msgstr "Peanut's Letters"

msgid "Fıstık'ın Seçimi"
msgstr "Peanut's Choice"

msgid "Fıstık'ın bütün kartlarını okudum."
msgstr "I read all of Peanut's cards."

msgid "Fıstık'ın bütün mektuplarını okudum."
msgstr "I've read all of Peanut's letters."

msgid "Fıstık'ın heykeli"
msgstr "Peanut's statue"

msgid "Fıstık'ın heykelini ziyaret et"
msgstr "Visit Peanut's statue"

msgid "Fıstık, dikkat et! Sis yaklaşıyor."
msgstr "Peanut, careful! The fog is coming."

msgid "Fısıldayan Ağaç"
msgstr "Whispering Tree"

msgid "Fısıltı Ormanı"
msgstr "Whispering Woods"

msgid "Fısıltı Ormanı seni bekliyor!"
msgstr "The Whispering Woods are waiting for you!"

msgid "Fısıltı Ormanı yeniden yeşil"
msgstr "The Whispering Woods are green again"

msgid "Fısıltı Ormanı ↑"
msgstr "Whisper Forest ↑"

msgid "Fısıltıları doğru oku, ormanın kalbine ulaş"
msgstr "Read the whispers right and reach the forest's heart"

msgid "Gece Bekçileri"
msgstr "The Night Guards"

msgid "Gece Gelen Çocuk"
msgstr "The Child Who Came at Night"

msgid "Gece Lambası"
msgstr "Night-Light"

msgid "Gece Regatası"
msgstr "Night Regatta"

msgid "Gece kimse bakmaya gelmemişti. Bu gece herkes burada."
msgstr "Nobody came to look at night. Tonight everyone is here."

msgid "Gece Çiçeği"
msgstr "Night Flower"

msgid "Gece Çiçeği'ni ektim ama açmadı. Tohum bozuk mu?"
msgstr "I planted the Night Flower but it didn't bloom. Is the seed broken?"

msgid "Geceyi bekle: Dırıl'ın saati geliyor"
msgstr "Wait for night: Bramble's hour is coming"

msgid "Gel Yonca! Aradığımız kalp tam da böyle bir kalp."
msgstr "Come, Clover! A heart like this is just what we were looking for."

msgid "Gel bakalım. Kalbim büyüdü, sana da yer var, bana da."
msgstr "Come here. My heart grew, and there's room for you and for me."

msgid "Gel, Hırıl! Fener'in yedinci rengi seni bekliyor."
msgstr "Come, Grumble! The Lantern's seventh color is waiting for you."

msgid "Gel, göle birlikte bakalım. Sarmaşıklar çekiliyor!"
msgstr "Come, let's look at the lake together. The vines are pulling back!"

msgid "Geldik! Bir kere bile çarpmadı. Saymak işe yarıyor!"
msgstr "We made it! It didn't hit us even once. Counting works!"

msgid "Geldin! Burası Mercan Bahçesi. Benim evim."
msgstr "You came! This is Coral Garden. My home."

msgid "Geldin! Davulumu duydun, değil mi?"
msgstr "You came! You heard my drum, right?"

msgid "Geldin! Onu dinledin. Ben de hep bunu istedim."
msgstr "You came! You listened to him. That's all I ever wanted."

msgid "Gelgit Havuzu"
msgstr "Tide Pool"

msgid "Gelme! Ağabeyim hep kızıyor. Kimse beni dinlemiyor."
msgstr "Don't come! My brother is always cross. Nobody listens to me."

msgid "Gelmeyin! Kapıyı ben kapattım. Burası benim yuvam!"
msgstr "Don't come! I closed the door. This is my nest!"

msgid "Gelmeyin! Karanlık, uçurum, fırtına... Hepsi burada!"
msgstr "Stay away! Darkness, a cliff, a storm... It's all here!"

msgid "Gelmeyin! Yuvadan çıkmam! Aşağısı çok yüksek!"
msgstr "Stay away! I won't leave the nest! It's so high down there!"

msgid "Gemi hazır! Rüzgâr esince bir kayanın dibine saklan."
msgstr "The ship is ready! When the wind blows, hide behind a rock."

msgid "Gemime bin, seni adalara uçurayım! Bir de yavrularım kayıp..."
msgstr "Hop on my ship, I'll fly you to the isles! And my chicks are lost..."

msgid "Gemiye bin!"
msgstr "Board the ship!"

msgid "Gemiye bin: çanlar ve balonlar seni bekliyor"
msgstr "Board the ship: bells and balloons are waiting"

msgid "Gemiyle Fırtına Adası'na uç"
msgstr "Fly the ship to Storm Isle"

msgid "Gençler, toplanın. Fıstık ışığı beş parçaya böldü."
msgstr "Gather round, young ones. Peanut split the light in five."

msgid "Geri"
msgstr "Back"

msgid "Gerisini pazara geri götüreceğim. Bak, bir de tohum çıktı!"
msgstr "I'll take the rest back to the market. Look, a seed came out too!"

msgid "Geriye tek inci kaldı. Kayıp Ada sisin içinde."
msgstr "Only one pearl is left. Lost Island is hidden in the mist."

msgid "Gerçekten mi? O zaman... Al, bu ışık senin olsun."
msgstr "Really? Then... here, this light can be yours."

msgid "Gez ya da Baloncuk Kapısı'ndan dön"
msgstr "Look around, or go back through the Bubble Gate"

msgid "Geç"
msgstr "Skip"

msgid "Geç açan da çiçek sayılıyor mu?"
msgstr "Does a late bloomer count as a flower too?"

msgid "Geçitte bir şey var. Kocaman, kırmızı bir bulut!"
msgstr "Something's in the pass. A huge red cloud!"

msgid "Gir"
msgstr "Enter"

msgid "Girişteki Tırıl ile konuş"
msgstr "Talk to Tremble at the entrance"

msgid "Git"
msgstr "Go"

msgid "Git, onu da dinle. Sonra tepedeki çanı çal."
msgstr "Go and listen to it too. Then ring the bell on the hill."

msgid "Gitsin! Herkes gitsin! Bu ışık benim!"
msgstr "Go away! Everyone go away! This light is mine!"

msgid "Gizli Bölge"
msgstr "Secret Area"

msgid "Gri Ağaç"
msgstr "Grey Tree"

msgid "Gri Kristal Böceği"
msgstr "Grey Crystal Beetle"

msgid "Gri Rüzgâr"
msgstr "Grey Wind"

msgid "Gri ağaç beni kandırdı! Tersini yapmalıydım."
msgstr "The grey tree tricked me! I should have done the opposite."

msgid "Gri kristale vur, parlasın! Kıskaç'ın gölü en dipte."
msgstr "Hit a grey crystal so it shines! Pinch's lake is at the very bottom."

msgid "Gri kristale vurursan yeniden parlar!"
msgstr "Hit a grey crystal and it will shine again!"

msgid "Gri kristallere vur!"
msgstr "Hit the grey crystals!"

msgid "Gri kristallere vur, parlasınlar!"
msgstr "Hit the grey crystals so they shine!"

msgid "GÜM! Aaah, kulaklarım! Susun, susun, SUSUN!"
msgstr "BOOM! Aaah, my ears! Hush, hush, HUSH!"

msgid "GÜRRR! Kimse geçemez! Kimse dinlemez!"
msgstr "RUMBLE! Nobody passes! Nobody listens!"

msgid "Gök Davulu"
msgstr "Sky Drum"

msgid "Gök davul çalıyor, ben de sayıyorum. Bu inci senin olsun."
msgstr "The sky drum plays and I count. This pearl is yours."

msgid "Gök davul çalıyor: say, ritim tut."
msgstr "The sky drum plays: count, keep the rhythm."

msgid "Gök gürledi. Gölgem kocaman oldu. Kendi gölgemden kaçtım."
msgstr "Thunder rumbled. My shadow got huge. I ran away from my own shadow."

msgid "Gökkuşağı"
msgstr "Rainbow"

msgid "Gökkuşağı Dalgası"
msgstr "Rainbow Wave"

msgid "Gökkuşağı Kumsalı"
msgstr "Rainbow Beach"

msgid "Gökkuşağı Köyü"
msgstr "Rainbow Village"

msgid "Gökkuşağı Köyü ve Çayır"
msgstr "Rainbow Village and Meadow"

msgid "Gökkuşağı Şenliği"
msgstr "Rainbow Festival"

msgid "Gökteki evimi unuttum. Yıldızlar beni hatırlar mı?"
msgstr "I forgot my home in the sky. Will the stars remember me?"

msgid "Gökyüzü yeniden masmavi"
msgstr "The sky is bright blue again"

msgid "Göl beni son durduğum adacığa geri bıraktı."
msgstr "The lake put me back on the last islet I stood on."

msgid "Göl fokurdamıyor artık, sadece mırıldanıyor. Çay ister misin?"
msgstr "The lake doesn't bubble anymore, it just hums. Want some tea?"

msgid "Göl kuzeyde. Dondurma'yı uyandır, Kıvılcım'ı kurtar."
msgstr "The lake is to the north. Wake up Scoop, save the Spark."

msgid "Göl pırıl pırıl. Paçalı'nın ayak izleri her yerde!"
msgstr "The lake is sparkling. Flappy's footprints are everywhere!"

msgid "Göl yine ayna gibi! Paçalı da bizimle yüzüyor."
msgstr "The lake is like a mirror again! Flappy is swimming with us."

msgid "Gölcüğün üstündeki Nilüfer Tohumu'nu al"
msgstr "Take the Water Lily Seed above the little pond"

msgid "Göle mi vardın? Kurbağaların şarkısını merak ettim."
msgstr "Did you reach the lake? I wonder how the frogs sing."

msgid "Gölge Balığı"
msgstr "Shadow Fish"

msgid "Gölge Kopya"
msgstr "Shadow Copy"

msgid "Gölge Köşesi"
msgstr "Shady Corner"

msgid "Gölge Köşesi'nde çiçek açtı. Buna gece bahçesi diyeceğim!"
msgstr "A flower bloomed in Shadow Corner. I'll call it the night garden!"

msgid "Gölge Köşesi'nin ark kapağını aç"
msgstr "Open Shadow Corner's sluice gate"

msgid "Gölge Prens Mırıl"
msgstr "Shadow Prince Mumble"

msgid "Gölge küçüldü! Halkalardan kaç, sıradaki meşaleyi bekle."
msgstr "The shadow shrank! Dodge the rings and wait for the next torch."

msgid "Gölge çitini Işık Dalgası ile aç"
msgstr "Open the shadow fence with Light Wave"

msgid "Gölge ışığı sevmez. Meşaleleri yakmalıyım!"
msgstr "Shadows don't like light. I must light the torches!"

msgid "Gölgeler korkudan geliyor. Kaç, Tırıl yorulunca vur!"
msgstr "The shadows come from fear. Dodge them, and hit when Tremble gets tired!"

msgid "Gölgelerden kaç, yorulunca vur!"
msgstr "Dodge the shadows, hit when tired!"

msgid "Gölgeli Köşe"
msgstr "Shadow Corner"

msgid "Gölgenin Yolu"
msgstr "The Shadow's Path"

msgid "Gölgenin sahibine el uzat"
msgstr "Reach out a hand to the shadow's owner"

msgid "Gölü geçtin! Ben de peşinden yüzdüm."
msgstr "You crossed the lake! I swam after you."

msgid "Gölü o örtmüş. Kendi yansımasını hiç görmemiş ki!"
msgstr "She covered the lake. She never saw her own reflection!"

msgid "Gölün Aynaları"
msgstr "The Lake's Mirrors"

msgid "Gölün Ses Çanı'nı çal"
msgstr "Ring the lake's Echo Bell"

msgid "Gölün ark kapağını aç"
msgstr "Open the lake's sluice gate"

msgid "Gölün çanını çal"
msgstr "Ring the lake's bell"

msgid "Gölün çanını çal, sonra adaya geç. Onu sonuna kadar dinle."
msgstr "Ring the lake's bell, then cross to the island. Listen to him to the end."

msgid "Görev tamam!"
msgstr "Quest done!"

msgid "Görevi teslim et"
msgstr "Hand in quest"

msgid "Görünüşün"
msgstr "Your look"

msgid "Görüyorum. Artık yalnız değilsin, Mırıl."
msgstr "I do. You're not alone anymore, Mumble."

msgid "Görüşürüz Minik Kol! Işıklarınız hiç sönmesin."
msgstr "See you, Little Arm! May your lights never go out."

msgid "Gözlük"
msgstr "Glasses"

msgid "Gübre Topu"
msgstr "Grow Ball"

msgid "Gül Tohumu"
msgstr "Rose Seed"

msgid "Gül Tohumu sende. Sıradaki bahçe Ayna Gölü!"
msgstr "You have the Rose Seed. The next garden is Mirror Lake!"

msgid "Gül Tohumu yuvanın önünde parlıyor. Al onu, senin hakkın!"
msgstr "The Rose Seed is shining in front of the nest. Take it, you earned it!"

msgid "Gül Tohumu! Sevgi paylaşılınca azalmıyor, çoğalıyor."
msgstr "The Rose Seed! Love doesn't shrink when shared, it grows."

msgid "Gül Tohumu'nu al"
msgstr "Take the Rose Seed"

msgid "Güm deyince saklanıyordum. Sayınca içim rahatladı."
msgstr "I used to hide at every boom. When I counted, I felt better."

msgid "Güm gelince sayıyorum. Bir, iki, üç... Davul gibi!"
msgstr "When the boom comes, I count. One, two, three... Like a drum!"

msgid "Güm! Ama dinle... Hep aynı sırayla geliyor."
msgstr "Boom! But listen... It always comes in the same order."

msgid "Güm! Duydun mu? Bu ada hiç susmuyor."
msgstr "Boom! Did you hear? This island never goes quiet."

msgid "Güm, sus, sus, sus... Artık ben de ritim tutuyorum!"
msgstr "Boom, hush, hush, hush... Now I keep the rhythm too!"

msgid "Güm... Yine güm... Buradan çıkamıyorum."
msgstr "Boom... Boom again... I can't get out of here."

msgid "Gümbür Dalgası"
msgstr "Rumble Wave"

msgid "Gümbür Dalgası ile Titrekleri sakinleştir"
msgstr "Calm the Shiverlings with the Rumble Wave"

msgid "Gümbür Dalgası: davul dalgası, Titrekler durup dinler"
msgstr "Boom Wave: a drum wave, the Shiverlings stop and listen"

msgid "Gümbür Kanyonu"
msgstr "Rumble Canyon"

msgid "Gümbür Kanyonu artık şarkı yankılıyor"
msgstr "Rumble Canyon echoes with songs now"

msgid "Gümbür Kanyonu ↑"
msgstr "Rumble Canyon ↑"

msgid "Gümbür Kanyonu ↓"
msgstr "Rumble Canyon ↓"

msgid "Gümbür Kanyonu! Her ses bin kez yankılanıyor!"
msgstr "Rumble Canyon! Every sound echoes a thousand times!"

msgid "Gümbür Kanyonu'na doğru gitti. Bado'ya haber vermeli!"
msgstr "He went toward Rumble Canyon. We must tell Bado!"

msgid "Gümbür Kanyonu, çok uzun zaman önce"
msgstr "Rumble Canyon, a long, long time ago"

msgid "Gümbür de gelmiş! Önce onunla konuşayım."
msgstr "Rumble came too! I'll talk to him first."

msgid "Gümbür her akşam davul çalıyor. Ben de dans ediyorum!"
msgstr "Rumble drums every evening. And I dance!"

msgid "Gümbür nefesleniyor! Şimdi vur!"
msgstr "Rumble is catching his breath! Hit now!"

msgid "Gümbür'ün Davul Tezgâhı"
msgstr "Rumble's Drum Stall"

msgid "Gümbür'ün davulu kızınca yankılar büyüdü, büyüdü..."
msgstr "When Rumble's drum got angry, the echoes grew and grew..."

msgid "Gümbür'ün davulu yine çalıyor! Ama bu sefer neşeyle!"
msgstr "Rumble's drum is playing again! Happily this time!"

msgid "Gümüş Fırıldak"
msgstr "Silver Pinwheel"

msgid "Gümüş bir Ay Çiçeği! Dikenler de çiçek oldu."
msgstr "A silver Moonflower! The thorns turned into flowers, too."

msgid "Gümüş madalya!"
msgstr "Silver medal!"

msgid "Gümüş İnci"
msgstr "Silver Pearl"

msgid "Gümüş İnci orada parlıyor. Al onu!"
msgstr "The Silver Pearl is shining over there. Take it!"

msgid "Gümüş İnci! Deniz Feneri'nin dördüncü incisi."
msgstr "The Silver Pearl! The Lighthouse's fourth pearl."

msgid "Gümüş İnci! Fırtına bile ritim tutuyor artık."
msgstr "The Silver Pearl! Even the storm keeps the rhythm now."

msgid "Gümüş İnci'yi al"
msgstr "Take the Silver Pearl"

msgid "Günaydın uykucu! Yuvan seni bekliyor."
msgstr "Good morning, sleepyhead! Your burrow is waiting."

msgid "Günaydın, yeni bekçi! Kıvılcım sana çok yakışmış."
msgstr "Good morning, new keeper! The Spark really suits you."

msgid "Güneyden mavi bir ışık! Bu bizim Fener'in gece ışığı!"
msgstr "A blue light from the south! It's our Lantern's night light!"

msgid "Güneş"
msgstr "Sun"

msgid "Güneş Damlası"
msgstr "Sun Drop"

msgid "Güneş battı ama bu gece kimse uyumuyor. Şşş, bakın!"
msgstr "The sun set but nobody is sleeping tonight. Shh, look!"

msgid "Günlerdir Dırıl'a ışık tutuyorum. Ama bir tohuma yetmiyor."
msgstr "I've been shining on Bramble for days. But it's not enough for a seed."

msgid "Gürledek"
msgstr "Kaboom"

msgid "Gürledek dağıldı"
msgstr "Kaboom drifted away"

msgid "Gürr... gürr... Çok yoruldum..."
msgstr "Rumble... rumble... I'm so tired..."

msgid "Gürültücü Kurbağa"
msgstr "Noisy Frog"

msgid "Gürültücü Kurbağaları sakinleştir"
msgstr "Calm the Noisy Frogs"

msgid "Güzel söyledin. Taşı şimdi Pamuk'a götüreyim."
msgstr "Well said. Now I'll take the stone to Cotton."

msgid "Güzel yarıştı! Madalyan aynı, keyfin yeni."
msgstr "Great race! Same medal, fresh fun."

msgid "Güç"
msgstr "Power"

msgid "Güçlü Vuruş"
msgstr "Strong Hit"

msgid "Gıcık Karga"
msgstr "Cranky Crow"

msgid "Gıdak gıdak! O zaman bir daha! Hem de hemen!"
msgstr "Cluck cluck! Then again! Right now!"

msgid "Gıdak! Yine mi oyun? Ben hep kaybediyorum! Hep!"
msgstr "Cluck! Another game? I always lose! Always!"

msgid "Gıdak... Yine kaybettim. Hep ben kaybediyorum..."
msgstr "Cluck... I lost again. I'm the one who always loses..."

msgid "Ha? Sabah mı oldu? Esnemekten çenem ağrıdı!"
msgstr "Huh? Is it morning? I yawned so much my jaw hurts!"

msgid "Ha? Uyandım! Bu soğuk sis de nereden çıktı?"
msgstr "Huh? I'm awake! Where did this cold mist come from?"

msgid "Hadi Fıstık, kuleye!"
msgstr "Go, Peanut, to the tower!"

msgid "Hadi canım eski dostum, yine yarışırız!"
msgstr "Come on, my old friend, let's race again!"

msgid "Hadi eve dönelim! Fener'in kırmızı rengi bizde."
msgstr "Let's go home! We have the Lantern's red color."

msgid "Hadi incileri yerine koyalım, Mors Dede."
msgstr "Let's put the pearls back, Grandpa Whiskers."

msgid "Hadi kuleye! Yıldızlar seni bekliyor."
msgstr "To the tower! The stars are waiting for you."

msgid "Hadi köye! Çiçek Şenliği'ne Dırıl da geliyor."
msgstr "To the village! Bramble is coming to the Flower Festival, too."

msgid "Hafif Kürek"
msgstr "Light Paddle"

msgid "Hah... hah... Yoruldum. Kimse sormadı bile..."
msgstr "Huff... huff... I'm tired. Nobody even asked..."

msgid "Halat at"
msgstr "Throw rope"

msgid "Halat atma"
msgstr "Rope throw"

msgid "Halka büyür, küçülür. Bitene kadar bırakma, yavrum!"
msgstr "The ring grows, then shrinks. Don't let go till it's done!"

msgid "Halka geliyor: zıpla!"
msgstr "A ring is coming: jump!"

msgid "Halka geliyor: üstünden zıpla!"
msgstr "A ring is coming: jump over it!"

msgid "Halka: zıpla!"
msgstr "Ring: jump!"

msgid "Halkalara dikkat edeyim. Yorulunca alçalır belki."
msgstr "I'll watch the rings. Maybe it sinks when it's tired."

msgid "Halkalardan kaç! Meşale açılınca git ve yak."
msgstr "Dodge the rings! When a torch appears, go and light it."

msgid "Halkalardan kaç, alçalınca vur!"
msgstr "Dodge the rings, hit when it's low!"

msgid "Halkalardan kaç, atılınca kenara çekil. Şıkır yorulunca vur!"
msgstr "Dodge the rings, step aside when thrown. Hit when Jingle is tired!"

msgid "Halkalardan kaç, açılan meşaleyi yak!"
msgstr "Dodge the rings and light the new torch!"

msgid "Halkalardan kaç, oturunca vur!"
msgstr "Dodge the rings, hit when he sits!"

msgid "Halkalardan kaç, soluklanınca vur!"
msgstr "Dodge the rings, then hit when it pauses for breath!"

msgid "Halkalardan kaç, toprağın kabardığı yerden çekil. Yorulunca vur!"
msgstr "Dodge the rings, step away where the ground bulges. Hit when tired!"

msgid "Halkalardan kaç, yorulunca vur!"
msgstr "Dodge the rings, hit when tired!"

msgid "Halkalardan kaç. Bulut alçalınca vur!"
msgstr "Dodge the rings. Hit when the cloud sinks low!"

msgid "Halkalardan kaç. Soluklanınca vur!"
msgstr "Dodge the rings. Hit when it pauses for breath!"

msgid "Halkanın ortasına gir. Sakinleş'e basılı tut: el uzat."
msgstr "Step into the middle of the ring. Hold Breathe: reach out a hand."

msgid "Hangi çana gidelim?"
msgstr "Which bell shall we go to?"

msgid "Haritamda bu sis yok. Ne garip, ne garip!"
msgstr "This mist isn't on my map. How odd, how odd!"

msgid "Haritamda o dağın arkası bomboş. Ne var orada?"
msgstr "Behind that mountain, my map is empty. What's there?"

msgid "Haritamı aldım, gidelim!"
msgstr "Got my map, let's go!"

msgid "Haritana bir güvenli liman çizdin: \"Kaybolursan buraya gel.\""
msgstr "You drew a safe harbor on your map: \"If you get lost, come here.\""

msgid "Haritaya yazdım: Kaybolursan buraya gel."
msgstr "I wrote it on the map: If you get lost, come here."

msgid "Hatırlar! Bak, hepsi sana parlıyor."
msgstr "They will! Look, they're all shining for you."

msgid "Hava kararıyor... Gölge Köşesi'ne gece geliyor!"
msgstr "It's getting dark... Night is coming to Shadow Corner!"

msgid "Havuç Teyze"
msgstr "Auntie Carrot"

msgid "Havuç Teyze ile konuş"
msgstr "Talk to Auntie Carrot"

msgid "Havuç Teyze'nin bahçesi dolu dolu. Benimki yarım kalmış gibi."
msgstr "Auntie Carrot's garden is so full. Mine feels half empty."

msgid "Havuç Teyze'ye gül suyu götüreceğim. Birlikte sevinelim."
msgstr "I'll bring Auntie Carrot some rose water. Let's be happy together."

msgid "Havuçlarımı yarışmaya hazırlıyorum. En turuncusu benim olacak!"
msgstr "I'm getting my carrots ready for the contest. Mine will be the orangest!"

msgid "Hayvanlar kızdı! Mırıl, kızgın kalp vurmakla geçmez."
msgstr "The animals are cross! Mumble, hitting won't fix a cross heart."

msgid "Hayır, ben!"
msgstr "No, me!"

msgid "Hayır, en uzun lale benimki!"
msgstr "No, the tallest tulip is mine!"

msgid "Hazırım! Dostlarım da kayıkta."
msgstr "I'm ready! My friends are in the boat too."

msgid "Hediye"
msgstr "Gift"

msgid "Hem de ilk seferde! El ele her şey daha kolay."
msgstr "And on the first try! Everything is easier hand in hand."

msgid "Henüz yok. Köydeki dükkândan alabilirsin."
msgstr "None yet. You can buy some at the village shop."

msgid "Hep Tombiş'in bilyesine bakardım. Ne parlak!"
msgstr "I always looked at Tombiş's marble. So shiny!"

msgid "Hep dinleyeceğim, Minnoş. Kızsam bile, önce dinlerim."
msgstr "I'll always listen, Cubby. Even when I'm cross, I'll listen first."

msgid "Hep karpuza bakmış. Kendi turuncusunu görememiş."
msgstr "He only looked at the watermelon. He couldn't see his own orange."

msgid "Hep yarıda kesildiği için kaynamış. Bitince serinlemiş."
msgstr "He boiled because he was always cut off. Once finished, he cooled."

msgid "Hepsi aynı anda konuşuyor. Teker teker dinle, yavrum."
msgstr "They all talk at once. Listen one at a time, dear."

msgid "Hepsi bu muydu? Minicik bir yengeç!"
msgstr "Was that all? A teeny tiny crab!"

msgid "Hepsi tamam!"
msgstr "All done!"

msgid "Hepsini aldım ama hiçbirine doya doya bakmadım."
msgstr "I took them all but never really looked at any of them."

msgid "Hepsini buldun! Ortadaki Işık Kabuğu'na gel."
msgstr "You found them all! Come to the Light Shell in the middle."

msgid "Hepsini yaptın! Bekle, yüzerek yanına geliyorum."
msgstr "You did it all! Wait, I'm swimming over to you."

msgid "Her adada bir Işık Parçası: Minnoş'un lambası için"
msgstr "One Light Shard on every isle: for Minnow's lamp"

msgid "Her gece Deniz Feneri'ne baktık. Bir gün yanar dedik."
msgstr "Every night we looked at the Lighthouse. We said, one day it will shine."

msgid "Her levhada aynı soru yazıyor: Neden ben değilim?"
msgstr "Every board asks the same question: Why not me?"

msgid "Her sahibin KENDİ oyuncağını alkışla"
msgstr "Clap for each owner's OWN toy"

msgid "Her seferinde arıyorsunuz. Hiç vazgeçmiyorsunuz."
msgstr "You look for me every time. You never give up."

msgid "Her söz bin kez yankılanıyor. Hem de kırıcı sözler."
msgstr "Every word echoes a thousand times. Even the hurtful ones."

msgid "Her tohum kendi zamanında açar."
msgstr "Every seed blooms in its own time."

msgid "Her tohum kendi zamanında açar. Dedem öyle derdi."
msgstr "Every seed blooms in its own time. My grandpa used to say so."

msgid "Her vuruş ileri bir kıvılcım dalgası yollar (+10)"
msgstr "Each hit sends a spark wave forward (+10)"

msgid "Her vuruşta önüne bir ışık yıldızı fırlar (+3)"
msgstr "Each hit shoots a light star ahead (+3)"

msgid "Her yer parlıyor! Mercanlar bile gülüyor!"
msgstr "Everything is glowing! Even the corals are smiling!"

msgid "Her yol aynı görünüyor. Davulun çaldığı kapıdan geç!"
msgstr "Every path looks the same. Go through the door where the drum is playing!"

msgid "Her yöne ışıklı baloncuklar fırlatır"
msgstr "Throws glowing bubbles all around"

msgid "Her zaman açık"
msgstr "Always open"

msgid "Her çan çalınca posta kutusuna Fıstık'tan bir mektup gelir"
msgstr "Each time a bell rings, a letter from Peanut reaches the mailbox"

msgid "Herkes Aynı Anda Konuşuyor"
msgstr "Everyone Talks at Once"

msgid "Herkes aynı anda konuşuyor. Buhar kulaklarından çıkıyor!"
msgstr "Everyone talks at once. Steam comes out of their ears!"

msgid "Herkes aynı anda vraklıyor, kimse sözünü bitiremiyor."
msgstr "Everyone croaks at once, nobody can finish."

msgid "Herkes bahçesinden bir çiçeği başka birine hediye etsin!"
msgstr "Everyone give a flower from their garden to someone else!"

msgid "Herkes bahçesini süslüyor. Çiçek Yarışması varmış!"
msgstr "Everyone is decorating their garden. There's a Flower Contest!"

msgid "Herkes baksın: atlıyorum! Şap! ...Yüzüyorum!"
msgstr "Everybody watch: I'm jumping! Splash! ...I'm swimming!"

msgid "Herkes bana 'Sonra!' diyor. Sonra ne zaman?"
msgstr "Everyone tells me 'Later!' When is later?"

msgid "Herkes el ele! Halka kuruldu."
msgstr "Everybody hand in hand! The ring is made."

msgid "Herkes geliyor demek. Aferin sana, küçük yıldız."
msgstr "So everyone's coming. Well done, little star."

msgid "Herkes gider zaten! Kimse dinlemez! HIRRR!"
msgstr "Everyone leaves anyway! Nobody listens! GRRR!"

msgid "Herkes güldü! Şimdi kanyon onlara bağırsın! BUM BUM!"
msgstr "Everyone laughed! Now the canyon shouts back! BOOM BOOM!"

msgid "Herkes hatırladı. Hadi, Fıstık pastayı bekliyor!"
msgstr "Everyone remembered. Come on, Peanut is waiting with the cake!"

msgid "Herkes kendi saatinde açar"
msgstr "Everyone blooms in their own hour"

msgid "Herkes keser! Ben de kaynarım! FOKUR!"
msgstr "Everyone cuts in! So I boil! BUBBLE!"

msgid "Herkes komşusunun bahçesine yan yan bakıyor: Onunki daha güzel!"
msgstr "Everyone eyes their neighbor's garden: Theirs is prettier!"

msgid "Herkes konuştu, herkes dinlendi. İşte çember budur."
msgstr "Everyone talked, everyone was heard. That's what a circle is."

msgid "Herkes konuşuyor, kimse dinlemiyor! Hıh!"
msgstr "Everyone talks, nobody listens! Hmph!"

msgid "Herkes onu dinliyor. Minnoş'un hayali buymuş."
msgstr "Everyone is listening to him. That was Cubby's dream."

msgid "Herkes çiçek açtı. Ben hiç açamadım."
msgstr "Everyone bloomed. I never could."

msgid "Herkesi buldun, bütün kabukları açtın!"
msgstr "You found everyone and opened every shell!"

msgid "Herkesi dinledin. Bak, buharları geçti."
msgstr "You listened to everyone. Look, their steam is gone."

msgid "Herkesin Kendi Oyuncağı"
msgstr "Everyone's Own Toy"

msgid "Herkesin kendine ait bir güzelliği var. Göl bunu gösterdi."
msgstr "Everyone has a beauty of their own. The lake showed it."

msgid "Herkesin kendine ait bir güzelliği var. Seninki de bu!"
msgstr "Everyone has a beauty of their own. This one is yours!"

msgid "Herkesin kendine ait bir güzelliği vardır."
msgstr "Everyone has a beauty of their own."

msgid "Herkesin saati ayrı... Peki benimki ne zaman?"
msgstr "Everyone's hour is different... So when is mine?"

msgid "Herkesin önünde denize atladın ve yüzdün. Su o kadar da ıslak değilmiş!"
msgstr "You jumped into the sea in front of everyone and swam. The water isn't that wet after all!"

msgid "Hey! Korkma, sana bir şey yapmam!"
msgstr "Hey! Don't be scared, I won't hurt you!"

msgid "Hi hi hi! Biziz! Çarşafın altında saklanıyorduk."
msgstr "Hee hee hee! It's us! We were hiding under the sheet."

msgid "Hikâye Taşları %d/%d"
msgstr "Story Stones %d/%d"

msgid "Hikâye Taşları: %d/%d"
msgstr "Story Stones: %d/%d"

msgid "Hikâye Taşı"
msgstr "Story Stone"

msgid "Hikâye Taşı %d/%d"
msgstr "Story Stone %d/%d"

msgid "Hiç pasta görmemiştim... Fuuuu!"
msgstr "I've never seen a cake before... Fwoooo!"

msgid "Ho ho! Beş inci de geldi. Bıyıklarım sevinçten titriyor!"
msgstr "Ho ho! All five pearls are here. My whiskers are shaking with joy!"

msgid "Ho ho! Fişek yandı, koy aydınlandı. Bıyıklarım titredi!"
msgstr "Ho ho! The flare is lit, the cove is bright. My whiskers quivered!"

msgid "Ho ho! Yıllardır bu koyu böyle aydınlık görmedim!"
msgstr "Ho ho! I haven't seen this cove so bright in years!"

msgid "Ho! Gökkuşağı Köyü'nün bekçileri! Ben Mors Dede Bıyık."
msgstr "Ho! Guardians of Rainbow Village! I'm Grandpa Whiskers."

msgid "Ho! Misafir! Bahçemize ilk kez bir bekçi geldi."
msgstr "Oh! A guest! A Keeper has come to our garden for the first time."

msgid "Homurdanan Çaydanlık"
msgstr "The Grumbling Kettle"

msgid "Homurdanan Çaydanlık ve ilk Ses Çanı"
msgstr "The Grumbling Kettle and the first Echo Bell"

msgid "Hop! Balonlar beni havaya fırlatıyor!"
msgstr "Whee! The balloons bounce me into the air!"

msgid "Hop! Rüzgâr beni itiyor. Köprü de sallanıyor!"
msgstr "Whoa! The wind is pushing me. And the bridge is swaying!"

msgid "Hop! Yumuşak düştüm. Bir şeyim yok."
msgstr "Hop! I landed softly. I'm fine."

msgid "Hortlak iki yavruymuş demek! Ho ho ho!"
msgstr "So the ghost was two chicks! Ho ho ho!"

msgid "Hortlak Çarşaf"
msgstr "The Spooky Sheet"

msgid "Hortlak Çarşaf ve ilk İşaret Fişeği"
msgstr "The Spooky Sheet and the first Signal Flare"

msgid "Hoş geldin Tırıl! Karadaki ilk baharın bu, tadını çıkar."
msgstr "Welcome, Tremble! This is your first spring on land, enjoy it."

msgid "Hoş geldin bekçi! Dükkânımız açık, bak bakalım."
msgstr "Welcome, keeper! Our shop is open, take a look."

msgid "Hoş geldin bekçi. Buraya kadar çok yol geldin."
msgstr "Welcome, keeper. You've come a long way."

msgid "Hoş geldin canım! Deniz için şık bir şey diktim."
msgstr "Welcome, dear! I sewed something stylish for the sea."

msgid "Hoş geldin denizanası evlat! Karada yüzmek nasıl?"
msgstr "Welcome, little jellyfish! How is swimming on land?"

msgid "Hoş geldin evlat! Ben Solucan Dede Toprak."
msgstr "Welcome, little one! I'm Grandpa Loam the Earthworm."

msgid "Hoş geldin! Ben Anne Serçe. Burası Yuva Ağacı."
msgstr "Welcome! I'm Mama Sparrow. This is Nest Tree."

msgid "Hoş geldin! Ben Bülbül Nihan. Burası Şarkı Çayırı."
msgstr "Welcome! I'm Melody the Nightingale. This is Song Meadow."

msgid "Hoş geldin! Ben Çay Ustası Demlik. Papatya çayım meşhurdur."
msgstr "Welcome! I'm Teapot the Tea Master. My chamomile tea is famous."

msgid "Hoş geldin! Burası Ayna Gölü. Ben bir kuğuyum."
msgstr "Welcome! This is Mirror Lake. I'm a swan."

msgid "Hoş geldin! Renkler dönünce köye dükkân açtım."
msgstr "Welcome! When the colors came back, I opened a shop in the village."

msgid "Hoş geldin, yavrum! Kaplıcayı sevdim, tezgâhımı buraya kurdum."
msgstr "Welcome, dear! I love the hot springs, so I set up my stall here."

msgid "Hoşça kal Anne Serçe! Minikler uçunca haber ver."
msgstr "Bye, Mama Sparrow! Tell us when the little ones fly."

msgid "Hrrm... Önce dağın fenerini yak, bekçi. Çok üşüdüm."
msgstr "Hrrm... Light the mountain's lantern first, keeper. I'm so cold."

msgid "Hrrr... Bal Şurubu... Hrrr..."
msgstr "Hrrr... Honey Syrup... Hrrr..."

msgid "Hrrr... Havuç rüyası görüyordum..."
msgstr "Hrrr... I was dreaming about carrots..."

msgid "Hrrr... Hıh... Bekçi sen misin? Dikenlerin nerede?"
msgstr "Hrrr... Hmph... Is that you, keeper? Where are your spikes?"

msgid "Hu Öğretmen dedi ki: 'Dinlemek de bir şarkıdır.'"
msgstr "Teacher Hoo said: 'Listening is a song too.'"

msgid "Hu-hu! Daha hızlı uçarım!"
msgstr "Hoo-hoo! I can fly faster!"

msgid "Hu-hu! Hoş geldin yeni bekçi. Ben Öğretmen Hu."
msgstr "Hoo-hoo! Welcome, new keeper. I'm Teacher Hoo."

msgid "Hu-hu! Pus herkesin küçük üzüntüsünü büyütüyor demek."
msgstr "Hoo-hoo! So the Gloom makes everyone's little sadness bigger."

msgid "Hu-hu! Önce Orman Feneri'ni yak, bekçi."
msgstr "Hoo-hoo! Light the Forest Lantern first, keeper."

msgid "Hu-hu! Üç yavru da yuvasında. Sen gerçek bir bekçisin!"
msgstr "Hoo-hoo! All three chicks are home. You're a real keeper!"

msgid "Hu-huuu! Bu parlak ışık artık benim!"
msgstr "Hoo-hooo! This bright light is mine now!"

msgid "Hu... hu... Yoruldum. Vurmayın artık..."
msgstr "Hoo... hoo... I'm tired. Please stop hitting..."

msgid "Huuu! Huuuu! Buradan gidin, huuu!"
msgstr "Whooo! Whoooo! Go away from here, whooo!"

msgid "Huuu... Bırak beni, ışığa yaklaşmak istiyorum!"
msgstr "Hooo... Let me go, I want to be near the light!"

msgid "Huysuz Kirpi Topu"
msgstr "Grumpy Hedgeball"

msgid "Huysuz Korkuluk"
msgstr "the Grumpy Scarecrow"

msgid "Huysuz Korkuluk ve tıkalı ark"
msgstr "The Grumpy Scarecrow and the Blocked Ditch"

msgid "Hıh!"
msgstr "Hmph!"

msgid "Hıh! Artık kimse yolunu kaybetmez."
msgstr "Hmph! Now nobody will lose their way."

msgid "Hıh! Bu rüzgâr pastamın kremasını bozdu!"
msgstr "Hmph! This wind ruined my cake's frosting!"

msgid "Hıh! Rozetini kaybetme, bekçi."
msgstr "Hmph! Don't lose your badge, keeper."

msgid "Hıh! Yol arkadaşınız çok. Ben de Fener'i beklerim."
msgstr "Hmph! You have plenty of friends along. I'll watch the Lantern."

msgid "Hıh, duygusallık sonra. Önce davetiyeleri dağıt!"
msgstr "Hmph, feelings later. First, hand out the invitations!"

msgid "Hıh. Bu yol eskiden daha kısaydı."
msgstr "Hmph. This road used to be shorter."

msgid "Hıh. Dikenlerim ışıl ışıl. Demek iyi iş çıkardın."
msgstr "Hmph. My spikes are sparkling. So you did a good job."

msgid "Hıh. Her yıl ben. Tabii ki ben."
msgstr "Hmph. Me every year. Of course me."

msgid "Hıh. Mumları ben diktim. Beş tane, sayarsın."
msgstr "Hmph. I put the candles in myself. Five of them, count them."

msgid "Hıh. O zaman bir bekçi daha var. Kim önden gidiyor?"
msgstr "Hmph. Then we have one more keeper. Who's leading?"

msgid "Hıh... Hrrm... Ne kadar uyumuşum?"
msgstr "Hmph... Hrrm... How long was I asleep?"

msgid "Hıh? Sis beni başa döndürdü."
msgstr "Huh? The mist sent me back to the start."

msgid "Hırr... Yoruldum. Ama içim hâlâ kaynıyor..."
msgstr "Grrr... I'm tired. But I'm still boiling inside..."

msgid "Hırrr! Kimsin sen? Git buradan!"
msgstr "Grrr! Who are you? Go away!"

msgid "Hırıl"
msgstr "Grumble"

msgid "Hırıl davulu sana uzattı: \"Bu sefer ritmi sen tut.\""
msgstr "Grumble held the drum out to you: \"This time, you keep the beat.\""

msgid "Hırıl gitti. Davulu hâlâ kendi kendine çalıyor."
msgstr "Grumble is gone. His drum still plays by itself."

msgid "Hırıl ile konuş"
msgstr "Talk to Grumble"

msgid "Hırıl ile kumsalda ilk ortak davul konserinizi verdiniz."
msgstr "You and Grumble played your first drum concert together on the beach."

msgid "Hırıl ile kırık davulu birlikte tamir ettiniz."
msgstr "You and Grumble fixed the broken drum together."

msgid "Hırıl kendi isteğiyle gitti"
msgstr "Grumble left on his own"

msgid "Hırıl küçükken burada davul çalardı. Ben dinlerdim."
msgstr "When Grumble was little, he drummed here. I listened."

msgid "Hırıl'ı yalnız bırakmadım. Onu dinler misin?"
msgstr "I didn't leave Grumble alone. Will you listen to him?"

msgid "Hırıl'ı yalnız bırakmamak için."
msgstr "So that Grumble wouldn't be alone."

msgid "Hırıl'ın Davulu"
msgstr "Grumble's Drum"

msgid "Hırıl'ın Seçimi"
msgstr "Grumble's Choice"

msgid "Hırıl'ın buharı bitti! Şimdi vur!"
msgstr "Grumble is out of steam! Hit now!"

msgid "Hırıl'ın öfkesi orada başlamış... Ona ulaşmalıyız."
msgstr "That's where Grumble's anger began... We must reach him."

msgid "Hırıl, bir ritim daha! Kuyruğum kendiliğinden sallanıyor."
msgstr "Grumble, one more beat! My tail wags all by itself."

msgid "Hırıl, davulunu çal! J'ye düzenli bas."
msgstr "Grumble, play your drum! Press J steadily."

msgid "Hırıl, dur! O seni dinlemeye geldi!"
msgstr "Grumble, stop! They came to listen to you!"

msgid "Hırıl, hazır mısın? İlk konserimiz: bir, iki, üç!"
msgstr "Grumble, ready? Our first concert: one, two, three!"

msgid "Hırıl... O gün sana 'Sus!' dememeliydim. Özür dilerim."
msgstr "Grumble... I shouldn't have said 'Hush!' that day. I'm sorry."

msgid "Hız"
msgstr "Speed"

msgid "Hıçk... Karanlıkta annemi bulamıyorum."
msgstr "Sniff... I can't find my mom in the dark."

msgid "Hıçk... Kimse beni dinlemedi... Hiç..."
msgstr "Sniff... Nobody ever listened to me... Never..."

msgid "Hıçk... Sis yüzünden yuvamı bulamıyorum."
msgstr "Sniff... I can't find my nest in this mist."

msgid "Hıçk... Sis yüzünden yıldızları göremiyorum."
msgstr "Hic... I can't see the stars because of the fog."

msgid "Hııı! Ben de tam onu düşünüyordum."
msgstr "Hmm! I was just thinking that."

msgid "Hıııı... Bu sis insanın gözünü kapatıyor..."
msgstr "Yaaawn... This mist makes your eyes close..."

msgid "Islak! Soğuk! Ama... hâlâ buradayım!"
msgstr "Wet! Cold! But... I'm still here!"

msgid "Işık"
msgstr "Light"

msgid "Işık Dalgası"
msgstr "Light Wave"

msgid "Işık Dalgası: etrafını kısa süre aydınlatır"
msgstr "Light Wave: lights up around you for a short while"

msgid "Işık Değneği"
msgstr "Light Wand"

msgid "Işık Dönencesi"
msgstr "Light Orbit"

msgid "Işık Kabuğu'na git"
msgstr "Go to the Light Shell"

msgid "Işık Patlaması"
msgstr "Light Burst"

msgid "Işık Patlaması: alan hasarı ve iyileştirme"
msgstr "Light Burst: area hit and healing"

msgid "Işık Sapanı"
msgstr "Light Slingshot"

msgid "Işık Tohumu (10)"
msgstr "Light Seed (10)"

msgid "Işık Tohumu fırlatır: I tuşu / At"
msgstr "Shoots Light Seeds: I key / Throw"

msgid "Işık Tohumun kalmadı. Usta Tıkır'dan alabilirsin"
msgstr "No Light Seeds left. Master Tinker has more"

msgid "Işık bizi çağırıyor."
msgstr "The light is calling us."

msgid "Işık görünce gölge çiti çekildi! Karanlığı sevmiyor demek."
msgstr "Your light made the shadow fence pull back! So it doesn't like the dark."

msgid "Işık mantarlarını yak. Mürekkep ışıktan çekilir."
msgstr "Light the glow mushrooms. Inky backs away from light."

msgid "Işık mantarlarını yakar mısın? Işıkta mürekkep çekilir."
msgstr "Can you light the glow mushrooms? Ink pulls back in the light."

msgid "Işık mantarı yandı! Mürekkep ışıktan kaçıyor."
msgstr "The glow mushroom is lit! The ink is running from the light."

msgid "Işık tek bir yerde durursa, Pus onu yutar."
msgstr "If the light stays in one place, the Gloom swallows it."

msgid "Işık şovumu gördün mü? Senin ritmine göre parlıyorum!"
msgstr "Did you see my light show? I glow to your rhythm!"

msgid "Işık! Çok ışık! Gölgelerim, beni saklayın!"
msgstr "Light! So much light! My shadows, hide me!"

msgid "Işık... Küçücük ama her yeri görebiliyorum!"
msgstr "A light... It's tiny but I can see everywhere!"

msgid "Işık: karanlıkta hep biraz parlar"
msgstr "Light: always glows a little in the dark"

msgid "Işıklar yaklaşıyor. Biri adaları tek tek aydınlatıyor!"
msgstr "The lights are getting closer. Someone is lighting up the isles one by one!"

msgid "Işıklı kapılardan sırayla geç. Yıldızlı kapı sıradaki."
msgstr "Sail through the lit gates in order. The star gate is next."

msgid "Işıklı yoldan yürürsem titremem. Hadi sıradakine!"
msgstr "If I walk on the lit path, I won't tremble. On to the next one!"

msgid "Işıltı"
msgstr "Twinkle"

msgid "Işığı ta denizin öbür ucuna gidiyor!"
msgstr "Its light reaches all the way across the sea!"

msgid "Işığı yutmak istemedi aslında. Sadece ısınmak istedi."
msgstr "He didn't really want to swallow the light. He just wanted to be warm."

msgid "Işığım büyüdü! İçimde yeni bir dalga kıpırdıyor."
msgstr "My light grew! A new wave is stirring inside me."

msgid "Işığım söndü sanıyordum..."
msgstr "I thought my light had gone out..."

msgid "Işığım tek başına yetmedi. Ay gelince yetti!"
msgstr "My light alone wasn't enough. When the moon came, it was!"

msgid "Işığım titriyor. Titreyince etrafım mavi sis oluyor."
msgstr "My light trembles. When it trembles, a blue mist forms around me."

msgid "Işığım titriyor. Ya yine sönerse?"
msgstr "My light is trembling. What if it goes out again?"

msgid "Işığım titriyor... Meşaleleri yak, birlikte parlarız."
msgstr "My light is flickering... Light the torches, we'll glow together."

msgid "Işığım yanımda... Teşekkür ederim."
msgstr "My light is next to me... Thank you."

msgid "Işığım... durdu. Titremiyor!"
msgstr "My light... stopped. It isn't trembling!"

msgid "Işığımla sersemleteyim. Canı yanmaz, sadece durur."
msgstr "Let me make it dizzy with my light. It won't hurt, it will just stop."

msgid "Işığımı ona katıyorum. Bak Dırıl, ay doğuyor!"
msgstr "I'm adding my light to his. Look, Bramble, the moon is rising!"

msgid "Işığın dalga dalga yayılır. Gölge çitleri ışıktan çekilir."
msgstr "Your light spreads in waves. Shadow fences pull back from the light."

msgid "J ile davul çal: düzenli vur, kale dans etsin!"
msgstr "Drum with J: steady beats make the castle dance!"

msgid "J: Dikenciyi sersemlet. Sonra C: yanında alkışla!"
msgstr "J: make the Prickle dizzy. Then C: clap next to it!"

msgid "J: Dikenlerinle vur!"
msgstr "J: Hit with your spikes!"

msgid "J: hafifçe vur. Oturunca yanına git!"
msgstr "J: tap gently. When it sits down, go up close!"

msgid "J: ışığınla vur. Dikenci sersemleyince dur!"
msgstr "J: hit with your light. Stop when the Prickle gets dizzy!"

msgid "K: Top ol, kirişin altından geç!"
msgstr "K: Roll into a ball, go under the beam!"

msgid "Kabarcıklardan kaç, vıraklayınca uzaklaş. Zıplayınca vur!"
msgstr "Dodge the bubbles, step away when he croaks. Hit after he hops!"

msgid "Kabağın yanında dur"
msgstr "Stand next to the pumpkin"

msgid "Kabuk Kalesi"
msgstr "Shell Fort"

msgid "Kabuk Kalkanı"
msgstr "Shell Shield"

msgid "Kabuk Kalkanı: kabuğuna çekilir, hiç hasar almaz"
msgstr "Shell Shield: hide in your shell and take no damage"

msgid "Kabuk Kayık"
msgstr "Shell Boat"

msgid "Kabuk Kayık artık oraya da gider. İskeleye!"
msgstr "The Shell Boat can go there now too. To the dock!"

msgid "Kabuk Kayık nereye gitsin?"
msgstr "Where should the Shell Boat go?"

msgid "Kabuk Kayık rüzgârı yakalar: yarışta daha hızlı gider"
msgstr "The Shell Boat catches the wind: goes faster in the race"

msgid "Kabuk Kayık çabuk döner, çabuk hızlanır"
msgstr "The Shell Boat turns fast and speeds up fast"

msgid "Kabuk Kayık'a bin: Değişen Kumlar'a açıl"
msgstr "Board the Shell Boat: sail to the Shifting Sands"

msgid "Kabuk Kayık'a bin: Fırtına Kayası'na açıl"
msgstr "Board the Shell Boat: sail to Storm Rock"

msgid "Kabuk Kayık'a bin: Kayıp Ada'ya açıl"
msgstr "Board the Shell Boat: sail to Lost Island"

msgid "Kabuk Kayık'a bin: Mürekkep Adası'na açıl"
msgstr "Board the Shell Boat: sail to Ink Island"

msgid "Kabuk Kayık'a bin: Rüzgârlı Kayalıklar'a açıl"
msgstr "Board the Shell Boat: sail to the Windy Cliffs"

msgid "Kabuk Yuvası"
msgstr "Shell Nest"

msgid "Kabuk bir ev değil, bir başlangıç."
msgstr "A shell isn't a home, it's a beginning."

msgid "Kabuklara bak. Her birinde Tırıl'ın bir anısı saklı."
msgstr "Look at the shells. Each one hides a memory of Tremble's."

msgid "Kabukları istediğin kadar aç. Anılar eskimez."
msgstr "Open the shells as often as you like. Memories never get old."

msgid "Kabuğum küçük ama yüreğim kocaman!"
msgstr "My shell is small but my heart is huge!"

msgid "Kademe %d → %d"
msgstr "Rank %d → %d"

msgid "Kalacağım. Ama arkadaşlarım merak etmesin."
msgstr "I'll stay. But my friends shouldn't worry."

msgid "Kalanları da bulayım. Parlayanlar onlar."
msgstr "I'll find the rest. They're the glowing ones."

msgid "Kalbe dokun: Bal Şurubu iç!"
msgstr "Tap the heart: drink Honey Syrup!"

msgid "Kale Feneri yandı! Kıvılcımlarım daha da parladı."
msgstr "The Castle Lantern is lit! My Sparks shine even brighter."

msgid "Kale Feneri'ni yak"
msgstr "Light the Castle Lantern"

msgid "Kale dans ediyor! Ritmi tuttum!"
msgstr "The castle is dancing! I kept the beat!"

msgid "Kaleler dans etti! Arkadaşlarınla konuş."
msgstr "The castles danced! Talk to your friends."

msgid "Kaleler dans etti! Şimdi arkadaşlarınla konuş."
msgstr "The castles danced! Now talk to your friends."

msgid "Kalenin tepesinde Mırıl'a ulaş"
msgstr "Reach Mumble at the top of the castle"

msgid "Kalenin tepesine çık"
msgstr "Climb to the top of the castle"

msgid "Kalkan"
msgstr "Shield"

msgid "Kalkan Yaprağı"
msgstr "Shield Leaf"

msgid "Kalp de bir yuva Bado. Yeni gelen, önce geleni itmez."
msgstr "A heart is a nest too, Bado. A newcomer doesn't push away the one who came first."

msgid "Kalıcı olarak biraz daha hızlı koşarsın"
msgstr "You run a little faster for good"

msgid "Kamp ateşini yak"
msgstr "Light the campfire"

msgid "Kamp ateşini yak, uykulu sisi erit"
msgstr "Light the campfire, melt the sleepy mist"

msgid "Kamp ateşlerini yak, uykulu sisi erit"
msgstr "Light the campfires, melt the sleepy mist"

msgid "Kanalın başına bir köprü tohumu ek"
msgstr "Plant a bridge seed at the start of the channel"

msgid "Kanat çırptıkça fırtına kopuyor. Yorulunca yaklaşırım."
msgstr "Every time she flaps, a storm breaks out. I'll get close when she's tired."

msgid "Kanatlarıyla rüzgâr çıkarıyor. Yorulunca yanına gidelim."
msgstr "He's making wind with his wings. When he's tired, let's go to him."

msgid "Kanyonda kaybolan şeyi bul"
msgstr "Find what was lost in the canyon"

msgid "Kanyondaki alay yankılarını topla"
msgstr "Gather the teasing echoes in the canyon"

msgid "Kanyondan davul sesi gelirmiş, öyle duydum."
msgstr "I heard drums can be heard from the canyon."

msgid "Kanyonun Ses Çanı'nı çal"
msgstr "Ring the canyon's Echo Bell"

msgid "Kanyonun çanını çal"
msgstr "Ring the canyon's bell"

msgid "Kanyonun çanını çal. Gümbür sisin ardında, arenada."
msgstr "Ring the canyon's bell. Rumble is past the mist, in the arena."

msgid "Kapak kalktı! Şimdi vur!"
msgstr "The lid popped! Hit now!"

msgid "Kapalı"
msgstr "Off"

msgid "Kapalı Yuva"
msgstr "Closed Nest"

msgid "Kapanış"
msgstr "Ending"

msgid "Kapat"
msgstr "Close"

msgid "Kapağı aç evlat. Sonra bostandaki huysuza bak."
msgstr "Open the gate, dear. Then go see the grumpy one in the garden."

msgid "Kapağı aç. Sonra yuvadaki Saksağan Şıkır'a bak."
msgstr "Open the gate. Then look at Jingle the Magpie in the nest."

msgid "Kapağı kalktı! Şimdi vur!"
msgstr "Its lid popped up! Hit now!"

msgid "Kapkaç Karga"
msgstr "Snatchy Crow"

msgid "Kaplumbağa"
msgstr "Turtle"

msgid "Kaplumbağa yavrusu"
msgstr "Baby turtle"

msgid "Kaplıca Köyü'nde Tospik Nine'ye sor (çan çalınca)"
msgstr "Ask Granny Shelly in Steamy Springs (once the bell rings)"

msgid "Kaplıca Köyü'nde: taşı sırayla götür"
msgstr "In Steamy Springs: take the stone round in turn"

msgid "Kaplıcanın suyu ılık, yavrum. Bir nefes al."
msgstr "The spring water is warm, dear. Take a breath."

msgid "Kaptan Martı Pırpır"
msgstr "Captain Flutter the Gull"

msgid "Kaptan Martı Pırpır ile konuş"
msgstr "Talk to Captain Flutter"

msgid "Kaptan Pırpır ile konuş"
msgstr "Talk to Captain Flutter"

msgid "Kaptan Pırpır'a dön"
msgstr "Go back to Captain Flutter"

msgid "Kapı %d/%d · %s sn"
msgstr "Gate %d/%d · %s s"

msgid "Kapı henüz çiçek açmadı."
msgstr "The gate hasn't bloomed yet."

msgid "Kapıcı Rakun"
msgstr "Grabby Raccoon"

msgid "Kapıcı Tavşan"
msgstr "Grabby Bunny"

msgid "Kapıdan çıkınca köye dönersin"
msgstr "Go out the door to get back to the village"

msgid "Kapının altından soluk mavi bir ışık sızıyor."
msgstr "A pale blue light is seeping from under the door."

msgid "Kapının yanında biri bekliyor. Önce ona soralım."
msgstr "Someone is waiting by the door. Let's ask them first."

msgid "Kapının yanındaki Anne Serçe ile konuş"
msgstr "Talk to Mama Sparrow by the gate"

msgid "Kapının yanındaki Bülbül Nihan ile konuş"
msgstr "Talk to Melody the Nightingale by the gate"

msgid "Kapının yanındaki Solucan Dede Toprak ile konuş"
msgstr "Talk to Grandpa Loam the Earthworm by the gate"

msgid "Kapının yanındaki Yonca ile konuş"
msgstr "Talk to Clover by the gate"

msgid "Kapının yanındaki arı bize el sallıyor."
msgstr "The bee by the gate is waving at us."

msgid "Kapının yanındaki dede bizi bekliyor gibi."
msgstr "The old fellow by the gate seems to be waiting for us."

msgid "Kapının yanındaki Çiçekçi Vızık ile konuş"
msgstr "Talk to Buzzy the Florist by the gate"

msgid "Kapının önünde durdu ama içeri giremedi. Kimse çağırmadı."
msgstr "It stood at the door but couldn't go in. Nobody invited it."

msgid "Kapıya Kıvılcımını göster"
msgstr "Show your Spark to the door"

msgid "Kar Topu Tavşanı"
msgstr "Snowball Bunny"

msgid "Karadaki ilk baharım! Su balonum sayesinde her yere süzülürüm."
msgstr "My first spring on land! I can glide anywhere with my water bubble."

msgid "Karanlık Tünel'in kristallerini yak"
msgstr "Light the crystals in the Dark Tunnel"

msgid "Karanlık için küçük bir ışık yeter. Bak istersen."
msgstr "A small light is enough for the dark. Take a look if you like."

msgid "Karanlıkta kaybolan minik köstebekleri bul"
msgstr "Find the little moles lost in the dark"

msgid "Karanlıkta küçük bir ışık yeter."
msgstr "A small light is enough in the dark."

msgid "Karanlıkta mantar parlarmış. Bana da bir tane getir."
msgstr "They say mushrooms glow in the dark. Bring me one too!"

msgid "Karanlıkta mantarlar parlıyor. Onlar hiç titremiyor."
msgstr "The mushrooms glow in the dark. They never tremble."

msgid "Karanlıkta yanında bir ışık olsun yeter."
msgstr "It's enough to have a light beside you in the dark."

msgid "Karanlıktan korkunca hortlak olduk. Kimse yaklaşmasın diye."
msgstr "When we got scared of the dark, we turned into a ghost. So nobody would come close."

msgid "Karda uyuyakalan tavşan yavrularını uyandır"
msgstr "Wake the bunnies who fell asleep in the snow"

msgid "Kardeş Kol"
msgstr "Little Sib"

msgid "Kardeşim Minnoş bu gece ışıl ışıl uyuyacak!"
msgstr "My sibling Minnow will sleep all sparkly tonight!"

msgid "Kardeşim Minnoş nerede? Onu bulmam lazım!"
msgstr "Where's my little brother Cubby? I have to find him!"

msgid "Kardeşim batıdaki karanlık köşede. Elini uzat, tutar."
msgstr "My sibling is in the dark corner in the west. Reach out a hand and they'll take it."

msgid "Kardeşim! Seni Pus'tan sonra buldum sonunda!"
msgstr "My brother! I found you at last, after the Gloom!"

msgid "Kardeşinin Atkısı"
msgstr "Little Sibling's Scarf"

msgid "Karga beni korkuttu... yani biraz şaşırttı!"
msgstr "The crow startled me... well, it surprised me a little!"

msgid "Kargalar! Her birinin gagasında parlak bir oyuncak var."
msgstr "Crows! Each one has a shiny toy in its beak."

msgid "Kargalardaki üç oyuncağı sahibine götür"
msgstr "Take the three toys from the crows to their owners"

msgid "Kargayı sersemlet, C ile alkışla. Oyuncağı sahibine götür, tezgâhında alkışla!"
msgstr "Make the crow dizzy, clap with C. Take the toy to its owner, then clap at their stall!"

msgid "Kargayı sersemlet, alkışla. Oyuncağı bırakır."
msgstr "Make the crow dizzy, then clap. It drops the toy."

msgid "Karpuz benden büyük çıktı! Artık bana kimse bakmıyor!"
msgstr "The watermelon is bigger than me! Now nobody looks at me!"

msgid "Karpuz varken bana kim bakar ki... Püf."
msgstr "With a watermelon around, who would look at me... Pff."

msgid "Kart 1: Deniz mi? Dikenlerime tuz doldu. Çok sağ olun."
msgstr "Card 1: The sea? My spikes are full of salt. Thanks a lot!"

msgid "Kart 2: Mürekkep lekesi çıkmıyor. Denedim. Üç kere."
msgstr "Card 2: The ink stain won't come out. I tried. Three times."

msgid "Kart 3: Rüzgâr şapkamı aldı. Şapkam yoktu ama olsun."
msgstr "Card 3: The wind took my hat. I didn't have a hat, but still."

msgid "Kart 4: Kum her yerde. Yatağımda bile. Kim getirdi?"
msgstr "Card 4: Sand is everywhere. Even in my bed. Who brought it?"

msgid "Kart 5: Gök gürleyince dikenlerim kabardı. Soğuktan!"
msgstr "Card 5: When the thunder rumbled, my spikes puffed up. From the cold!"

msgid "Kart 6: Kaybolan bulunur. Ben de bir kere kaybolmuştum."
msgstr "Card 6: Whatever gets lost can be found. I got lost once too."

msgid "Karşıya atlayamam... ama süzülebilirim!"
msgstr "I can't jump that far... but I can float!"

msgid "Karşıya halat lazım. %s atabilirdi!"
msgstr "You need a rope to get across. %s could throw one!"

msgid "Kasabada dolaş"
msgstr "Wander around town"

msgid "Kasabanın ark kapağını aç"
msgstr "Open the town's sluice gate"

msgid "Kavanozum hep yanımda. Mürekkebimle artık tılsım yapıyorum!"
msgstr "My jar is always with me. Now I make charms with my ink!"

msgid "Kaya altlarındaki beş meşaleyi yak"
msgstr "Light the five torches under the rocks"

msgid "Kaya altına şimşek düşmez. Meşaleler de orada."
msgstr "Lightning doesn't strike under a rock. The torches are there too."

msgid "Kaya ve kütük itme"
msgstr "Push rocks and logs"

msgid "Kayada bir resim: Minnoş bağırıyor, sesi yankı oluyor."
msgstr "A drawing on the rock: Cubby shouting, his voice echoing."

msgid "Kayalıklar ↑"
msgstr "Cliffs ↑"

msgid "Kayalıklara çık"
msgstr "Climb up to the cliffs"

msgid "Kayalıklara çık!"
msgstr "Climb up to the cliffs!"

msgid "Kayalıkların İşaret Fişeği'ni yak"
msgstr "Light the Cliffs' Signal Flare"

msgid "Kayalığın ucuna yürü"
msgstr "Walk to the edge of the cliff"

msgid "Kayalığın üstünde... kocaman bir gölge var!"
msgstr "On top of the cliff... there's a huge shadow!"

msgid "Kayan Kumlar"
msgstr "Sliding Sands"

msgid "Kayan Taş Kaplumbağası"
msgstr "Rolling Rock Turtle"

msgid "Kayayı it"
msgstr "Push rock"

msgid "Kaybetmek ayıp değil. Bir daha denemek cesaret ister!"
msgstr "Losing is nothing to be ashamed of. Trying again takes courage!"

msgid "Kaybetmek de oyunun parçası. Önemli olan birlikte oynamak."
msgstr "Losing is part of the game. Playing together is what counts."

msgid "Kaybettim... Olsun! Kaybetmek de oyunun parçası."
msgstr "I lost... That's okay! Losing is part of the game."

msgid "Kaybolursak... haritaya işaretleriz!"
msgstr "If we get lost... we'll mark it on the map!"

msgid "Kaydedildi!"
msgstr "Saved!"

msgid "Kaydedilemedi"
msgstr "Could not save"

msgid "Kaydet (Deneme)"
msgstr "Save (Practice)"

msgid "Kaydet (Kayıt %d)"
msgstr "Save (Save %d)"

msgid "Kaynar Balon Balık"
msgstr "Boiling Pufferfish"

msgid "Kaynar Kurbağa Fokur"
msgstr "Burble the Boiling Frog"

msgid "Kaynayan su birikintilerinin arasından geç"
msgstr "Get past the bubbling pools"

msgid "Kayıkta ne kadar dost varsa o kadar hızlı gider. El ele!"
msgstr "The more friends in the boat, the faster it goes. Hand in hand!"

msgid "Kayıp Ada"
msgstr "Lost Island"

msgid "Kayıp Ada'nın İşaret Fişeği'ni yak"
msgstr "Light Lost Island's Signal Flare"

msgid "Kayıp Ada'nın ışığı. Korkusunu tanıdı, ailesine kavuştu."
msgstr "The light of Lost Isle. It got to know its fear and found its family."

msgid "Kayıp Ada... Her yol birbirine benziyor."
msgstr "Lost Island... Every path looks the same."

msgid "Kayıp Denizyıldızı"
msgstr "Lost Starfish"

msgid "Kayıp Fenerler"
msgstr "Lost Lanterns"

msgid "Kayıp Kurbağa Yavrusu"
msgstr "Lost Froglet"

msgid "Kayıp Tavşan Yavrusu"
msgstr "Lost Bunny"

msgid "Kayıp Yavru"
msgstr "Lost Little One"

msgid "Kayıp Yavrular"
msgstr "Lost Chicks"

msgid "Kayıp Ördek Yavrusu"
msgstr "Lost Duckling"

msgid "Kayıt %d"
msgstr "Save %d"

msgid "Kayıtlar"
msgstr "Saves"

msgid "Kayığa bin: Değişen Kumlar"
msgstr "Board the boat: Shifting Sands"

msgid "Kayığa bin: Fırtına Kayası"
msgstr "Board the boat: Storm Rock"

msgid "Kayığa bin: Kayıp Ada"
msgstr "Board the boat: Lost Island"

msgid "Kayığa bin: Mürekkep Adası"
msgstr "Board the boat: Ink Island"

msgid "Kayığa bin: Rüzgârlı Kayalıklar"
msgstr "Board the boat: Windy Cliffs"

msgid "Kayığın ışığı büyür: sis onu yavaşlatamaz"
msgstr "The boat's light grows: the mist can't slow it down"

msgid "Kayığını süslemek istersen sepetim açık."
msgstr "If you'd like to decorate your boat, my basket is open."

msgid "Kazan homurdanıyor. Yorulunca kapağı kalkar, o zaman vur."
msgstr "The kettle grumbles. When it tires, its lid pops: hit then."

msgid "Kazan soğuyor. Yanına git, Sakinleş'e basılı tut!"
msgstr "The kettle is cooling. Go close and hold Breathe!"

msgid "Kazanan en büyük çiçek değil, en çok sevilen bahçe olacak!"
msgstr "The winner won't be the biggest flower, but the most loved garden!"

msgid "Kazandım! Ama kaybetseydim de tekrar denerdim."
msgstr "I won! But if I'd lost, I'd have tried again."

msgid "Kazma Ailesi Dükkânı"
msgstr "The Digby Family Shop"

msgid "Kazma'nın dükkânı açıldı! Köye dönebilirsin"
msgstr "Digby's shop is open! You can go back to the village"

msgid "Kazma'nın Çocukları"
msgstr "Digby's Kids"

msgid "Kazma'nın Örs Tezgâhı"
msgstr "Digby's Anvil Stall"

msgid "Kaç, zıpladıktan sonra vur!"
msgstr "Dodge, then hit after he hops!"

msgid "Kaçmıyorum. Bu sesi tanıyorum."
msgstr "I'm not running away. I know that voice."

msgid "Kaçtı. Ama sanki... çok yalnız görünüyordu."
msgstr "It ran off. But it looked... so lonely."

msgid "Kaçtı... Bu duyguyu tanıyorum. Ben de böyleydim."
msgstr "It ran away... I know that feeling. I was like that too."

msgid "Kaçıyorlar... Sakin bir ritim çalarsam dinlerler mi?"
msgstr "They're running... Will they listen to a calm rhythm?"

msgid "Kaşif Paytak ile konuş"
msgstr "Talk to Waddles the Explorer"

msgid "Kedi"
msgstr "Cat"

msgid "Kehribar Kor"
msgstr "Amber Ember"

msgid "Kehribar Kor! Bal gibi altın sarısı."
msgstr "The Amber Ember! Golden like honey."

msgid "Kehribar Kor'u al"
msgstr "Take the Amber Ember"

msgid "Kenarlardaki taşlara da bak. Biri yukarıda olabilir."
msgstr "Check the rocks by the walls too. One may be up high."

msgid "Kendi kendime konuşuyorum. Cevap veren yok, komik değil."
msgstr "I'm talking to myself. Nobody answers. Not funny."

msgid "Kendi oyuncağını alkışlayınca dikenler çekildi!"
msgstr "When you clapped for its own toy, the thorns pulled back!"

msgid "Kendi oyuncağıyla oynayan yok! Kargalar da hepsini kaptı."
msgstr "Nobody plays with their own toys! And the crows snatched them all."

msgid "Kendi toprağına ilk tohumunu ek"
msgstr "Plant your first seed in your own soil"

msgid "Kerpeten'in Örsü"
msgstr "Pincers's Anvil"

msgid "Keçi Yavrusu Çıngır'a dön"
msgstr "Go back to Jingle the kid goat"

msgid "Keşiş Yengeç Bikbik"
msgstr "Shelby the Hermit Crab"

msgid "Keşiş Yengeç Bikbik'e el uzat"
msgstr "Reach out a hand to Shelby the Hermit Crab"

msgid "Kim dinler bu davulu?"
msgstr "Who listens to that drum?"

msgid "Kim geldi yuvama? Pırpır mı yolladı seni?"
msgstr "Who's at my nest? Did Flutter send you?"

msgid "Kim geldi? Herkes gibi sen de beni soğuk mu buluyorsun?"
msgstr "Who's there? Do you think I'm cold too, like everyone else?"

msgid "Kim konuştu? Sarmaşıkların arasından ince bir ses geldi."
msgstr "Who spoke? A thin voice came from among the vines."

msgid "Kim o? Ormanım kilitli! Kimse giremez!"
msgstr "Who's there? My forest is locked! Nobody comes in!"

msgid "Kim o? Uyuyamıyorum zaten, bir de sen mi geldin?"
msgstr "Who's there? I can't sleep anyway, and now you're here?"

msgid "Kimse bana böyle cevap vermemişti."
msgstr "Nobody ever answered me like that."

msgid "Kimse başını kaldırıp bakmadı. Herkes çok meşguldü."
msgstr "Nobody looked up. Everyone was too busy."

msgid "Kimse beni bulmayacak..."
msgstr "Nobody will ever find me..."

msgid "Kimse beni dinlemiyor! Ağabeyim bile!"
msgstr "Nobody listens to me! Not even my big brother!"

msgid "Kimse beni dinlemiyor... diyen kim? Seni duyuyorum!"
msgstr "Who said nobody listens? I can hear you!"

msgid "Kimse beni görmedi. Şimdi ben de kimseyi görmeyeceğim!"
msgstr "Nobody saw me. Now I won't see anybody either!"

msgid "Kimse dinlemez! HIRRR! Kor benim, kimseye vermem!"
msgstr "Nobody listens! GRRR! The Ember is mine, I won't give it!"

msgid "Kimse fark etmemiş. Minnoş üzülmüş."
msgstr "Nobody noticed. Cubby felt sad."

msgid "Kimse girmeyecek. Anlat."
msgstr "Nobody will cut in. Go on."

msgid "Kimse karanlıkta yalnız kalmaz"
msgstr "Nobody stays alone in the dark"

msgid "Kimse karanlıkta yalnız kalmaz."
msgstr "Nobody is alone in the dark."

msgid "Kimse karanlıkta yalnız kalmaz. Öyle mi?"
msgstr "Nobody stays alone in the dark. Right?"

msgid "Kimse onu fark etmedi. Herkes kendi işindeydi."
msgstr "Nobody noticed it. Everyone was busy with their own things."

msgid "Kimse onu görmezse, kimse onu üzemezdi."
msgstr "If nobody saw it, nobody could make it sad."

msgid "Kimse... beni... dinlemiyor!"
msgstr "Nobody... listens... to me!"

msgid "Kimseye göstermediğin bahçeni herkese açtın. Meğer en güzeli oymuş!"
msgstr "You opened the garden you never showed anyone to everyone. It turned out to be the prettiest!"

msgid "Kirişin altından Tospik Nine'ye ulaş"
msgstr "Reach Granny Shelly under the beam"

msgid "Koca bir cırcır sesi hepsini bastırdı. Sesleri kısıldı."
msgstr "A huge chirping drowned them all out. Their voices went quiet."

msgid "Kocaman Sarılma"
msgstr "Big Hug"

msgid "Kocaman Yürek"
msgstr "Big Heart"

msgid "Kocaman bir ağaç! Her dalında bir yuva evi var."
msgstr "A huge tree! There's a nest house on every branch."

msgid "Kocaman bir bulut! Geçidi kapatıyor."
msgstr "A huge cloud! It's blocking the pass."

msgid "Kolay! Derin bir nefes al, sonra yavaşça üfle."
msgstr "Easy! Take a deep breath, then blow out slowly."

msgid "Kombo"
msgstr "Combo"

msgid "Komik Yüz"
msgstr "Funny Face"

msgid "Komşularla tanış, kendi toprağına da bir tohum ek."
msgstr "Meet the neighbors and plant a seed in your own soil, too."

msgid "Komşunun serasının önünde dur ve alkışla. Dikenler çekilir."
msgstr "Stand in front of a neighbor's greenhouse and clap. The thorns pull back."

msgid "Komşusunun bitkisine gizlice bakıyor: 'Onunki daha güzel!'"
msgstr "He peeks at his neighbor's plant: 'Theirs is prettier!'"

msgid "Komşuya turp götüreceğim. Fazla fazla var."
msgstr "I'm taking radishes to my neighbor. I have way too many."

msgid "Konuş"
msgstr "Talk"

msgid "Konuş'a bas"
msgstr "Press Talk"

msgid "Konuşma Taşı bende değil. Sıramı bekliyorum."
msgstr "I don't have the Talking Stone. I'm waiting my turn."

msgid "Konuşma Taşı'nı Bıdık'a ver"
msgstr "Give the Talking Stone to Bubbles"

msgid "Konuşma Taşı'nı Pamuk'a ver"
msgstr "Give the Talking Stone to Cotton"

msgid "Konuşma Taşı'nı Pıtpıt'a ver"
msgstr "Give the Talking Stone to Puddles"

msgid "Konuşma Taşı'nı Toprak'a ver"
msgstr "Give the Talking Stone to Dusty"

msgid "Konuşma Çemberi"
msgstr "The Talking Circle"

msgid "Kopyalardan ve yankılardan kaç. Yorulunca yaklaş!"
msgstr "Dodge the copies and echoes. Get close when he's tired!"

msgid "Kor"
msgstr "Ember"

msgid "Kor Vadisi · Kıvılcım Bekçileri 2"
msgstr "Ember Valley · Spark Keepers 2"

msgid "Kor Vadisi'nden kaçan bir çocuk. Hırıl'ı küçükken tanıyordu."
msgstr "A kid who ran from Ember Valley. Knew Grumble when they were little."

msgid "Kor Vadisi'ne in"
msgstr "Down to Ember Valley"

msgid "Kor Vadisi'nin davulcusu. Öfkesini ritme çevirdi."
msgstr "The drummer of Ember Valley. He turned his anger into rhythm."

msgid "Kor Vadisi: Kaplıca Köyü"
msgstr "Ember Valley: Steamy Springs Village"

msgid "Kor'u iyi sakla. Fokurdayan Göl seni bekliyor."
msgstr "Keep the Ember safe. Bubbling Lake is waiting for you."

msgid "Korkan biri kovalanmaz. Önce sakin bir ritim çal."
msgstr "You don't chase someone who's scared. Play a calm beat first."

msgid "Korkan birini gördün mü? Elini uzat, yeter."
msgstr "Did you see someone scared? Just reach out a hand."

msgid "Korkan iki köylüyü el ele ateşe getir"
msgstr "Hand in hand, bring the two scared villagers to the fire"

msgid "Korkanları kovalamam. Önce ateşi yakalım!"
msgstr "I won't chase the scared ones. Let's light the fire first!"

msgid "Korkma! Yuva şu tarafta, peşimden gel."
msgstr "It's okay! The nest is this way, follow me."

msgid "Korksam bile geliyorum."
msgstr "I'm coming, even if I'm scared."

msgid "Korksam bile."
msgstr "Even if I'm scared."

msgid "Korku Gölgesi"
msgstr "Fear Shadow"

msgid "Korkular gölgeleri gibi: olduğundan büyük görünür."
msgstr "Fears are like shadows: they look bigger than they are."

msgid "Korkun bitmedi belki. Ama artık yalnız değilsin."
msgstr "Maybe your fear isn't gone. But you're not alone anymore."

msgid "Korkunca saklanmak olur. Ama gelin, ateş sıcak."
msgstr "It's okay to hide when you're scared. But come, the fire is warm."

msgid "Korkuyor. Yanına git, Sakinleş'e basılı tut: el uzat."
msgstr "It's scared. Go next to it, hold Breathe: reach out a hand."

msgid "Korsan Martı"
msgstr "Pirate Gull"

msgid "Korsan Martı %d Pırıl kaptı!"
msgstr "A Pirate Gull grabbed %d Glim!"

msgid "Kovalama! J ile düzenli davul çal: durup dinlerler."
msgstr "Don't chase! Drum steadily with J: they stop and listen."

msgid "Kovalama! Vur'a düzenli bas."
msgstr "Don't chase! Press Hit steadily."

msgid "Kovalamayayım. Yanına oturup birlikte nefes alayım."
msgstr "I won't chase him. I'll sit beside him and breathe together."

msgid "Koya dön"
msgstr "Back to the Cove"

msgid "Koyda dolaş"
msgstr "Look around the cove"

msgid "Koyun İşaret Fişeği'ni yak"
msgstr "Light the cove's Signal Flare"

msgid "Kozacık'ın İpek Sandığı"
msgstr "Cocoon's Silk Chest"

msgid "Kral esniyor! Şimdi vur!"
msgstr "The King is yawning! Hit now!"

msgid "Kristal Tılsım"
msgstr "Crystal Charm"

msgid "Kristal Yengeç Kıskaç"
msgstr "Pinch the Crystal Crab"

msgid "Kristal Yengeç Kıskaç'la yüzleş"
msgstr "Face Pinch the Crystal Crab"

msgid "Kristallere vur, çocukları bul. Anlaştık!"
msgstr "Hit the crystals, find the kids. Deal!"

msgid "Kucaklama Kalkanı"
msgstr "Hug Shield"

msgid "Kucaklama Kalkanı: hasarı emer, dostları korur"
msgstr "Hug Shield: soaks up hits, guards friends"

msgid "Kulak Bekçileri"
msgstr "Keepers Who Listen"

msgid "Kulaklarım ağrıdı!"
msgstr "My ears hurt!"

msgid "Kulaklarım dikildi! Gürültüden uyuyamıyorum!"
msgstr "My ears stand up! I can't sleep in this noise!"

msgid "Kulağım çınladı! Ama dur... Ritmi hiç şaşmıyor."
msgstr "My ears are ringing! But wait... His beat never slips."

msgid "Kule'ye Koşu"
msgstr "Race to the Tower"

msgid "Kulenin yolundaki huysuzları sakinleştir!"
msgstr "Calm the grumpy ones on the tower road!"

msgid "Kulenin yolunu aç. Ben çocuklara göz kulak olurum."
msgstr "Clear the way to the tower. I'll keep an eye on the kids."

msgid "Kulenin çatısına çık"
msgstr "Climb to the tower roof"

msgid "Kuleye giden yolu aç"
msgstr "Clear the road to the tower"

msgid "Kum tepesi kaydı! Bir geçit kapandı, öbürü açıldı."
msgstr "The dune slid! One gap closed, another opened."

msgid "Kum tepesi yürüyünce bekle. Bir geçit kapanır, biri açılır."
msgstr "When a dune walks, wait. One gap closes, another opens."

msgid "Kum İncisi"
msgstr "Sand Pearl"

msgid "Kum İncisi! Avucumda güneşli kum gibi sıcacık."
msgstr "The Sand Pearl! It's warm like sunny sand in my hand."

msgid "Kum İncisi! Bikbik de yeni evine sığdı. Aferin yavrum!"
msgstr "The Sand Pearl! Shelby fits her new home too. Well done, dear!"

msgid "Kum İncisi'ni al"
msgstr "Take the Sand Pearl"

msgid "Kumda bir resim: Bado ile Minnoş el ele."
msgstr "A drawing in the sand: Bado and Cubby paw in paw."

msgid "Kumda bir şişe! İçinde rulo yapılmış bir kâğıt var."
msgstr "A bottle in the sand! There's a rolled-up paper inside."

msgid "Kumdan Hortlak"
msgstr "Sand Spook"

msgid "Kumlar yine yürüyor ama artık yol aydınlık, yavrum."
msgstr "The sands are walking again, but now the path is bright, dear."

msgid "Kumlar yürür! Oka bak."
msgstr "The sands walk! Follow the arrow."

msgid "Kumlar yürüyor... Benim kabuğum en azından yerinde duruyor."
msgstr "The sands are walking... At least my shell stays put."

msgid "Kumlar yürüyünce yolu şaşırdık. Elimizi tuttun, teşekkürler!"
msgstr "When the sands walked, we lost our way. You held our hands, thank you!"

msgid "Kumların arasında altı meşale yak"
msgstr "Light six torches among the sands"

msgid "Kumların kuzeyindeki İşaret Fişeği'ni yak"
msgstr "Light the Signal Flare north of the sands"

msgid "Kumsalda Davul Gecesi"
msgstr "Drum Night on the Beach"

msgid "Kumsalda ilk yaz gecesi! Bu gece müzikçi benim."
msgstr "First summer night on the beach! Tonight I'm the musician."

msgid "Kumsaldaki üç meşaleyi yak"
msgstr "Light the three torches on the beach"

msgid "Kumsalın haritasını çizdim. Kaleleri de ekledim!"
msgstr "I drew a map of the beach. I added the castles too!"

msgid "Kumsalın müzikçisi geldi! Kaleler davul bekliyor."
msgstr "The beach musician is here! The castles want a drum."

msgid "Kurbağa"
msgstr "Frog"

msgid "Kurbağa Vırvır"
msgstr "Vırvır the Frog"

msgid "Kurbağa bağırıyor, sinek 'şşşt' diyor! Kimse kimseyi dinlemiyor."
msgstr "The frog is shouting and the fly says \"shh\"! Nobody listens to anybody."

msgid "Kurbağa kalın söyler, ben ince. İkisi yan yana pek hoş!"
msgstr "Frogs sing low and I sing high. Side by side they sound lovely!"

msgid "Kurbağalar hâlâ bağırıyor. Onları da dinlerim!"
msgstr "The frogs are still shouting. I'll listen to them too!"

msgid "Kurbağalar yoğun sisin içinde. Orada sen de kızarsın!"
msgstr "The frogs are in the thick mist. In there, you'll get cross too!"

msgid "Kurbağanın durduğu yaprak yolu sağlam demek."
msgstr "The leaf the frog is standing on must be a safe path."

msgid "Kuyruğum kabardı... Bu rüzgâr hiç hoş değil!"
msgstr "My tail is all puffed up... I don't like this wind!"

msgid "Kuzey kıyıdaki Kuğu ile konuş"
msgstr "Talk to the Swan on the north shore"

msgid "Kuzey kıyıdaki ark kapağının çarkını çevir"
msgstr "Turn the wheel of the sluice gate on the north shore"

msgid "Kuzey kıyıya yüzen Kuğu ile konuş"
msgstr "Talk to the Swan who swam to the north shore"

msgid "Kuzeyde hâlâ gürlüyor. Tombik bağırdıkça büyüyor."
msgstr "It's still thundering in the north. The more Chubby shouts, the bigger it gets."

msgid "Kuzeyde, taraçanın dibindeki toprağa merdiven tohumu ek"
msgstr "Plant a ladder seed in the soil at the foot of the terrace in the north"

msgid "Kuzeyde, taş köprünün önündeki İşaret Fişeği'ni yak"
msgstr "Light the Signal Flare in the north, in front of the stone bridge"

msgid "Kuzeydeki açıklıkta İşaret Fişeği'ni yak"
msgstr "Light the Signal Flare in the northern clearing"

msgid "Kuzeydeki bostana git"
msgstr "Go to the garden in the north"

msgid "Kuzeydeki bostana git: Huysuz Korkuluk orada"
msgstr "Go to the garden in the north: the Grumpy Scarecrow is there"

msgid "Kuzeydeki büyük sahneye git"
msgstr "Go to the big stage in the north"

msgid "Kuzeydeki büyük sahneye git: Cırcır orada"
msgstr "Go to the big stage in the north: Chirpy is there"

msgid "Kuzeydeki perde açıldı. Bikbik orada olmalı."
msgstr "The veil in the north has opened. Shelby must be there."

msgid "Kuzeydeki sazlığa git"
msgstr "Go to the reeds in the north"

msgid "Kuzeydeki sazlığa git: Paçalı orada"
msgstr "Go to the reeds in the north: Flappy is there"

msgid "Kuzeydeki yuvaya git"
msgstr "Go to the nest in the north"

msgid "Kuzeydeki İşaret Fişeği'ni yak. Sonra ona bir ışık götür."
msgstr "Light the Signal Flare in the north. Then bring him a light."

msgid "Kuzeye yürü: Dırıl ile Tırıl köşenin ortasında"
msgstr "Walk north: Bramble and Tremble are in the middle of the corner"

msgid "Kuzeye yürü: Dırıl ortada"
msgstr "Walk north: Bramble is in the middle"

msgid "Kuzeye, ormanın sönmüş fenerine"
msgstr "North, to the forest's dark lantern"

msgid "Kuğu"
msgstr "Swan"

msgid "Kuğu gölü süzülerek geçti. Ne güzel yüzüyor!"
msgstr "The swan glided across the lake. How nicely she swims!"

msgid "Kuğu ile konuş"
msgstr "Talk to the Swan"

msgid "Kuğu kuzey kıyıya yüzdü: yaprak köprüden geç, onunla konuş"
msgstr "The Swan swam to the north shore: cross the leaf bridge and talk to her"

msgid "Kuğunun beklediği yoldan gidelim."
msgstr "Let's take the path the Swan is waiting on."

msgid "Kuşlar korkuluğun omzunda! Bunu yüz yıldır görmedim."
msgstr "Birds on the scarecrow's shoulders! I haven't seen that in a hundred years."

msgid "Kuşlar omzuma kondu! Gıdıklanıyorum! Hih hih!"
msgstr "Birds landed on my shoulders! It tickles! Hee hee!"

msgid "Kuşları kovalıyor... Yoksa onlar gibi uçmak mı istiyor?"
msgstr "He chases the birds... Or does he just want to fly like them?"

msgid "Kâşif Şapkası"
msgstr "Explorer Hat"

msgid "Kök Amca"
msgstr "Uncle Root"

msgid "Kök Amca ile konuş"
msgstr "Talk to Uncle Root"

msgid "Kök Amca'nın laleleri benimkinden uzun. Hiç adil değil!"
msgstr "Uncle Root's tulips are taller than mine. It's so unfair!"

msgid "Kök Amca'ya bir demet götüreyim. Laleleri de güzelmiş."
msgstr "Let me take Uncle Root a bunch. His tulips are lovely, too."

msgid "Köklerin Peşinde"
msgstr "Following the Roots"

msgid "Köklerin dairelerinden kaç. Halkanın üstünden zıpla!"
msgstr "Stay out of the root circles. Jump over the ring!"

msgid "Köklerin peşinden giderim. Balonum hazır, ışığım da!"
msgstr "I'll follow the roots. My bubble is ready, and so is my light!"

msgid "Köprüden geç, ark kapağını aç"
msgstr "Cross the bridge, open the sluice gate"

msgid "Köprüden geç, kökleri izle"
msgstr "Cross the bridge, follow the roots"

msgid "Köprüden geç: Pamuk'un yuvası"
msgstr "Cross the bridge: Cotton's nest"

msgid "Köprüler sallanıyor, meşaleler söndü, kuşlar titriyor."
msgstr "The bridges are swaying, the torches are out, the birds are trembling."

msgid "Köpüklü Tavuk"
msgstr "Fizzy Hen"

msgid "Köpüklü Tavukları sakinleştir"
msgstr "Calm the Fizzy Hens"

msgid "Köpüklüler! Vur, oturunca Sakinleş."
msgstr "Fizzlers! Hit, then Breathe when they sit."

msgid "Köy sustu... Ama rüzgâr hâlâ dağdan esiyor."
msgstr "The village is quiet... But the wind still blows from the mountain."

msgid "Köyde dolaş"
msgstr "Explore the village"

msgid "Köye dön"
msgstr "Back to the village"

msgid "Köye dön, Tospik Nine'ye müjdeyi ver."
msgstr "Go back to the village and tell Granny Shelly the good news."

msgid "Köye dön: Pus Kalesi'nin yolu açıldı"
msgstr "Back to the village: the way to Gloom Castle is open"

msgid "Köye dönmek için girişteki tabelaya git"
msgstr "Go to the sign by the entrance to go back to the village"

msgid "Köye dönüş tabelası çıktı"
msgstr "A sign home has appeared"

msgid "Köylü"
msgstr "Villager"

msgid "Köyün büyük kazanı da öyle. Kızıl Sis onu kaynattı."
msgstr "The village's big kettle is like that. The Crimson Mist boiled it."

msgid "Köyün büyük kazanını sakinleştir"
msgstr "Calm the village's big kettle"

msgid "Köyün üç meşalesini yak"
msgstr "Light the village's three torches"

msgid "Kükreyen Dağ"
msgstr "Roaring Mountain"

msgid "Kükreyen Dağ ↑"
msgstr "Roaring Mountain ↑"

msgid "Kükreyen Dağ! Yer bile sıcacık, buhar her yerde."
msgstr "Roaring Mountain! Even the ground is warm, steam everywhere."

msgid "Küsen Cırcır'ı alkışla"
msgstr "Clap for the sulking Chirpy"

msgid "Küstü, kendi güzelliğini göremiyor. Yanına git, Alkış'a bas!"
msgstr "It's sulking and can't see its own beauty. Go next to it and press Clap!"

msgid "Küstü. Onu alkışlayayım: kendi güzelliğini görsün."
msgstr "He's sulking. Let me clap for him: so he can see his own beauty."

msgid "Kütük Kral"
msgstr "King Stump"

msgid "Kütük Kral uyandı!"
msgstr "King Stump woke up!"

msgid "Kütük Kral'ı uyandır"
msgstr "Wake up King Stump"

msgid "Kütüklerden tırman, orman kenarına çık"
msgstr "Climb over the logs, get to the edge of the forest"

msgid "Kütüklere zıpla, orman kenarına çık. Boşluk'u bırakma: süzülürsün!"
msgstr "Jump onto the logs, get to the edge of the forest. Don't let go of Space: you'll glide!"

msgid "Kütüklere zıpla. Zıpla'ya basılı tut: süzül!"
msgstr "Jump onto the logs. Hold Jump: glide!"

msgid "Küçük bir Titrek'e ışığını gösterdin: \"Ben de korkmuştum. Bak, geçti.\""
msgstr "You showed your light to a little Shiverling: \"I got scared too. Look, it passed.\""

msgid "Küçük bir fener. Işığı sönmüş ama hâlâ sıcak."
msgstr "A little lantern. Its light is out, but it's still warm."

msgid "Küçük bir ışık ve bir arkadaş... Karanlığa bu yetermiş."
msgstr "A small light and a friend... That's all the dark needs."

msgid "Küçük biri vardı. Her konuşunca ona 'Sus!' dediler."
msgstr "There was a little one. Each time they spoke, they heard 'Shush!'"

msgid "Küçük fenerleri yak"
msgstr "Light the little lanterns"

msgid "Küçük yıldız soğukta bekledikçe üzüntüsü büyüdü."
msgstr "The longer the little star waited in the cold, the bigger its sadness grew."

msgid "Küçük yıldız üşüdü. Işığı yavaş yavaş griye döndü."
msgstr "The little star got cold. Its light slowly turned grey."

msgid "Küçük Şarkıcı"
msgstr "Little Singer"

msgid "Küçüldü! Işık yandıkça gölge küçülüyor."
msgstr "It shrank! The more light shines, the smaller the shadow gets."

msgid "Küçüldü! Sıradaki meşaleyi bekle."
msgstr "It shrank! Wait for the next torch."

msgid "Kı-kıpırdayamıyorum. Her yer karanlık..."
msgstr "I c-can't move. It's dark everywhere..."

msgid "Kıkır kıkır!"
msgstr "Hee hee!"

msgid "Kırk iki nilüfer! Sona kadar saydım, vrak!"
msgstr "Forty-two lily pads! I counted to the end, croak!"

msgid "Kırmızı Rüzgâr"
msgstr "The Red Wind"

msgid "Kırmızı Ufuk"
msgstr "Red Horizon"

msgid "Kırık Davul Tokmağı"
msgstr "Broken Drumstick"

msgid "Kırık ama tamir ederiz. Birlikte çalarız, söz!"
msgstr "It's broken, but we'll fix it. We'll play together, promise!"

msgid "Kırık bir davul tokmağı! Çok eski görünüyor."
msgstr "A broken drumstick! It looks very old."

msgid "Kırık davulu birlikte tamir ettik! Bak, sesi geldi."
msgstr "We fixed the broken drum together! Listen, it sounds again."

msgid "Kıskacı saplandı! Şimdi vur!"
msgstr "His claw is stuck! Hit now!"

msgid "Kıskacı saplanınca vur!"
msgstr "Hit when the claw gets stuck!"

msgid "Kıskacımı tuttun... Kimse tutmamıştı."
msgstr "You held my claw... Nobody ever did."

msgid "Kıskandım ve fırtına oldum. Özür dilerim."
msgstr "I got jealous and became a storm. I'm sorry."

msgid "Kıskandın!"
msgstr "You got jealous!"

msgid "Kıskandın! Birini alkışla, geçer."
msgstr "You got jealous! Clap for someone and it will pass."

msgid "Kıskanç Civciv"
msgstr "Jealous Chick"

msgid "Kıskanç Salyangoz"
msgstr "Jealous Snail"

msgid "Kıskaç dost oldu!"
msgstr "Pinch is a friend now!"

msgid "Kıskaçları dağ gibi! Ama... bu sadece bir gölge."
msgstr "Its claws are huge as mountains! But... it's only a shadow."

msgid "Kıskaçlarım yoruldu... Bu kabuktan başka evim yok ki."
msgstr "My claws are tired... I have no home but this shell."

msgid "Kıskaçtan kaç, yorulunca vur!"
msgstr "Dodge the claw, hit when tired!"

msgid "Kıskaçtan ve kum çukurundan kaç. Bikbik yorulunca vur!"
msgstr "Dodge the claw and the sand pit. Hit when Shelby is tired!"

msgid "Kıvılcım"
msgstr "Spark"

msgid "Kıvılcım %d/5 · %d Pırıl"
msgstr "Spark %d/5 · %d Glim"

msgid "Kıvılcım Bekçileri"
msgstr "Spark Keepers"

msgid "Kıvılcım Kılıcı"
msgstr "Spark Sword"

msgid "Kıvılcım avucunda. Macera başlıyor!"
msgstr "The Spark is in your hands. The adventure begins!"

msgid "Kıvılcım bulundu!"
msgstr "Spark found!"

msgid "Kıvılcım kapılarını aç"
msgstr "Open the Spark gates"

msgid "Kıvılcım uzat"
msgstr "Hold out Spark"

msgid "Kıvılcım'ı gösterdim, Pus kenara çekildi!"
msgstr "I showed the Spark, and the Gloom moved aside!"

msgid "Kıvılcımlar %d/5"
msgstr "Sparks %d/5"

msgid "Kıvılcımlarını Mırıl'a uzat"
msgstr "Hold out your Sparks to Mumble"

msgid "Kıvılcımlarınız köyü korumak için Fener'de kalacak."
msgstr "Your Sparks stay in the Lantern to keep the village safe."

msgid "Kıvılcımı göster"
msgstr "Show the Spark"

msgid "Kıyafet"
msgstr "Outfit"

msgid "Kıyafetler"
msgstr "Outfits"

msgid "Kıyaslayınca elindeki güzellik saklanıyor demek."
msgstr "So when you compare, the beauty in your hands hides."

msgid "Kıyı Yolu"
msgstr "The Shore Path"

msgid "Kıyıdaki Kuğu ile konuş"
msgstr "Talk to the Swan on the shore"

msgid "Kıyıdaki kuğu bize bakıyor. Bir derdi var galiba."
msgstr "The swan on the shore is looking at us. I think she has a problem."

msgid "Kıyıya vuran şişeler: içlerinde Tırıl'ın notları var"
msgstr "Bottles washed up on the shore: they hold Tremble's notes"

msgid "Kızgın değil, yavrum. Korkuyor. Yorulunca elini uzat."
msgstr "She isn't angry, dear. She's scared. Reach out a hand when she's tired."

msgid "Kızgın!"
msgstr "Steamed up!"

msgid "Kızgınsın! Güçlü vurursun ama zor yürürsün. Sakinleş'e bas."
msgstr "You're steamed up! Strong hits, wobbly steps. Press Breathe."

msgid "Kızmadın mı? Sadece... oturdun mu yanımda?"
msgstr "You're not cross? You just... sat beside me?"

msgid "Kızıl Sis geldi geleli kimse kimseyi dinlemiyor."
msgstr "Since the Crimson Mist came, nobody listens to anybody."

msgid "Kızıl Sis geldi, herkes kaybedince küsüyor."
msgstr "The Crimson Mist came, and now everyone sulks when they lose."

msgid "Kızıl Sis geldi, kurbağalarımız birbirinin sözünü kesiyor."
msgstr "The Crimson Mist came, and our frogs keep cutting each other off."

msgid "Kızıl Sis gelince herkes birbirinin eşyasını kapmaya başladı."
msgstr "When the Crimson Mist came, everyone started grabbing each other's things."

msgid "Kızıl Sis'te üşümeyin diye ipliklerimi topladım bile."
msgstr "I've already packed my threads so you stay warm in the Crimson Mist."

msgid "Kızıl Yaprak Ormanı"
msgstr "Redleaf Forest"

msgid "Kızıl Yaprak Ormanı ısındı"
msgstr "Redleaf Forest is warm again"

msgid "Kızıl Yaprak Ormanı ↑"
msgstr "Redleaf Forest ↑"

msgid "Kızıl Yaprak Ormanı ↓"
msgstr "Redleaf Forest ↓"

msgid "Kızıl Yaprak Ormanı! Yapraklar hep sonbaharda kalmış."
msgstr "Redleaf Forest! The leaves are always autumn here."

msgid "Kızıl bir sis perdesi... Önce ormanın çanını çalmalıyım."
msgstr "A red veil of mist... I need to ring the forest's bell first."

msgid "Kızıl panda"
msgstr "Red panda"

msgid "Kızıl rüzgâr seni de kızdırırsa bir tane ye."
msgstr "If the red wind makes you cross too, eat one."

msgid "Kışt! Kışt! Uçabiliyorsunuz diye hava atmayın!"
msgstr "Shoo! Shoo! Don't show off just because you can fly!"

msgid "L: Dikenli Dönüş! Hepsini birden sakinleştir"
msgstr "L: Spiky Spin! Calm them all at once"

msgid "L: Gümbür Dalgası. Çevrendeki bütün Titrekler durup dinler!"
msgstr "L: Rumble Wave. All the Shiverlings around you stop and listen!"

msgid "L: Işık Dalgası. Gölge çitinin önünde kullan!"
msgstr "L: Light Wave. Use it in front of the shadow fence!"

msgid "L: Yıldız Ninnisi! Hepsi birden otursun."
msgstr "L: Star Lullaby! Everyone sits down at once."

msgid "La la laa... Bahar geldi, çiçek açt... Gık!"
msgstr "La la laaa... Spring is here, the flowers bloo... Croak!"

msgid "Lacivert İnci"
msgstr "Navy Pearl"

msgid "Lacivert İnci! Fener'in ilk incisi bizde."
msgstr "The Navy Pearl! We have the Lighthouse's first pearl."

msgid "Lacivert İnci'yi al"
msgstr "Take the Navy Pearl"

msgid "Laf Kesen Ördek"
msgstr "Interrupting Duck"

msgid "Lale Tohumu"
msgstr "Tulip Seed"

msgid "Lale Tohumu! İlk Bahar Tohumu bizde."
msgstr "The Tulip Seed! We have the first Spring Seed."

msgid "Lale Tohumu'nu al"
msgstr "Take the Tulip Seed"

msgid "Lale açtı, gül açtı, herkes açtı! Neden ben değilim?"
msgstr "The tulip bloomed, the rose bloomed, everyone bloomed! Why not me?"

msgid "Lale, papatya, gül, nilüfer, ay çiçeği... Hepsi toprağa!"
msgstr "Tulip, daisy, rose, water lily, moonflower... All in the soil!"

msgid "Lalelerimi cetvelle ölçüyorum. Bir parmak daha uzasınlar!"
msgstr "I'm measuring my tulips with a ruler. One more finger taller, please!"

msgid "Lav Damlacığı"
msgstr "Lava Droplet"

msgid "Lav toplarından kaç. Buharı bitince vur!"
msgstr "Dodge the lava balls. Hit when he's out of steam!"

msgid "Lavdan kaç, buharı bitince vur!"
msgstr "Dodge the lava, hit when out of steam!"

msgid "Liman"
msgstr "Harbor"

msgid "Liman Feneri'ni yak"
msgstr "Light the Harbor Lantern"

msgid "Lumi ile konuş"
msgstr "Talk to Lumi"

msgid "Lumi'ye davetiyesini ver"
msgstr "Give Lumi an invitation"

msgid "Madenci Kazma"
msgstr "Digby the Mole"

msgid "Madenci Kazma ile konuş"
msgstr "Talk to Digby the Mole"

msgid "Mantar uyandı ve çayır yeniden pırıl pırıl!"
msgstr "The mushroom woke up, and the meadow sparkles again!"

msgid "Mantarlar sönük. Ateşin yanında minik biri el sallıyor!"
msgstr "The mushrooms are dark. Someone tiny is waving by the fire!"

msgid "Mantarlar yandı! Kardeşim de ateşin başında. Sağ ol!"
msgstr "The mushrooms are lit! My sibling is by the fire too. Thank you!"

msgid "Martı Civciv"
msgstr "Gull Chick"

msgid "Martı Yavruları"
msgstr "Gull Chicks"

msgid "Martı Yavrusu"
msgstr "Gull Chick"

msgid "Marul Teyze"
msgstr "Auntie Lettuce"

msgid "Marullarım küçük kaldı. Turp Amca'nınkiler kocaman!"
msgstr "My lettuces stayed small. Uncle Radish's are huge!"

msgid "Mavi Fener"
msgstr "Blue Lantern"

msgid "Mavi Kubbe"
msgstr "Blue Dome"

msgid "Mavi Kubbe! Tavanı gökyüzü kadar yüksek. Yankı yapıyor!"
msgstr "The Blue Dome! Its ceiling is as high as the sky. It echoes!"

msgid "Mavi Kıvılcım"
msgstr "Blue Spark"

msgid "Mavi Kıvılcım da geldi! Kazma bana mektup yazdı."
msgstr "The Blue Spark is here too! Digby wrote me a letter."

msgid "Mavi Kıvılcım! İki tane oldu, üç kaldı."
msgstr "The Blue Spark! That makes two, three to go."

msgid "Mavi Titreme"
msgstr "The Blue Shiver"

msgid "Mavi Titreme dağıldı"
msgstr "The Blue Shiver is gone"

msgid "Mavi Titreme geldiğinden beri gece kimse dışarı çıkmıyor."
msgstr "Since the Blue Shiver came, nobody goes out at night."

msgid "Mavi bir sis geliyor. Çok soğuk..."
msgstr "A blue mist is coming. So cold..."

msgid "Mavi fenerim kayboldu... Büyük ağacın altında düşürdüm galiba."
msgstr "I lost my blue lantern... I think I dropped it under the big tree."

msgid "Mavi sis kayığı yavaşlatır. Etrafından dolan!"
msgstr "Blue mist slows the boat. Go around it!"

msgid "Mağara Feneri'ni yak"
msgstr "Light the Cave Lantern"

msgid "Mağara pırıl pırıl! Dükkânımızı açtık, bekleriz!"
msgstr "The cave is sparkling! We opened our shop, come visit!"

msgid "Mağaralar yeniden pırıl pırıl"
msgstr "The caves sparkle again"

msgid "Mağaralara giden tabela meydanda. Kazma seni bekliyor!"
msgstr "The sign to the caves is in the square. Digby is waiting for you!"

msgid "Me-ee! Kanyonda sesler dans ediyor!"
msgstr "Meh-eh! Sounds are dancing in the canyon!"

msgid "Meraklı ve atak. Fıstık'ın çırağı olmak istiyordu."
msgstr "Curious and bold. Wanted to be Peanut's helper."

msgid "Mercan Bahçesi"
msgstr "Coral Garden"

msgid "Mercan Bahçesi ışıl ışıl!"
msgstr "Coral Garden is sparkling!"

msgid "Mercan Kor"
msgstr "Coral Ember"

msgid "Mercan Kor seninle. Patpat Tarlaları'na yol açık!"
msgstr "The Coral Ember is with you. The way to Pop-Pop Fields is open!"

msgid "Mercan Kor! Pembe pembe parlıyor."
msgstr "The Coral Ember! It glows so pink."

msgid "Mercan Kor'u al"
msgstr "Take the Coral Ember"

msgid "Mercan Koyu"
msgstr "Coral Cove"

msgid "Mercan Koyu... Bütün kapılar kilitli."
msgstr "Coral Cove... All the doors are locked."

msgid "Mercan bahçesi... Annem, babam, kardeşlerim. Hep beraberdik."
msgstr "The coral garden... Mom, dad, my siblings. We were always together."

msgid "Mercanları suluyorum. Şaka şaka, zaten suyun altındayız!"
msgstr "I'm watering the corals. Just kidding, we're already underwater!"

msgid "Mercanların arasında saklambaç oynardık. Hiç üşümezdim."
msgstr "We used to play hide and seek among the corals. I was never cold."

msgid "Merdiven tohumu ek, çitin üstünden geç"
msgstr "Plant a ladder seed, cross over the fence"

msgid "Merdivenden yine çıkarım. Bu sefer rüzgârı beklerim."
msgstr "I'll climb the stairs again. This time I'll wait for the wind."

msgid "Merhaba Tırıl! Su balonun ne güzel parlıyor."
msgstr "Hello, Tremble! Your water bubble is shining so nicely."

msgid "Merhaba yine! Ormanda tezgâh açtım, sonbahar pelerini dikiyorum."
msgstr "Hello again! I opened a stall in the forest. I sew autumn capes."

msgid "Merhaba! Ben Fıstık. Pırıltı Diyarı'ndan yazıyorum."
msgstr "Hello! It's Peanut. I'm writing from Glimmerland."

msgid "Merhaba! Ben Terzi Dikiş. Pelerin, şapka, ne istersen."
msgstr "Hello! I'm Stitch the Tailor. Capes, hats, whatever you like."

msgid "Mesaj Şişeleri"
msgstr "Message Bottles"

msgid "Meydandaki Tospik Nine ile konuş"
msgstr "Talk to Granny Shelly in the square"

msgid "Meydandaki Tospik Nine'ye git"
msgstr "Go to Granny Shelly in the square"

msgid "Meydandaki büyük kazana git"
msgstr "Go to the big kettle in the square"

msgid "Meğer Kıvılcım'ı koruyormuş"
msgstr "He was guarding the Spark all along"

msgid "Meğer sadece bir sarılma istiyormuş"
msgstr "All he wanted was a hug"

msgid "Meşale açıldı! Git ve yak."
msgstr "A torch appeared! Go and light it."

msgid "Meşaleler yandı, köylüler ateşin başında. Aferin!"
msgstr "The torches are lit, the villagers are by the fire. Well done!"

msgid "Meşaleler yandı, yıldızlar havuzunda. Ellerine sağlık!"
msgstr "The torches are lit, the stars are in the pool. Great job!"

msgid "Meşalelere git, Yak'a bas."
msgstr "Go to the torches, press Light."

msgid "Meşaleleri yak, Titrekleri sakinleştir, yıldızları getir."
msgstr "Light the torches, calm the Shiverlings, bring the starfish."

msgid "Meşaleleri yak, yoldan git."
msgstr "Light the torches and follow the path."

msgid "Meşaleleri yaka yaka tırman. Işık olan yer güvenli."
msgstr "Climb up lighting the torches. Where there is light, it's safe."

msgid "Minicik Kazma"
msgstr "Tiny Digby"

msgid "Minicik Martı"
msgstr "Tiny Gull"

msgid "Minik"
msgstr "Tiny"

msgid "Minik Gök Gürültüsü Bulutu"
msgstr "Little Thundercloud"

msgid "Minik Kazma"
msgstr "Little Digby"

msgid "Minik Kol"
msgstr "Little Arm"

msgid "Minik Kol ile konuş"
msgstr "Talk to Little Arm"

msgid "Minik Kol'a dön"
msgstr "Go back to Little Arm"

msgid "Minik Kol'un istediklerini bitireyim."
msgstr "Let me finish what Little Arm asked for."

msgid "Minik Kol'un kardeşini el ele ateşe getir"
msgstr "Hand in hand, bring Little Arm's sibling to the fire"

msgid "Minik Martı"
msgstr "Little Gull"

msgid "Minik Miğfer"
msgstr "Tiny Helmet"

msgid "Minik Uykucu"
msgstr "Tiny Sleepyhead"

msgid "Minik pati izleri! Bir de tebeşirle çizilmiş bir resim."
msgstr "Tiny paw prints! And a drawing in chalk."

msgid "Minik'e bez bebeğini geri ver"
msgstr "Give Tiny the rag doll back"

msgid "Minik'in Bez Bebeği"
msgstr "Tiny's Rag Doll"

msgid "Minnoş"
msgstr "Cubby"

msgid "Minnoş da bir şey söylemek istemiş."
msgstr "Cubby wanted to say something too."

msgid "Minnoş da buraya kaçtı. Bir köşede tek başına oturuyor."
msgstr "Cubby ran up here too. He's sitting alone in a corner."

msgid "Minnoş da böyle mi hissediyordu?"
msgstr "Is that how Cubby felt?"

msgid "Minnoş da geliyor... değil mi?"
msgstr "Cubby's coming too... right?"

msgid "Minnoş davulu çok sevdi. Bak, ayağıyla tempo tutuyor!"
msgstr "Cubby loves the drum. Look, he's tapping his foot!"

msgid "Minnoş dağa doğru koştu. Kükreyen Dağ'a! Acele et!"
msgstr "Cubby ran toward the mountain. Roaring Mountain! Hurry!"

msgid "Minnoş doğunca herkes onu kucakladı. Ben kenarda kaldım sandım."
msgstr "When Cubby was born, everyone hugged him. I thought I was left out."

msgid "Minnoş ile bir bahçe kurdunuz. Onun çiçeği daha büyük çıktı; ilk sen alkışladın."
msgstr "You built a garden with Cubby. His flower came out bigger; you were the first to clap."

msgid "Minnoş ilk kez gece lambasız uyudu. Sen yanındaydın."
msgstr "Cubby slept without a night-light for the first time. You were right there."

msgid "Minnoş ilk kez söyledi: \"Beni dinlediğin için teşekkürler, ağabey.\""
msgstr "For the first time Cubby said: \"Thanks for listening to me, big brother.\""

msgid "Minnoş koluma sarıldı. Sis onu da ürküttü."
msgstr "Cubby is hugging my arm. The mist scared him too."

msgid "Minnoş uyudu. Gece lambası yok, elim yanında."
msgstr "Cubby is asleep. No night-light, just my hand close by."

msgid "Minnoş'a söyleyeceğim: karanlıkta da yalnız değilsin."
msgstr "I'll tell Minnow: you're not alone in the dark either."

msgid "Minnoş'u buldun! Kovalamadan, yanına oturarak. Aferin."
msgstr "You found Cubby! Not by chasing, by sitting beside him. Well done."

msgid "Minnoş'u kovalama. Yanına git, Sakinleş'e basılı tut."
msgstr "Don't chase Cubby. Go to him and hold Breathe."

msgid "Minnoş'un Gece Lambası"
msgstr "Minnow's Night Lamp"

msgid "Minnoş'un bütün resimlerini buldum!"
msgstr "I found all of Cubby's drawings!"

msgid "Minnoş'un gece lambasına tam uyar. Toplayalım!"
msgstr "It fits Minnow's night lamp perfectly. Let's collect it!"

msgid "Minnoş'un resimleri bunlar. Hepsini bulalım!"
msgstr "These are Cubby's drawings. Let's find them all!"

msgid "Minnoş'un yanına otur, birlikte nefes al"
msgstr "Sit beside Cubby and breathe together"

msgid "Minnoş'un yol boyunca bıraktığı resimler"
msgstr "Drawings Cubby left along the way"

msgid "Minnoş'un çiçeği benimkinden büyük çıktı. İlk ben alkışlıyorum!"
msgstr "Cubby's flower came out bigger than mine. I'm the first to clap!"

msgid "Minnoş'un İzleri"
msgstr "Cubby's Trail"

msgid "Minnoş, dur! Bado seni arıyor!"
msgstr "Cubby, wait! Bado is looking for you!"

msgid "Minnoş, elimi tut. Ben burdayım."
msgstr "Cubby, hold my hand. I'm right here."

msgid "Minnoş, sen burada kal. ...Hayır, gel. Gel tamam mı?"
msgstr "Minnow, you stay here. ...No, come along. Come with us, okay?"

msgid "Miyav miyav! Gümüş madalya! Martılar bile geride kaldı."
msgstr "Meow meow! Silver medal! Even the seagulls were left behind."

msgid "Miyav! Altın madalyalı kaptan gelmiş. Bıyığım kıvrıldı!"
msgstr "Meow! The captain with the gold medal is here. My whiskers curled!"

msgid "Miyav! Fişek yandı, deniz açıldı. Kayık hazır!"
msgstr "Meow! The flare is lit, the sea is open. The boat is ready!"

msgid "Miyav! Gece Regatası'na hoş geldin, kaptan!"
msgstr "Meow! Welcome to the Night Regatta, captain!"

msgid "Miyav! Kayık hazır, deniz pırıl pırıl. Yarışalım mı?"
msgstr "Meow! The boat is ready, the sea is sparkling. Shall we race?"

msgid "Miyav! Mavi siste kayık kaplumbağa gibi gider."
msgstr "Meow! In the blue mist the boat moves like a turtle."

msgid "Miyav! Yine mi yarış? Balıklar bile seni alkışlıyor."
msgstr "Meow! Another race? Even the fish are clapping for you."

msgid "Miyav... Sis kalkmadan kayık iskeleden çıkmaz."
msgstr "Meow... The boat won't leave the pier until the mist lifts."

msgid "Mola"
msgstr "Pause"

msgid "Mor Kıvılcım"
msgstr "Purple Spark"

msgid "Mor Kıvılcım'ı al"
msgstr "Take the Purple Spark"

msgid "Mors Dede Bıyık"
msgstr "Grandpa Whiskers"

msgid "Mors Dede Bıyık ve kapısını kilitleyen köylüler"
msgstr "Grandpa Whiskers the Walrus and the villagers who locked his door"

msgid "Mors Dede'nin Fener Dolabı"
msgstr "Grandpa Whiskers's Lantern Cabinet"

msgid "Mors Dede'ye dön"
msgstr "Go back to Grandpa Whiskers"

msgid "Mrrr..."
msgstr "Purrr..."

msgid "Mumlar seni bekliyor, doğum günü yıldızı!"
msgstr "The candles are waiting for you, birthday star!"

msgid "Mürekkebe basma, halkalardan kaç. Mürekkep yorulunca vur!"
msgstr "Don't step in the ink, dodge the rings. Hit when Inky is tired!"

msgid "Mürekkebe basınca insan buz gibi titriyor. Brr!"
msgstr "Step in the ink and you shiver like ice. Brr!"

msgid "Mürekkebim bitti... Artık saklanamam. Çok karanlık..."
msgstr "I'm out of ink... I can't hide anymore. It's so dark..."

msgid "Mürekkep Adası"
msgstr "Ink Island"

msgid "Mürekkep Adası... Burası gece gibi kapkara."
msgstr "Ink Island... It's pitch black here, like night."

msgid "Mürekkep Tılsımı"
msgstr "Ink Charm"

msgid "Mürekkep amca artık saklanmıyor! Ada ilk kez aydınlık."
msgstr "Uncle Inky isn't hiding anymore! The island is bright for the first time."

msgid "Mürekkep amca gülümsüyor! Kavanozu çok sevdi."
msgstr "Uncle Inky is smiling! He loved the jar."

msgid "Mürekkep amca kuzeyde. Lütfen kızma ona, sadece korkuyor."
msgstr "Uncle Inky is in the north. Please don't be mad at him, he's just scared."

msgid "Mürekkep amcanın tılsımlarına baktın mı?"
msgstr "Did you look at Uncle Inky's charms?"

msgid "Mürekkep püskürtür ama kötü değil. Sadece çok korkuyor."
msgstr "He sprays ink but he isn't bad. He's just very scared."

msgid "Mürekkep yorulunca ona el uzat"
msgstr "Reach out a hand to Inky when he's tired"

msgid "Mürekkep'e Bir Işık"
msgstr "A Light for Inky"

msgid "Mürekkep'in Tılsım Hokkası"
msgstr "Inky's Charm Inkwell"

msgid "Mürekkep'in hediyesi: kalıcı +20 can"
msgstr "Inky's gift: +20 HP for good"

msgid "Mürekkepten kaç, yorulunca vur!"
msgstr "Dodge the ink, hit when tired!"

msgid "Müzik sesi"
msgstr "Music volume"

msgid "Müzik: %s"
msgstr "Music: %s"

msgid "Mırla"
msgstr "Purr"

msgid "Mırlama"
msgstr "Purring"

msgid "Mırıl"
msgstr "Mumble"

msgid "Mırıl bir gün köye yaklaştı. Şenlikte herkes gülüyordu."
msgstr "One day Mumble came close to the village. Everyone at the festival was laughing."

msgid "Mırıl bir kale yaptı. İçine bütün anılarını sakladı."
msgstr "Mumble built a castle. He kept all his memories inside."

msgid "Mırıl hiç gitmedi. Bağırdım ama yanımda oturdu."
msgstr "Mumble never left. I shouted, but he sat by me."

msgid "Mırıl ile konuş"
msgstr "Talk to Mumble"

msgid "Mırıl kendi isteğiyle gitti"
msgstr "Mumble chose to go"

msgid "Mırıl orada bekliyor. Kalbini açık tut, bekçi."
msgstr "Mumble is waiting there. Keep your heart open, keeper."

msgid "Mırıl ve Hırıl birlikte Pırıltı Diyarı'na dönüyor."
msgstr "Mumble and Grumble head back to Glimmerland together."

msgid "Mırıl yoruldu. Yaklaş!"
msgstr "Mumble is tired. Go closer!"

msgid "Mırıl yoruldu. Şimdi yaklaş!"
msgstr "Mumble is tired. Go closer now!"

msgid "Mırıl! Bugün senin günün, biliyor muydun?"
msgstr "Mumble! Today is your day, did you know?"

msgid "Mırıl'ın Seçimi"
msgstr "Mumble's Choice"

msgid "Mırıl'ın anılarını bul"
msgstr "Find Mumble's memories"

msgid "Mırıl'ın İlk Doğum Günü"
msgstr "Mumble's First Birthday"

msgid "Mırıl'ın ışık izini takip edin. Kulaklarınız açık olsun!"
msgstr "Follow Mumble's trail of light. Keep your ears open!"

msgid "Mırıl'ın ışık şovu ne güzel! Gökyüzü yanıp sönüyor."
msgstr "Mumble's light show is lovely! The sky twinkles."

msgid "Mırıl, Hırıl ve ben... Artık üç arkadaşız!"
msgstr "Mumble, Grumble and me... We're three friends now!"

msgid "Mırıl, Hırıl ve sen: artık üç arkadaşsınız."
msgstr "Mumble, Grumble and you: three friends now."

msgid "Mırıl, artık en yakın arkadaşımsın."
msgstr "Mumble, you're my best friend now."

msgid "Mırıl, bu pasta senin. Bir dilek tut ve üfle!"
msgstr "Mumble, this cake is for you. Make a wish and blow!"

msgid "Mırıl, bu ses... Rüzgârın içinde biri ağlıyor sanki."
msgstr "Mumble, that sound... It's like someone is crying in the wind."

msgid "Mırıl, geliyoruz."
msgstr "Mumble, we're coming."

msgid "Mırıl, gördün mü? Kızgın kalpler bile nefesle yumuşar."
msgstr "See, Mumble? Even cross hearts soften with a breath."

msgid "Mısır halkalarından ve koşusundan kaç. Oturunca vur!"
msgstr "Dodge the corn rings and her dash. Hit when she sits!"

msgid "Nadir tohum, taze bal! Vızır vızır taze. Bak istersen."
msgstr "Rare seeds, fresh honey! Buzzing fresh. Take a look, if you like."

msgid "Nane Limonata"
msgstr "Mint Lemonade"

msgid "Nane Şekeri"
msgstr "Mint Drop"

msgid "Ne dersin?"
msgstr "What do you say?"

msgid "Ne gürültü! Sus artık!"
msgstr "What a racket! Stop it!"

msgid "Ne güzel bir bahçe! Hep buradaymış da biz görmemişiz."
msgstr "What a beautiful garden! It was here all along and we never saw it."

msgid "Ne sakin bir göl! Ama üstü sarmaşık dolu."
msgstr "What a calm lake! But it's covered with vines."

msgid "Ne zaman geleceğini bilince o kadar ürkütmüyor, değil mi?"
msgstr "When you know when it's coming, it's not so scary, right?"

msgid "Ne zaman gürleyecek, bilmiyorum... Çok yoruldum."
msgstr "I don't know when it will thunder... I'm so tired."

msgid "Ne çok hızlı ne çok yavaş. Düzenli vur, yavrum."
msgstr "Not too fast, not too slow. Steady beats, dear."

msgid "Neden ben değilim?"
msgstr "Why not me?"

msgid "Neden hâlâ buradasın? Neden gitmiyorsun?"
msgstr "Why are you still here? Why don't you leave?"

msgid "Neden-Ben-Değilim Gölgesi"
msgstr "Why-Not-Me Shadow"

msgid "Nefes"
msgstr "Breathe"

msgid "Nefes al..."
msgstr "Breathe in..."

msgid "Nefes ver..."
msgstr "Breathe out..."

msgid "Nefesinden kaç, halkada zıpla, yumruklar saplanınca vur!"
msgstr "Dodge the breath, jump the ring, hit when fists get stuck!"

msgid "Nefesleniyor! Şimdi vur!"
msgstr "He's resting! Hit now!"

msgid "Nereye gidelim?"
msgstr "Where shall we go?"

msgid "Nereye uçalım?"
msgstr "Where shall we fly?"

msgid "Nereye yürüyemiyorsun Pati?"
msgstr "Where can't you walk, Paws?"

msgid "Nihan da geldi. Onunla konuşalım."
msgstr "Melody came too. Let's talk to her."

msgid "Nihan da geliyor. Birlikte bir deneyin: o söylesin, sen tut!"
msgstr "Melody is coming too. Try together: she sings, you keep the beat!"

msgid "Nihan söyleyince herkes susup dinliyor. Benimki sadece cır cır."
msgstr "When Melody sings, everyone hushes and listens. Mine is just chirp chirp."

msgid "Nihan'ın Nota Sepeti"
msgstr "Melody's Note Basket"

msgid "Nilüfer Abla"
msgstr "Sister Lily"

msgid "Nilüfer Abla ile konuş"
msgstr "Talk to Sister Lily"

msgid "Nilüfer Tohumu"
msgstr "Water Lily Seed"

msgid "Nilüfer Tohumu! Dördüncü Bahar Tohumu bizde."
msgstr "The Water Lily Seed! We have the fourth Spring Seed."

msgid "Nilüfer Tohumu'nu al"
msgstr "Take the Water Lily Seed"

msgid "Nilüfer yapraklarını saymak istiyordum. Kırk iki tane!"
msgstr "I wanted to count the lily pads. Forty-two of them!"

msgid "Nilüfer'in gülleri mis kokuyor. Benim lalelerim kokmuyor!"
msgstr "Lily's roses smell so sweet. My tulips don't smell at all!"

msgid "Nilüferlerden adaya geç, Fokur'u dinle"
msgstr "Hop to the island, listen to Burble"

msgid "Nine'yi duymadılar. İçimde tuhaf bir his var..."
msgstr "They didn't hear Granny. I have a funny feeling inside..."

msgid "Nine... Kimse dinlemiyor. Herkes çiçeğini ölçüyor."
msgstr "Granny... Nobody listens. Everyone is measuring their flowers."

msgid "Ninemin yanındayım. Çağırırsan gelirim, korksam bile!"
msgstr "I'm with my granny. If you call, I'll come, even if I'm scared!"

msgid "Ninni"
msgstr "Lullaby"

msgid "Ninni Işığı"
msgstr "Lullaby Light"

msgid "Ninni'ye bas: hepsi birden otursun!"
msgstr "Press Lullaby: everyone sits down!"

msgid "O benim elimi tutmuştu. Şimdi sıra bizde!"
msgstr "She held my hand once. Now it's our turn!"

msgid "O da hep bekledi. Sadece iyi saklanıyordu."
msgstr "He was waiting all along. He was just hiding really well."

msgid "O gece Mırıl bir şey fark etti: Kıvılcım'ın ışığı sıcaktı."
msgstr "That night Mumble noticed something: the Spark's light was warm."

msgid "O gece fırtına çıktı. Çocuk bir daha hiç gelemedi."
msgstr "That night a storm came. The child never came again."

msgid "O gece hiç titremedim. Çünkü elimi tutuyordu."
msgstr "I didn't tremble at all that night. Because someone was holding my hand."

msgid "O gece köyde kimse uyumadı."
msgstr "Nobody in the village slept that night."

msgid "O gri üzüntü Pus oldu. Yıldızın adı Mırıl'dı."
msgstr "That grey sadness became the Gloom. The star's name was Mumble."

msgid "O küçük biri kim? Onu da bulacağım."
msgstr "Who is that little one? I'll find them too."

msgid "O küçük, kızgın çocuk... Hırıl. Onu tanıyorum."
msgstr "That little cross kid... Grumble. I know them."

msgid "O kırmızı sis... Gözümü ondan ayırmıyorum."
msgstr "That red mist... I'm keeping my eye on it."

msgid "O sesin peşinden git. Ama dikkatli ol, yavrum."
msgstr "Follow that voice. But be careful, little one."

msgid "O sesin peşinden git. Davulun yolunu bulur."
msgstr "Follow that voice. Your drum will find the way."

msgid "O tokmak da ne? Üstünde bir kıvılcım izi var."
msgstr "What's that drumstick? It has a spark mark on it."

msgid "O tokmak... Onu nereden buldun? Bu Hırıl'ın tokmağı!"
msgstr "That drumstick... Where did you find it? It's Grumble's!"

msgid "O zaman benimle kal! Hep kal! Bırakmam seni!"
msgstr "Then stay with me! Stay forever! I won't let you go!"

msgid "O zaman derin bir nefes alıyorum. İşe yarıyor!"
msgstr "Then I take a deep breath. It works!"

msgid "O zaman... bu mor ışık hepimizin olsun."
msgstr "Then... let this purple light belong to all of us."

msgid "O ışıklar... Onlar... annem! Babam!"
msgstr "Those lights... They're... my mum! My dad!"

msgid "Of, sıcak su! Kıyıya döndüm. Nilüferlerden gideyim."
msgstr "Ow, hot water! Back to the shore. I'll use the lily pads."

msgid "Oh, serinledin!"
msgstr "Ahh, all cooled down!"

msgid "Oh, ısındın!"
msgstr "Ah, you're warm again!"

msgid "Oh... Derin bir nefes, titreme geçti."
msgstr "Ahh... A deep breath, the shivers are gone."

msgid "Oh... Sakinleştin."
msgstr "Ahh... You calmed down."

msgid "Oklar rüzgârın yönünü gösterir. Bir kayanın dibine saklan!"
msgstr "Arrows show which way the wind blows. Hide behind a rock!"

msgid "Oku"
msgstr "Read"

msgid "Olta'nın Kayık Sepeti"
msgstr "Olta's Boat Basket"

msgid "Olta'nın Yolluk Sepeti"
msgstr "Fishhook's Snack Basket"

msgid "Ona cevap ver. Kızma, susturma. Sadece dinle."
msgstr "Answer him. Don't get cross, don't hush him. Just listen."

msgid "Ona en güzel deniz kabuğunu götüreceğim!"
msgstr "I'll bring him the prettiest seashell!"

msgid "Ona gidip özür diledim. 'Seninle çalmak isterim' dedim."
msgstr "I went and said sorry. I said 'I'd love to play with you.'"

msgid "Ona kızma. Belki o da dinlenmek istiyordur."
msgstr "Don't be cross with him. Maybe he wants to be heard too."

msgid "Ona tek alkış yetmiyor. Önce bir bahçe görmesi lazım."
msgstr "One clap isn't enough for him. He needs to see a garden first."

msgid "Onlara ritim lazım! Yanlarında düzenli vur, şarkı geri gelir."
msgstr "They need a beat! Hit steadily beside them, and the song comes back."

msgid "Onları sırayla dinle: önce en yaşlı, en son en küçük."
msgstr "Listen to them in turn: oldest first, smallest last."

msgid "Onu alkışlayayım: kendi havucu da güzel, görsün!"
msgstr "Let me clap for him: his own carrot is lovely too, let him see!"

msgid "Onu yak ki sis çekilsin, şimşekler denize gitsin."
msgstr "Light it so the mist lifts and the lightning goes to the sea."

msgid "Onu yak, sis çekilsin. Sonra Mürekkep amcaya gideriz."
msgstr "Light it and the mist will lift. Then we'll go to Uncle Inky."

msgid "Onun yeteneği benimkini azaltmadı. İkimiz birlikte daha güzeliz."
msgstr "His talent didn't make mine smaller. We're prettier together."

msgid "Onunki Daha Güzel"
msgstr "Theirs Is Prettier"

msgid "Onunki daha güzel..."
msgstr "His is prettier..."

msgid "Onunki daha güzel... neden ben değilim?"
msgstr "His is prettier... why not me?"

msgid "Orada Pamuk var. Koca bir albatros yavrusu."
msgstr "Cotton is there. A big albatross chick."

msgid "Orman Feneri'ne git ve yak"
msgstr "Go to the Forest Lantern and light it"

msgid "Orman Feneri'ne git, Yak'a bas"
msgstr "Go to the Forest Lantern, press Light"

msgid "Orman Feneri'ni yak"
msgstr "Light the Forest Lantern"

msgid "Orman kenarına çık"
msgstr "Get to the edge of the forest"

msgid "Orman yeniden yeşil! Kütük Kral bile gülümsüyor."
msgstr "The forest is green again! Even King Stump is smiling."

msgid "Ormanda kaybolan yavruları bul"
msgstr "Find the chicks lost in the forest"

msgid "Ormanda yapraklar kızıl mı? Burada hepsi sarı."
msgstr "Are the forest leaves red? Here they're all yellow."

msgid "Ormanın Ses Çanı'nı çal"
msgstr "Ring the forest's Echo Bell"

msgid "Ormanın çanını çal"
msgstr "Ring the forest's bell"

msgid "Ormanın çanını çal. Sis perdesi açılınca onu dinle."
msgstr "Ring the forest's bell. When the veil opens, listen to him."

msgid "Ortadaki Işık Kabuğu'na gel"
msgstr "Come to the Light Shell in the middle"

msgid "Ortadaki Işık Kabuğu'na gel. Ailem seni bekliyor."
msgstr "Come to the Light Shell in the middle. My family is waiting for you."

msgid "Ortak Ritim"
msgstr "Shared Beat"

msgid "Ortaya gir, Sakinleş'e basılı tut!"
msgstr "Step into the middle, hold Breathe!"

msgid "Oturdu! Şimdi vur!"
msgstr "He sat down! Hit now!"

msgid "Oturdu, yıldızlar dönüyor! Şimdi yanına gideyim."
msgstr "It sat down, stars are spinning! Now I'll go up close."

msgid "Oyna"
msgstr "Play"

msgid "Oynadığın için teşekkürler! · Just A Game Studios"
msgstr "Thanks for playing! · Just A Game Studios"

msgid "Oyun kaydedilemedi. Telefonda yer var mı?"
msgstr "Couldn't save the game. Is there space on the phone?"

msgid "Oyun kendiliğinden de kaydedilir. · %d FPS"
msgstr "The game also saves by itself. · %d FPS"

msgid "Oyuncak teknem battı. İçinde ailemin resmi vardı."
msgstr "My toy boat sank. It had a picture of my family inside."

msgid "Oyuncaklar sahiplerine döndü! Yavrular gülüyor."
msgstr "The toys are back with their owners! The little ones are laughing."

msgid "Oyuncakları sahiplerine götürür müsün? Bir de alkış lazım!"
msgstr "Will you take the toys to their owners? And we need a clap, too!"

msgid "Oyuncakları, şapkası, haritası... Ama kale hep sessizdi."
msgstr "His toys, his hat, his map... But the castle was always quiet."

msgid "Oyuncağı aldım! Kimin tezgâhından gitmişti acaba?"
msgstr "I got the toy! Whose stall did it go missing from?"

msgid "Oyuncağı sahibine götür, tezgâhında Alkış'a bas!"
msgstr "Take the toy to its owner, press Clap at their stall!"

msgid "Oyuncağı sahibine götür. Sonra tezgâhının önünde alkışla!"
msgstr "Take the toy to its owner. Then clap in front of their stall!"

msgid "Pamuk"
msgstr "Cotton"

msgid "Pamuk ilk kez süzüldü: el ele."
msgstr "Cotton glided for the first time: hand in hand."

msgid "Pamuk kızgın değil. Sadece aşağı bakmaya korkuyor."
msgstr "Cotton isn't angry. She's just scared to look down."

msgid "Pamuk'u dinle"
msgstr "Listen to Cotton"

msgid "Panayır açık! Patpat da oynuyor, kaybedince bile gülüyor!"
msgstr "The fair is open! Popper plays too, and laughs even when she loses!"

msgid "Panayır kapalı! Kimse oynamasın! GIDAAK!"
msgstr "The fair is closed! Nobody plays! CLUUUCK!"

msgid "Panayır nasıl? Pırpır mutlaka balon satıyordur!"
msgstr "How's the fair? I bet Flutter is selling balloons!"

msgid "Panayır şurada. Kaptan Pırpır'ı bulayım."
msgstr "The fair is over there. Let me find Captain Flutter."

msgid "Panayırı Aç"
msgstr "Open the Fair"

msgid "Panayırım bomboş! Oyunlarımı kimse oynamıyor."
msgstr "My fair is empty! Nobody plays my games."

msgid "Papatya Tohumu"
msgstr "Daisy Seed"

msgid "Papatya Tohumu cebimde. Şarkınız da kulağımda!"
msgstr "I have the Daisy Seed in my pocket. And your song in my ears!"

msgid "Papatya Tohumu sahnenin ortasında parlıyor. Al onu!"
msgstr "The Daisy Seed is shining in the middle of the stage. Take it!"

msgid "Papatya Tohumu! İçinden hâlâ şarkı sesi geliyor."
msgstr "The Daisy Seed! I can still hear singing inside it."

msgid "Papatya Tohumu'nu al"
msgstr "Take the Daisy Seed"

msgid "Papatya Çayı"
msgstr "Chamomile Tea"

msgid "Papatya Çelengi"
msgstr "Daisy Chain"

msgid "Parlak Pazar"
msgstr "Shiny Market"

msgid "Parlak Salon'un kristallerini yak"
msgstr "Light the crystals in the Shiny Hall"

msgid "Parlayan sözlere git. Her biri onu bir adım sakinleştirir."
msgstr "Go to the glowing words. Each one calms him a little more."

msgid "Parlayan sözlere git. Her birini Hırıl'a geri götür."
msgstr "Go to the glowing words. Take each one back to Grumble."

msgid "Parlayan yazıları bul. Minnoş da buralarda bir yerde."
msgstr "Find the glowing writing. Cubby is around here somewhere too."

msgid "Pasta mı? Ben ilk gelirim! Sonra ikinci kez gelirim!"
msgstr "Cake? I'll come first! Then I'll come again!"

msgid "Pastanın en çilekli yeri benim, haberin olsun!"
msgstr "The most strawberry bit of the cake is mine, just so you know!"

msgid "Pastanın yanında Fıstık'a dön"
msgstr "Go back to Peanut by the cake"

msgid "Pati"
msgstr "Paws"

msgid "Pati ile konuş"
msgstr "Talk to Paws"

msgid "Pati üç adada kıyıda duruyor. Yanında dur, acele etme"
msgstr "Paws waits on the shore at three isles. Stay beside him, don't rush"

msgid "Pati! Bu senin davetiyen. Bu akşam pasta var!"
msgstr "Paws! This is your invitation. There's cake tonight!"

msgid "Pati'nin Sırrı"
msgstr "Paws's Secret"

msgid "Pati'ye davetiyesini ver"
msgstr "Give Paws an invitation"

msgid "Pati, al bu kalkanı. Artık çırak değil, şövalyesin!"
msgstr "Paws, take this shield. You're a knight now, not an apprentice!"

msgid "Pati, yarından itibaren benim çırağımsın. Hıh!"
msgstr "Paws, from tomorrow you're my helper. Hmph!"

msgid "Patlayan Mısır Tanesi"
msgstr "Popping Kernel"

msgid "Patpat Tarlaları"
msgstr "Pop-Pop Fields"

msgid "Patpat Tarlaları ↑"
msgstr "Pop-Pop Fields ↑"

msgid "Patpat Tarlaları ↓"
msgstr "Pop-Pop Fields ↓"

msgid "Patpat Tarlaları! Mısırlar sıcakta patlıyor!"
msgstr "Pop-Pop Fields! The corn pops in the heat!"

msgid "Patpat Tarlaları'nda panayır yeniden açıldı"
msgstr "The fair at Pop-Pop Fields is open again"

msgid "Patpat bir daha oynamak mı istedi? Ahoy! Harika!"
msgstr "Popper wants to play again? Ahoy! Wonderful!"

msgid "Patpat oturdu, soluk soluğa! Şimdi vur!"
msgstr "Popper sat down, out of breath! Hit now!"

msgid "Patpat panayır meydanında. Önce tarlaların çanını çal."
msgstr "Popper is in the fair square. Ring the fields' bell first."

msgid "Paylaşmak güzel. Ama önce sormak gerek, değil mi?"
msgstr "Sharing is lovely. But first you ask, right?"

msgid "Paylaşınca kazanılır: diken barını boşaltır"
msgstr "Won by sharing: empties the Thorn Meter"

msgid "Paytak"
msgstr "Waddle"

msgid "Paytak da geliyor. Fişek tam burada duruyor."
msgstr "Waddles is coming too. The flare is right here."

msgid "Paytak ile ortak bir harita çizdik. İki imza yan yana!"
msgstr "Waddles and I drew a map together. Two signatures side by side!"

msgid "Paytak ile ortak bir harita çizdiniz. İki imza yan yana!"
msgstr "You and Waddles drew a map together. Two signatures side by side!"

msgid "Paytak'a uçurtmasını geri ver"
msgstr "Give Waddle the kite back"

msgid "Paytak'ın Kaşif Çantası"
msgstr "Waddles's Explorer Bag"

msgid "Paytak'ın Uçurtması"
msgstr "Waddle's Kite"

msgid "Pazarım açıldı! Gemiye uğra, nadir şeylerim var."
msgstr "My market is open! Stop by the ship, I have rare things."

msgid "Pazarın ark kapağını aç"
msgstr "Open the market's sluice gate"

msgid "Paçalı"
msgstr "Flappy"

msgid "Paçalı gölü sarmaşıkla örttü. Bizi görmek istemiyor."
msgstr "Flappy covered the lake with vines. She doesn't want to see us."

msgid "Paçalı gülüyor! Tohum parlıyor, hadi al onu."
msgstr "Flappy is laughing! The seed is shining, go take it."

msgid "Paçalı kuzeyde, sazlıkta. Suya hiç bakmıyor."
msgstr "Flappy is in the north, in the reeds. She doesn't look at the water at all."

msgid "Pembe Fener"
msgstr "Pink Lantern"

msgid "Pembe Sarmal"
msgstr "Pink Swirl"

msgid "Pembe Sarmal! İçi deniz gibi uğulduyor. Sığdım, sığdım!"
msgstr "The Pink Swirl! It hums inside like the sea. It fits, it fits!"

msgid "Pembe bir bulut! Pamuk gibi... Üstüne iniyor."
msgstr "A pink cloud! Fluffy like cotton... It's coming down on me."

msgid "Pembe fenerim kayboldu... Kuyunun oralarda düşürdüm galiba."
msgstr "I lost my pink lantern... I think I dropped it by the well."

msgid "Pençe Kombosu"
msgstr "Paw Combo"

msgid "Pençe Kombosu: üçlü hızlı vuruş"
msgstr "Paw Combo: three quick hits"

msgid "Perde açıldı. Bikbik kuzeyde, eski kabuğunda sıkışmış."
msgstr "The veil is open. Shelby is in the north, stuck in her old shell."

msgid "Perde açıldı. Yuva, ikinci köprünün öbür ucunda."
msgstr "The veil is open. The nest is at the far end of the second bridge."

msgid "Perdeler Açılsın"
msgstr "Open the Curtains"

msgid "Perdeler açıldı! Komşular yine selamlaşıyor."
msgstr "The curtains are open! The neighbors are saying hello again."

msgid "Pikeden sonra vur!"
msgstr "Hit after the dive!"

msgid "Pof! Yumuşak düştüm. Merdiven yerinde, yine çıkarım."
msgstr "Poof! I landed softly. The ladder is still there, I'll climb again."

msgid "Pofu"
msgstr "Puffy"

msgid "Pofu'nun Topu"
msgstr "Puffy's Ball"

msgid "Pofu'ya topunu geri ver"
msgstr "Give Puffy the ball back"

msgid "Ponpon zil çalsın, ben döndüreyim. Pazara şenlik gelsin!"
msgstr "Ponpon rings the bell and I'll spin. Let's bring a party to the market!"

msgid "Posta kutusu boş. Çan çalınca mektup gelir."
msgstr "The mailbox is empty. A letter comes when the bell rings."

msgid "Prolog bitti! Macera daha yeni başlıyor."
msgstr "The prologue is over! The adventure is just beginning."

msgid "Prolog tamamlandı!"
msgstr "Prologue complete!"

msgid "Prolog · Sahne 1"
msgstr "Prologue · Scene 1"

msgid "Prolog · Sahne 2"
msgstr "Prologue · Scene 2"

msgid "Prolog · Sahne 3"
msgstr "Prologue · Scene 3"

msgid "Prolog · Sahne 4"
msgstr "Prologue · Scene 4"

msgid "Prolog · Sahne 5"
msgstr "Prologue · Scene 5"

msgid "Prolog · Sahne 6"
msgstr "Prologue · Scene 6"

msgid "Prologda Mırıl'ı sen oynuyorsun: süzül, ışık saç!"
msgstr "In the prologue you play Mumble: float and shine!"

msgid "Pruva Feneri"
msgstr "Bow Lantern"

msgid "Puf... Kanatlarım yoruldu. Ama içim hâlâ pır pır..."
msgstr "Phew... My wings are tired. But my heart is still fluttering..."

msgid "Pus Baykuşu"
msgstr "Gloom Owl"

msgid "Pus Baykuşu dağıldı"
msgstr "The Gloom Owl faded away"

msgid "Pus Kalesi"
msgstr "Gloom Castle"

msgid "Pus Kalesi'nin tabelası meydanda. Hazır olunca git!"
msgstr "The sign to Gloom Castle is in the square. Go when you're ready!"

msgid "Pus Kalesi... Burası çok gri ve çok sessiz."
msgstr "Gloom Castle... It's so grey and so quiet here."

msgid "Pus Kovucu"
msgstr "Gloom-Away"

msgid "Pus bana sürekli yalnız olduğumu fısıldadı."
msgstr "The Gloom kept whispering that I was all alone."

msgid "Pus dağıldı. Mırıl artık yalnız değil"
msgstr "The Gloom is gone. Mumble isn't alone anymore"

msgid "Pus geri çekilmiyor... Kuleye tırmanıyor!"
msgstr "The Gloom isn't going back... It's climbing the tower!"

msgid "Pus kristallerimizi griye boyadı, mağara karardı."
msgstr "The Gloom turned our crystals grey, and the cave went dark."

msgid "Pus limanı fırtınaya boğdu. Eski rakibim Rüzgâr çıldırdı!"
msgstr "The Gloom filled the harbor with storms. My old rival Gale went wild!"

msgid "Pus'un vuruşları %30 daha az acıtır"
msgstr "The Gloom's hits hurt 30% less"

msgid "Puslu Sümüklü"
msgstr "Gloomy Slug"

msgid "Puslu Sümüklüleri sakinleştir"
msgstr "Calm the Gloomy Slugs"

msgid "Pırpır bir gölge görmüş... İki parlak gözlü."
msgstr "Flutter saw a shadow... with two shiny eyes."

msgid "Pırpır seni arıyor! Gemiye uç bakalım."
msgstr "Flutter is looking for you! Fly to the ship."

msgid "Pırpır'ın Nadir Pazarı"
msgstr "Flutter's Rare Market"

msgid "Pırpır'ın Panayır Pazarı"
msgstr "Flutter's Fair Market"

msgid "Pırpır'ın pazarı açıldı! Gemiyle limana dön"
msgstr "Flutter's market is open! Fly back to the harbor"

msgid "Pırpır: %s! Tutun sıkı!"
msgstr "Flutter: %s! Hold on tight!"

msgid "Pırıl Kesesi"
msgstr "Glim Pouch"

msgid "Pırıl yetmiyor"
msgstr "Not enough Glim"

msgid "Pırıltı Diyarı"
msgstr "Glimmerland"

msgid "Pırıltı Diyarı · Kıvılcım Bekçileri"
msgstr "Glimmerland · Spark Keepers"

msgid "Pırıltı Diyarı'nın Feneri geceleri mavi bir gece lambası: korkan herkes için."
msgstr "Glimmerland's Lighthouse is a blue night-light at night: for everyone who feels scared."

msgid "Pırıltı Diyarı: Gökkuşağı Köyü"
msgstr "Glimmerland: Rainbow Village"

msgid "Pıtpıt"
msgstr "Puddles"

msgid "Pıtpıt'ı dinle"
msgstr "Listen to Puddles"

msgid "Pıtpıt'ı duyunca anladım: benim içimde de minik bir diken varmış."
msgstr "When I heard Puddles, I understood: there's a tiny thorn inside me, too."

msgid "Pıtpıt'ım tepe yuvada. Kapıyı dikenle kapattı, kimseyi almıyor."
msgstr "My Puddles is in the top nest. She closed the door with thorns and won't let anyone in."

msgid "Pıtpıt'ım! Bak, bunu hatırlıyor musun?"
msgstr "My Puddles! Look, do you remember this?"

msgid "Pıtı"
msgstr "Pippy"

msgid "Pıtı'ya pembe fenerini ver"
msgstr "Give Pippy her pink lantern"

msgid "Rakun sakinleşince bir oyuncak bıraktı!"
msgstr "The raccoon calmed down and let go of a toy!"

msgid "Rakunlar oyuncakları kapmış. Sakinleşince bırakırlar."
msgstr "The raccoons grabbed the toys. They let go once they calm down."

msgid "Rakunları sakinleştir, oyuncakları sahiplerine ver."
msgstr "Calm the raccoons and give the toys back to their owners."

msgid "Renk"
msgstr "Color"

msgid "Resimde sen bir çanı çalıyorsun. Çok güzel olmuş!"
msgstr "In it you're ringing a bell. It's really lovely!"

msgid "Resimlere onunla birlikte bakacağız."
msgstr "We'll look at the drawings together."

msgid "Ritim Kalkanı"
msgstr "Rhythm Shield"

msgid "Ritim Tılsımı"
msgstr "Rhythm Charm"

msgid "Ritim olmadan şarkım hep bir yere kaçıyormuş. Şimdi yerinde!"
msgstr "Without a beat, my song kept running away. Now it stays put!"

msgid "Ritmi dinle, nefeslenince vur!"
msgstr "Hear the rhythm, hit when he rests!"

msgid "Ritmim mi? Onu fark eden olmamıştı."
msgstr "My beat? Nobody ever noticed it."

msgid "Rüzgâr Gülü Adası"
msgstr "Pinwheel Isle"

msgid "Rüzgâr Gülü Adası'nda fırtına çanlarını çal"
msgstr "Ring the storm bells on Pinwheel Isle"

msgid "Rüzgâr Gülü Adası'ndaki üç çanı çal, fırtına dinsin."
msgstr "Ring the three bells on Pinwheel Isle so the storm stops."

msgid "Rüzgâr Gülü dönüp duruyor, başım döndü!"
msgstr "The pinwheel keeps spinning, and I'm dizzy!"

msgid "Rüzgâr Tılsımı"
msgstr "Wind Charm"

msgid "Rüzgâr esince kayanın ardında bekle. Sonra yürü."
msgstr "When the wind blows, wait behind the rock. Then walk."

msgid "Rüzgâr esiyor! Bir sütunun dibine saklan"
msgstr "The wind is blowing! Hide behind a pillar"

msgid "Rüzgâr geliyor!"
msgstr "The wind is coming!"

msgid "Rüzgâr geliyor! Karşı yürü ya da yuvarlan."
msgstr "The wind is coming! Walk against it or roll."

msgid "Rüzgâr geliyor! Karşı yürü, kayanın ardında bekle ya da yuvarlan."
msgstr "Wind is coming! Walk against it, wait behind the rock, or roll."

msgid "Rüzgâr sakinleşti!"
msgstr "Gale calmed down!"

msgid "Rüzgâr su sıçratıyor. Tüylerim diken diken oldu."
msgstr "The wind splashes the water. My fur is all standing up."

msgid "Rüzgâr tünelinden geç, üst kata çık"
msgstr "Go through the wind tunnel, climb to the upper floor"

msgid "Rüzgâr şarkı söylüyor. Önce canavar sandım, rüzgârmış."
msgstr "The wind is singing. I thought it was a monster, but it was just the wind."

msgid "Rüzgâr! Karşı yürü ya da kayanın ardına geç."
msgstr "Wind! Walk against it or get behind the rock."

msgid "Rüzgâr'la yine yarışacağız. Bu sefer fırtınasız!"
msgstr "Gale and I will race again. This time with no storm!"

msgid "Rüzgâra karşı yürü, atılınca kenara çekil. Yorulunca vur!"
msgstr "Walk against the wind, step aside when it's thrown. Hit when it's tired!"

msgid "Rüzgâra karşı yürü, halkalardan kaç. Pamuk yorulunca vur!"
msgstr "Walk into the wind, dodge the rings. Hit when Cotton is tired!"

msgid "Rüzgâra karşı yürü, halkalardan kaç. Yorulunca vur!"
msgstr "Walk into the wind, dodge the rings. Strike when it gets tired!"

msgid "Rüzgârdan kaç, yorulunca vur!"
msgstr "Dodge the wind, hit when it's tired!"

msgid "Rüzgârgülü sorulmadan alınınca kalbi kırılmış."
msgstr "His heart broke when his pinwheel was taken without asking."

msgid "Rüzgârgülüm en sevdiğim şeydi..."
msgstr "My pinwheel was my favorite thing..."

msgid "Rüzgârgülümü aldılar! Sormadan! Herkes gitsin!"
msgstr "They took my pinwheel! Without asking! Everyone go away!"

msgid "Rüzgârlı Kayalıklar"
msgstr "Windy Cliffs"

msgid "Rüzgârlı Kayalıklar... Kayalar göğe kadar uzanıyor!"
msgstr "Windy Cliffs... The rocks reach all the way to the sky!"

msgid "Rüzgârın Yolu"
msgstr "The Wind's Way"

msgid "Rüzgârın içinde bir ses var: Kimse beni dinlemiyor!"
msgstr "There's a voice in the wind: Nobody listens to me!"

msgid "SUS"
msgstr "HUSH"

msgid "Sabah oldu ama Fener'in ışığı bu sisi delemiyor."
msgstr "It's morning, but the Lantern's light can't get through this mist."

msgid "Sabah oldu. Tırıl dikenli kapının ardında kaldı."
msgstr "Morning came. Tremble stayed behind the thorny gate."

msgid "Sadece dalgalara bakıyorum Bado. Yaklaşmıyorum."
msgstr "I'm just looking at the waves, Bado. I'm not going closer."

msgid "Sadece dalgalara bakıyorum. Yaklaşmıyorum, bakıyorum."
msgstr "I'm just looking at the waves. Not going closer, just looking."

msgid "Sadece sorsalardı, verirdim. Birlikte oynardık."
msgstr "If they'd only asked, I'd have shared. We'd have played together."

msgid "Sahnedeki Papatya Tohumu'nu al"
msgstr "Take the Daisy Seed on the stage"

msgid "Sahnenin ortasında bir papatya açtı. Tohumu senin olsun!"
msgstr "A daisy bloomed in the middle of the stage. The seed is yours!"

msgid "Sakin ve düşünceli. Pus'un kötü olmadığını sezen ilk kişi."
msgstr "Calm and thoughtful. First to sense the Gloom isn't bad."

msgid "Sakinleş"
msgstr "Breathe"

msgid "Sakinleş'e basılı tut!"
msgstr "Hold Breathe!"

msgid "Sakinleş'e basılı tutacağım. Nefes al... nefes ver..."
msgstr "I'll hold Breathe. Breathe in... breathe out..."

msgid "Saklambaç Ahtapotu"
msgstr "Hide-and-Seek Octopus"

msgid "Saklambaç mı? İyi oynarız. Seni hep bulacağız!"
msgstr "Hide and seek? We're good at it. We'll always find you!"

msgid "Saklanan Tırıl'ı dört kez bul"
msgstr "Find hiding Tremble four times"

msgid "Saklananlara Işık"
msgstr "A Light for Those in Hiding"

msgid "Saklandıkça adayı daha da karartmışım. Özür dilerim."
msgstr "The more I hid, the darker I made the island. I'm sorry."

msgid "Saklandığım tekne çok karanlıktı. Tek ses bir davuldu."
msgstr "The boat I hid in was very dark. The only sound was a drum."

msgid "Saklandığım yeri kimse bulamaz. Bulsalar... keşke bulsalar."
msgstr "Nobody can find my hiding spot. If they did... I wish they would."

msgid "Saklanmak da cesaret. Yeter ki tekrar çıkayım!"
msgstr "Hiding is brave too. As long as I come back out!"

msgid "Saklanmana gerek yok. Ama önce biraz yorul bakalım!"
msgstr "You don't need to hide. But first let's get a little tired!"

msgid "Saklayayım. Zirvede ona geri götüreceğim."
msgstr "I'll keep it. I'll take it back to him at the top."

msgid "Saksağan Şıkır"
msgstr "Jingle the Magpie"

msgid "Saldır'a bas: dikenlerinle vur!"
msgstr "Press Attack: hit with your spikes!"

msgid "Sallanan fenerlerden geç"
msgstr "Cross the swinging lanterns"

msgid "Sallanan fenerlere zıpla!"
msgstr "Jump onto the swinging lanterns!"

msgid "Salonun bütün kristallerini yak"
msgstr "Light all the crystals in the hall"

msgid "Sana bir hikâye anlatayım. Pus'un hikâyesini."
msgstr "Let me tell you a story. The story of the Gloom."

msgid "Sapanla Işık Tohumu atarsın. Uzaktaki Pus'u dağıtır!"
msgstr "A slingshot throws Light Seeds. They clear faraway Gloom!"

msgid "Sapanla uzağa atılır, Pus'u dağıtır"
msgstr "Thrown far with the slingshot, clears the Gloom"

msgid "Sarmaşık Merdiven"
msgstr "Vine Ladder"

msgid "Sarmaşık aynayı örtmüş. Yanında alkışla!"
msgstr "The vine covered the mirror. Clap next to it!"

msgid "Sarmaşık halkalarından kaç. Dırıl yorulunca vur!"
msgstr "Dodge the vine rings. Hit when Bramble is tired!"

msgid "Sarmaşık merdiven oldu! Üst dala çıkabiliriz."
msgstr "The vine became a ladder! We can climb to the upper branch."

msgid "Sarmaşık çekildi, ayna göründü. Suda bir balık!"
msgstr "The vine pulled back and the mirror appeared. A fish in the water!"

msgid "Sarmaşıklar kabarıyor! Ama ben bu duyguyu tanıyorum."
msgstr "The vines are swelling! But I know this feeling."

msgid "Sarmaşıklardan kaçalım. Yorulunca konuşuruz."
msgstr "Let's dodge the vines. We'll talk when he's tired."

msgid "Sarmaşıkların dev köküne ulaş"
msgstr "Reach the giant root of the vines"

msgid "Sarmaşıkların kökleri ormana doğru uzanıyor."
msgstr "The roots of the vines reach toward the forest."

msgid "Sarmaşıktan tırman"
msgstr "Climb the vines"

msgid "Sarmaşığa yürü, joystick yukarı!"
msgstr "Walk to the vines, stick up!"

msgid "Sarmaşığa yürü, yukarı tırman!"
msgstr "Walk to the vines, climb up!"

msgid "Sarı Ayaklar"
msgstr "Yellow Feet"

msgid "Sarı Kıvılcım"
msgstr "Yellow Spark"

msgid "Sarı Kıvılcım! Gökyüzü yeniden masmavi."
msgstr "The Yellow Spark! The sky is bright blue again."

msgid "Sarı Kıvılcım! Üç oldu, iki kaldı."
msgstr "The Yellow Spark! That makes three, two to go."

msgid "Sarı Kıvılcım'ı yuttu, yuvasında fırtına koparıyor."
msgstr "He swallowed the Yellow Spark and is stirring up a storm in his nest."

msgid "Sarıl"
msgstr "Hug"

msgid "Satın al"
msgstr "Buy"

msgid "Sazlıktaki Paçalı'yı alkışla"
msgstr "Clap for Flappy in the reeds"

msgid "Sağ ol, Pamuk. Bunu kimse söylememişti."
msgstr "Thank you, Cotton. Nobody ever said that before."

msgid "Sağa git..."
msgstr "Go right..."

msgid "Sağdaki toprağa git, Ek'e bas"
msgstr "Go to the soil on the right, press Plant"

msgid "Sağdaki toprağa git, Ek'e bas!"
msgstr "Go to the soil on the right, press Plant!"

msgid "Sekiz bacakla dikiyorum, yakında dükkân açık!"
msgstr "I sew with eight legs, my shop opens soon!"

msgid "Sen Tırıl'ı bulan bekçisin! Gel, sana yakından bakayım."
msgstr "You're the Keeper who found Tremble! Come here, let me take a closer look."

msgid "Sen alkışlayınca baktım: turplarım pespembe!"
msgstr "When you clapped, I looked: my radishes are bright pink!"

msgid "Sen bana derin nefesi öğrettin. Hâlâ yapıyorum."
msgstr "You taught me deep breaths. I still do them."

msgid "Sen benim ilk yuvamsın. Kalbim büyüdü, senin yerin küçülmedi."
msgstr "You are my first nest. My heart grew, and your place didn't shrink."

msgid "Sen bile ışık saçıyorsun!"
msgstr "Even you are giving off light!"

msgid "Sen burada ışıkta kal. Davulum bana yeni bir ses verdi!"
msgstr "You stay here in the light. My drum gave me a new sound!"

msgid "Sen dans et, ben çalarım!"
msgstr "You dance, I'll play!"

msgid "Sen doğunca ben de öyle hissettim Minnoş. Kenarda kaldım sandım."
msgstr "When you were born, I felt that way too, Cubby. I thought I was left out."

msgid "Sen dönünce birlikte ritim tutalım mı?"
msgstr "When you're back, shall we keep a beat together?"

msgid "Sen gülmedin... Davulumu gerçekten dinledin."
msgstr "You didn't laugh... You really listened to my drum."

msgid "Sen hâlâ çok büyük ve turuncu bir kabaksın!"
msgstr "You're still a very big, orange pumpkin!"

msgid "Sen kuleye koş. Büyük Kıvılcım'ı koru!"
msgstr "You run to the tower. Protect the Great Spark!"

msgid "Sen minicikken düşen ilk tüyün. Onu yuvaya ben ördüm."
msgstr "It's the first feather you lost when you were tiny. I wove it into the nest."

msgid "Sen oradasın diye içim rahat. Kendine iyi bak!"
msgstr "I feel calm knowing you're there. Take care!"

msgid "Sen söyleyince benim ritmim azalmadı. Daha güzel duyuldu!"
msgstr "When you sing, my beat didn't get smaller. It sounded better!"

msgid "Sen... beni duydun mu?"
msgstr "Did you... hear me?"

msgid "Seni Buldum"
msgstr "Found You"

msgid "Seni alkışladım Pıtpıt! Kanat çırpışın rüzgâr gibiydi."
msgstr "I clapped for you, Puddles! Your wing flaps were like the wind."

msgid "Seni bekliyorum. Fener'in yanına yer ayırdım!"
msgstr "I'm waiting for you. I saved you a spot by the Lantern!"

msgid "Seni bulacağız Tırıl. Bu sefer sesimizi duyacaksın."
msgstr "We'll find you, Tremble. This time you'll hear our voices."

msgid "Seni buldum!"
msgstr "Found you!"

msgid "Seni de Pus gönderdi, değil mi? Kıskaçlarım hazır!"
msgstr "The Gloom sent you too, didn't it? My pincers are ready!"

msgid "Seni de buldum. Bu ailede herkes mi saklanıyor?"
msgstr "Found you too. Does everyone in this family hide?"

msgid "Seni dinliyorum. Sorsalardı ne derdin?"
msgstr "I'm listening. What would you have said if they asked?"

msgid "Seni duyuyorum."
msgstr "I hear you."

msgid "Seni hiç bırakmamışlar. Yıllardır arıyorlarmış."
msgstr "They never gave up on you. They've been looking for years."

msgid "Seni unutmadı Dırıl. Sadece yolu kapandı."
msgstr "He didn't forget you, Bramble. His way was just blocked."

msgid "Seni yine buldum!"
msgstr "Found you again!"

msgid "Senin! O ayaklara hep bayıldık. Şap şap yürüyorsun!"
msgstr "Yours! We always loved those feet. You walk flap-flap!"

msgid "Seninle konuşunca içim serinledi."
msgstr "Talking to you cooled me right down."

msgid "Sepetimde kakao var. Bak istersen."
msgstr "I have cocoa in my basket. Take a look if you like."

msgid "Sera Kasabası"
msgstr "Greenhouse Town"

msgid "Seranın önünde bir alkış patlatayım, belki iyi gelir."
msgstr "I'll give a big clap in front of the greenhouse. Maybe it helps."

msgid "Sersemledi! Şimdi vur!"
msgstr "He's dazed! Hit now!"

msgid "Sersemledi, başında yıldızlar dönüyor."
msgstr "It's dizzy, stars are spinning around its head."

msgid "Serçe Pıtpıt"
msgstr "Pip the Sparrow"

msgid "Ses bu yoldan geliyor. Önce ışık lazım."
msgstr "The sound comes from this way. We need light first."

msgid "Ses dağdan geliyor. Kimse beni dinlemiyor, diyordu."
msgstr "The voice comes from the mountain. 'Nobody listens to me,' it said."

msgid "Ses ormanın kenarındaki bostandan geliyor. Bakmalıyım."
msgstr "The sound is coming from the vegetable patch at the edge of the forest. I should look."

msgid "Ses! Çok ses! Kimse beni bulmasın..."
msgstr "Noise! So much noise! Don't let anyone find me..."

msgid "Sesi kısılan üç şarkıcının yanında düzenli ritim tut"
msgstr "Keep a steady beat next to the three singers whose voices went quiet"

msgid "Sesi çıkmıyor. Önce yanında düzenli ritim tut: dört vuruş!"
msgstr "No sound comes out. First keep a steady beat next to him: four beats!"

msgid "Sesin peşinden git. Meşaleleri yak: ışık yolu güvenli yapar."
msgstr "Follow the sound. Light the torches: light makes the path safe."

msgid "Sesler: %s"
msgstr "Sounds: %s"

msgid "Sesler: Meta Oculus Audio Pack · CC BY 4.0"
msgstr "Sounds: Meta Oculus Audio Pack · CC BY 4.0"

msgid "Sessizlikte yürü, kaya altında bekle. Meşaleleri yakalım!"
msgstr "Walk in the quiet, wait under the rock. Let's light the torches!"

msgid "Sete çıkmak için merdiven tohumu ek"
msgstr "Plant a ladder seed to climb the ledge"

msgid "Sette bir Gece Çiçeği toprağı var. Onu da ek, bak ne olacak."
msgstr "There's a Night Flower patch on the ledge. Plant that one too and see what happens."

msgid "Setteki Gece Çiçeği tohumunu ek"
msgstr "Plant the Night Flower seed on the ledge"

msgid "Sevgi paylaşılınca çoğalır"
msgstr "Love grows when it's shared"

msgid "Seviye"
msgstr "Level"

msgid "Seviye %d"
msgstr "Level %d"

msgid "Seviye %d!"
msgstr "Level %d!"

msgid "Seviyen ve eşyaların kalır, hikâye baştan başlar. Hırıl ve Tırıl da seçilebilir!"
msgstr "Your level and items stay, the story starts over. Grumble and Tremble can be picked too!"

