msgid "Kaydedilemedi"
msgstr "Could not save"

msgid "Kaydet (Kayıt %d)"
msgstr "Save (Save %d)"

msgid "Kaynar Balon Balık"
msgstr "Boiling Pufferfish"

msgid "Kaynar Kurbağa Fokur"
msgstr "Burble the Boiling Frog"

